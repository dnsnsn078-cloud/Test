        if item.category == "Accessory" then return Config.Accessories[item.name] == true end
        return false
    end
    local function SunriseShopRequirementsMet(itemName)
        local req = SUNRISE_ITEM_REQUIREMENTS and SUNRISE_ITEM_REQUIREMENTS[itemName]
        if not req then return true end
        local player = game:GetService("Players").LocalPlayer
        local data = player and player:FindFirstChild("Data")
        local currentLevel = tonumber(data and data:FindFirstChild("Level") and data.Level.Value)
            or tonumber(ScriptStorage and ScriptStorage.PlayerData and ScriptStorage.PlayerData.Level) or 0
        local currentBeli = tonumber(data and data:FindFirstChild("Beli") and data.Beli.Value)
            or tonumber(ScriptStorage and ScriptStorage.PlayerData and ScriptStorage.PlayerData.Beli) or 0
        local currentFragments = tonumber(data and data:FindFirstChild("Fragments") and data.Fragments.Value)
            or tonumber(ScriptStorage and ScriptStorage.PlayerData and ScriptStorage.PlayerData.Fragments) or 0
        if (tonumber(req.minSea) or 1) > (tonumber(SeaIndex) or 1) then return false end
        if currentLevel < (tonumber(req.minLevel) or 0) then return false end
        if currentBeli < (tonumber(req.beli) or 0) then return false end
        if currentFragments < (tonumber(req.fragments) or 0) then return false end
        if not req.statRequirements or #req.statRequirements == 0 then return true end
        local stats = data and data:FindFirstChild("Stats")
        for _, statReq in ipairs(req.statRequirements) do
            local stat = stats and stats:FindFirstChild(statReq.name)
            if not stat and statReq.name == "Demon Fruit" then stat = stats and (stats:FindFirstChild("Blox Fruit") or stats:FindFirstChild("BloxFruit")) end
            local value = stat and tonumber(stat.Value)
            if value == nil then
                -- Wait for stats to replicate rather than sending a purchase that will fail.
                return false
            end
            if value < (statReq.level or 0) then return false end
        end
        return true
    end
    local function SunriseShopGoalReady(item)
        if not SunriseConfiguredForShopItem(item) or CheckItem(item.name) then return false end
        if SeaIndex ~= item.sea or (tonumber(ScriptStorage.PlayerData.Level) or 0) < item.level then return false end
        if not SunriseShopRequirementsMet(item.name) then return false end
        local req = SUNRISE_ITEM_REQUIREMENTS and SUNRISE_ITEM_REQUIREMENTS[item.name]
        local metadataBeli = tonumber(req and req.beli) or 0
        local requiredBeli = math.max(tonumber(item.beli) or 0, metadataBeli)
        local data = game:GetService("Players").LocalPlayer:FindFirstChild("Data")
        local beli = tonumber(data and data:FindFirstChild("Beli") and data.Beli.Value)
            or tonumber(ScriptStorage and ScriptStorage.PlayerData and ScriptStorage.PlayerData.Beli) or 0
        return beli >= requiredBeli
    end

