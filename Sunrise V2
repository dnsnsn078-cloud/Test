    local function refreshRaceProgress(force)
        local raceName = currentRaceName()
        if raceName ~= raceProgress.race then
            raceProgress.race = raceName
            raceProgress.v2, raceProgress.v3, raceProgress.v4 = nil, nil, nil
            raceProgress.checkedAt = 0
            raceProgress.lastError = nil
            force = true
        end
        local now = os.clock()
        if raceProgress.checking or (not force and now - raceProgress.checkedAt < 15) then return end
        raceProgress.checking = true
        raceProgress.checkedAt = now
        task.spawn(function()
            local ok2, result2, ok3, result3 = false, nil, false, nil
            local ok4, unlockedV4 = pcall(function()
                local data = lp:FindFirstChild("Data")
                local race = data and data:FindFirstChild("Race")
                if not data or not race then return nil end
                local evolved = race:FindFirstChild("Evolved")
                local character = lp.Character
                local transformed = character and character:FindFirstChild("RaceTransformed") ~= nil
                if transformed then return true end
                if not evolved then return false end
                if evolved:IsA("BoolValue") then return evolved.Value end
                if evolved:IsA("IntValue") or evolved:IsA("NumberValue") then return evolved.Value > 0 end
                return true
            end)
            local remoteOk, commF = pcall(function()
                return game:GetService("ReplicatedStorage"):WaitForChild("Remotes"):WaitForChild("CommF_")
            end)
            if remoteOk and commF then
