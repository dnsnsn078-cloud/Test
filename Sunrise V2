    function TweenController.Create(W)
        if not W or TweenDebounce then return end
        if tweenStopRequested() then
            if shouldTween or TweenController.Preparing or TweenInstance then TweenController.Cancel(false) end
            return
        end
        if TweenController.CancelledUntil and os.clock() < TweenController.CancelledUntil then return end
        local cancelVersion = TweenController.CancelVersion or 0
        local a = typeof(W) ~= 'CFrame' and ConvertTo(CFrame, W) or W
        -- Avoid restarting the same movement every dispatcher tick. Material and
        -- boss tasks can ask for an identical target repeatedly; cancel/recreate
        -- here made movement stutter and could strand the character mid-tween.
        if TweenInstance and TweenInstance.PlaybackState == Enum.PlaybackState.Playing
            and TweenController.TargetCFrame
            and (TweenController.TargetCFrame.Position - a.Position).Magnitude < 8 then
            return
        end
        if TweenInstance then
            local previousTween = TweenInstance
            TweenInstance = nil
            pcall(function() previousTween:Cancel() end)
        end
        local character = game.Players.LocalPlayer.Character
        local hrp = character and character:FindFirstChild("HumanoidRootPart")
        if not hrp then return end

        -- [FIXED - as boss man requested: "remove the teleport bypass"] Removed the
        -- BypassTP branch (dist>=4000 -> change spawn point) - the spawn point bypass
        -- mechanism is no longer used, every distance now tweens normally
        -- through the block (from main_red_magic_beta.txt).
        TweenController.Preparing = true
        for _, part in ipairs(character:GetDescendants()) do
            if part:IsA("BasePart") then
                if originalTweenCollisions[part] == nil then originalTweenCollisions[part] = part.CanCollide end
                part.CanCollide = false
            end
        end
        local head = character:WaitForChild("Head")
        if not head:FindFirstChild("eltrul") then
            local bv = Instance.new('BodyVelocity')
            bv.Name = "eltrul"
            bv.MaxForce = Vector3.new(0, math.huge, 0)
            bv.Velocity = Vector3.zero
            bv.Parent = head
        end
        if CaculateDistance(a) > 500 then
            if SeaIndex == 3 and not ScriptStorage.Backpack['Valkyrie Helm'] then
            elseif SeaIndex ~= 3 then
                GetPortal(a)
            end
        end
        if CaculateDistance(Vector3.new(11256, -2138.0, 9888), a) < (CaculateDistance(a) - 700) and SeaIndex == 3 then
            local gatePos = CFrame.new(-16269.0, 23, 1371)
            if CaculateDistance(gatePos) > 60 then
                TweenController.Create(gatePos)
                task.wait(1)
                return
            end
            local net = require(game.ReplicatedStorage.Modules.Net)
            net:RemoteFunction('SubmarineWorkerSpeak'):InvokeServer('TravelToSubmergedIsland')
        end

        -- A cancel can happen while GetPortal / entrance remotes yield. Do not let this
        -- old request create a new tween after Cancel() has already restored movement.
        if cancelVersion ~= (TweenController.CancelVersion or 0)
            or tweenStopRequested()
            or (TweenController.CancelledUntil and os.clock() < TweenController.CancelledUntil) then
            TweenController.Preparing = false
            shouldTween = false
            pcall(function() getgenv().OnFarm = false end)
            restoreTweenPhysics(true)
            return
        end
        a = CFrame.new(a.Position)
        local dist = CaculateDistance(hrp.CFrame, a)

        if dist <= 5 then
            hrp.CFrame = a
            block.CFrame = a
            TweenController.TargetCFrame = nil
            TweenController.Preparing = false
            shouldTween = false
            pcall(function() getgenv().OnFarm = false end)
            restoreTweenPhysics()
            return
        end

        -- [FIXED - as boss man requested: "raise it to 160 to make it fast, not above
        -- 160"] Removed the old 110/100 table - uses a single FIXED speed of 160
        -- (like the tween in main_red_magic_beta.txt, only the divisor 300 changed ->
        -- 160 to make it faster), there is no level above this number.
        local divisor = 160
        local duration = dist / divisor
        TweenController.Preparing = false

        -- Recheck cancellation immediately before starting motion.
        if cancelVersion ~= (TweenController.CancelVersion or 0)
            or tweenStopRequested()
            or (TweenController.CancelledUntil and os.clock() < TweenController.CancelledUntil) then
            TweenController.Preparing = false
            shouldTween = false
            pcall(function() getgenv().OnFarm = false end)
            restoreTweenPhysics(true)
            return
        end
        -- [FIXED - tween ported from main_red_magic_beta.txt] Tween the "block"
        -- (invisible Part) instead of tweening hrp directly - the character follows the
        -- block through the sync loop added above (getgenv().OnFarm).
        shouldTween = true
        TweenController.TargetCFrame = a
        local thisTween = Services.TweenService:Create(block, TweenInfo.new(duration, Enum.EasingStyle.Linear), {CFrame = a})
        TweenInstance = thisTween
        thisTween:Play()
        task.spawn(function()
            while thisTween.PlaybackState == Enum.PlaybackState.Playing do
                if not shouldTween or TweenInstance ~= thisTween or tweenStopRequested() then
                    pcall(function() thisTween:Cancel() end)
                    break
                end
                task.wait(0.1)
            end
            -- An old canceled tween must never clear the state of a newer tween.
            if TweenInstance == thisTween then
                TweenInstance = nil
                TweenController.TargetCFrame = nil
                shouldTween = false
                pcall(function() getgenv().OnFarm = false end)
                restoreTweenPhysics()
            end
        end)
    end

