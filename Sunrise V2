			table.insert(parts,
				"HINT=" .. tostring(hint.Boss or "?")
				.. "@" .. tostring(hint.Island or "?")
				.. " State=" .. tostring(hint.State or "?")
				.. " T=" .. tostring(math.floor(tonumber(hint.Seconds) or 0))
				.. "s Needed=" .. (neededQuest and "YES" or "NO")
				.. (neededQuest and (" -> " .. neededQuest) or "")
