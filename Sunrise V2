        if not k then return end
        local W, h = k[1], k[2]
        if W == "Evil" and h == 3 then
            -- [FIXED] Previously it only set ForceToRollBone=true and stood still -
            -- no handler reads that variable, so this step HUNG FOREVER.
            -- Replaced with the real chain: Bones -> Hallow Essence -> equip
            -- at the summon coordinates -> Soul Reaper appears -> fight.
            -- (verified from main_red_magic_beta.txt + raw_6, they match)
            local HALLOW_SUMMON_CF = CFrame.new(-8932.86, 143.258, 6063.31)

            if ScriptStorage.Enemies['Soul Reaper'] then
