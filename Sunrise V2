        if desc then text(row, {Position = UDim2.fromOffset(10, 23), Size = UDim2.new(1, -66, 0, 14), Text = desc, TextSize = 10, TextColor3 = T.sub, TextTruncate = Enum.TextTruncate.AtEnd}) end
        local track = new("Frame", {AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -10, 0.5, 0), Size = UDim2.fromOffset(38, 20),
            BackgroundColor3 = T.off, BorderSizePixel = 0}, row)
        corner(track, 10)
