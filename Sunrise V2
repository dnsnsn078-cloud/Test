            },
            ["Dark Step Teacher"] = {
                [1] = CFrame.new(-983.62, 12.44, 3990.46),
                [2] = CFrame.new(-4752.44, 33.92, -4848.04),
                [3] = CFrame.new(-5045.61, 370.01, -3182.31),
            },
            ["Phoeyu, the Reformed"] = {
                [2] = CFrame.new(6356.47, 296.1, -6762.78),
                [3] = CFrame.new(-4999.24, 314.01, -3221.58),
            },
            ["Sharkman Teacher"] = {
                [2] = CFrame.new(-2599.63, 238.19, -10316),
                [3] = CFrame.new(-4971.21, 313.88, -3223.08),
            },
            -- These two teachers exist in the Second Sea only. The old table
            -- omitted them, so those styles could issue buy remotes from the wrong island.
            ["Sabi"] = { [2] = CFrame.new(699.029, 185.661, 654.895) },
            ["Martial Arts Master"] = { [2] = CFrame.new(1377.125, 246.542, -5189.951) },
            ["Previous Hero"] = {
                [3] = CFrame.new(-10371.48, 330.76, -10131.42),
            },
            ["Uzoth"] = {
                [3] = CFrame.new(5661.89, 1210.87, 863.17),
            },
            ["Ancient Monk"] = {
                [3] = CFrame.new(-13774.1, 333.73, -9879.91),
            },
            ["Shafi"] = {
                [3] = CFrame.new(-16548.800, 12.000, 412.300),
            },
        }
        -- [NEW] Which melee -> which teacher (matches the names in MeleePrices.Buy)
        -- Dragon Claw ("Sabi") and Superhuman ("Martial Arts Master") are NOT
        -- in the data boss man gave - left empty, no invented coordinates
        local MeleeTeacher = {
            ["Fishman Karate"]   = "Water Kung-fu Teacher",
            ["Electro"]          = "Mad Scientist",
            ["Black Leg"]        = "Dark Step Teacher",
            ["Dragon Claw"]      = "Sabi",
            ["Superhuman"]       = "Martial Arts Master",
            ["Death Step"]       = "Phoeyu, the Reformed",
            ["Sharkman Karate"]  = "Sharkman Teacher",
            ["Electric Claw"]    = "Previous Hero",
            ["Dragon Talon"]     = "Uzoth",
            ["Godhuman"]         = "Ancient Monk",
            ["Sanguine Art"]     = "Shafi",
        }

        -- [NEW] Tween to the right teacher before buying - this was the MISSING part
        -- causing "buying fails" (the buy remote was called but the character was not near
        -- the NPC so the server refused). If the current Sea has the teacher -> use it; if
        -- not -> go to Sea 3 (every teacher is there).
        local function GoToTeacher(meleeName)
            local teacher = MeleeTeacher[meleeName]
            if not teacher then return true end -- no position data, skip this step
            local locs = TeacherLocations[teacher]
            if not locs then return true end

            local cf = locs[SeaIndex]
            if not cf then
                -- Route to a sea where this teacher actually exists; don't assume all
                -- teachers are present in Sea 3 (Sabi and Martial Arts Master are Sea 2 only).
                local targetSea = locs[3] and 3 or (locs[2] and 2 or (locs[1] and 1 or nil))
                if targetSea and SeaIndex ~= targetSea then
                    local travelRemote = targetSea == 1 and "TravelMain" or (targetSea == 2 and "TravelDressrosa" or "TravelZou")
                    pcall(function() Remotes.CommF_:InvokeServer(travelRemote) end)
                    return false
                end
                return true -- no destination metadata is available for this teacher
            end

            if CaculateDistance(cf) > 10 then
                TweenController.Create(cf)
                return false
            end
            return true
        end

        for _, melee in ipairs(meleeList) do
            if _G.Stop then return end
            if not meleeGoalEnabled(melee.name) then continue end

            if melee.customSanguine then
                if CheckItem("Sanguine Art") then continue end
                local function matCount(name)
                    local row = ScriptStorage.Backpack and ScriptStorage.Backpack[name]
                    if type(row) == "table" then return tonumber(row.Count or row.Quantity or row.Value) or 0 end
                    return tonumber(row) or 0
                end
                local needs = {{name="Demonic Wisp", count=20, sea=3, mobs={"Demonic Soul"}},
                    {name="Vampire Fang", count=20, sea=2, mobs={"Vampire"}},
                    {name="Dark Fragment", count=2, sea=2, boss="Darkbeard"}}
                local missing = nil
                for _, requirement in ipairs(needs) do
                    if matCount(requirement.name) < requirement.count then missing = requirement; break end
                end
                if missing then
                    if SeaIndex ~= missing.sea then
                        SetTask("MainTask", "Sanguine Art | Traveling to farm " .. missing.name)
                        pcall(function() Remotes.CommF_:InvokeServer(missing.sea == 2 and "TravelDressrosa" or "TravelZou") end)
                        return
                    end
                    if missing.boss then
                        local darkbeard = ScriptStorage.Enemies[missing.boss]
                        if darkbeard then
                            SetTask("MainTask", "Sanguine Art | Farming Dark Fragments from Darkbeard (" .. matCount(missing.name) .. "/2)")
                            CombatController.Attack({missing.boss})
                        else
                            SetTask("MainTask", "Sanguine Art | Waiting for Darkbeard / Dark Fragment (" .. matCount(missing.name) .. "/2)")
                            TweenController.Create(CFrame.new(-5234, 604, -2289))
                        end
                    else
                        SetTask("MainTask", "Sanguine Art | Farming " .. missing.name .. " (" .. matCount(missing.name) .. "/" .. missing.count .. ")")
                        CombatController.Attack(missing.mobs)
                    end
                    return
                end
                if SeaIndex ~= 3 then
                    SetTask("MainTask", "Sanguine Art | Returning to Third Sea for Shafi at Tiki Outpost")
                    pcall(function() Remotes.CommF_:InvokeServer("TravelZou") end)
                    return
                end
                if matCount("Leviathan Heart") < 1 and not CheckItem("Leviathan Heart") then
                    SetTask("MainTask", "Sanguine Art | Waiting for Leviathan Heart; Auto Leviathan intentionally disabled")
                    return
                end
                local haveBeli = ScriptStorage.PlayerData.Beli or 0
                local haveFragments = ScriptStorage.PlayerData.Fragments or 0
                if haveBeli < 5000000 or haveFragments < 5000 then
                    SetTask("MainTask", string.format("Sanguine Art | Need 5M Beli and 5K Fragments (Beli %d/5000000, Fragments %d/5000)", haveBeli, haveFragments))
                    return
                end
                if not GoToTeacher("Sanguine Art") then
                    SetTask("MainTask", "Sanguine Art | Going to Shafi at Tiki Outpost")
                    return
                end
                SetTask("MainTask", "Sanguine Art | Requesting purchase from Shafi")
                pcall(function() Remotes.CommF_:InvokeServer("BuySanguineArt") end)
                task.wait(0.3)
                if CheckItem("Sanguine Art") then SetTask("MainTask", "Sanguine Art | Completed") end
                return
            end

            local bp = CheckItem(melee.name)
            if not bp then
                -- [NEW] Dragon Claw V1 needs 1500 Fragments on its own - if not
                -- enough yet, this is exactly why raids must be farmed (raids give
                -- Fragments), not any other error
                if melee.name == "Dragon Claw" and (ScriptStorage.PlayerData.Fragments or 0) < 1500 then
                    SetTask('MainTask', 'Auto Full Melee | Dragon Claw needs 1500 Fragments — farming Raid (' .. (ScriptStorage.PlayerData.Fragments or 0) .. '/1500)')
                    return
                end

                local canBuy = true
                for currency, amount in pairs(melee.price) do
                    local have = (currency == "Beli" and ScriptStorage.PlayerData.Beli) or
                                 (currency == "Fragments" and ScriptStorage.PlayerData.Fragments) or 0
                    if have < amount then canBuy = false end
                end
                -- [FIXED] needKey/needFireEssence/needMaterials used to be
                -- in the "ALREADY OWNED" branch (the else below) - meaningless, since these
                -- are PREREQUISITES needed BEFORE buying, not
                -- things to check after buying. Moved to the right place.

                if melee.needKey and not CheckItem(melee.needKey) then
                    SetTask('MainTask', 'Auto Full Melee | Getting ' .. melee.needKey .. ' for ' .. melee.name)
                    if melee.needKey == "Library Key" then
                        local admiral = GetConnectionEnemies("Awakened Ice Admiral")
                        if admiral then
                            -- [FIXED - less delay] Attack() already blocks and waits until
                            -- the kill is done, so the wait(2) after it is redundant
                            CombatController.Attack("Awakened Ice Admiral")
                        else
                            TweenController.Create(CFrame.new(5668.978, 28.52, -6483.352))
                        end
                    elseif melee.needKey == "Water Key" then
                        local tide = GetConnectionEnemies("Tide Keeper")
                        if tide then
                            CombatController.Attack("Tide Keeper")
                        else
                            TweenController.Create(CFrame.new(-3053.981, 237.19, -10145.039))
                        end
                    end
                    return
                end

                -- [NEW] Mastery prerequisite - verified from raw_6:
                -- Superhuman needs Dragon Claw at 300 mastery before buying
                if melee.needMastery then
                    local preMastery = ScriptStorage.Melees[melee.needMastery.item] or 0
                    if not CheckItem(melee.needMastery.item) or preMastery < melee.needMastery.value then
                        SetTask('MainTask', 'Auto Full Melee | Need ' .. melee.needMastery.item .. ' at ' .. melee.needMastery.value .. ' mastery first (now ' .. preMastery .. ') to buy ' .. melee.name)
                        return
                    end
                end

                if melee.needFireEssence then
                    local hasFireEssence = CheckItem("Fire Essence")

                    if hasFireEssence then
                        -- [FIXED] Verified from raw_6: equip Fire Essence then call
                        -- BuyDragonTalon TWICE (true, then with no argument) -
                        -- previously I only farmed bones and never actually used
                        -- Fire Essence to buy Dragon Talon.
                        SetTask('MainTask', 'Auto Full Melee | Using Fire Essence to buy Dragon Talon')
                        FunctionsHandler.LocalPlayerController.Methods.EquipTool:Call("Fire Essence")
                        task.wait(0.5)
                        Remotes.CommF_:InvokeServer("BuyDragonTalon", true)
                        Remotes.CommF_:InvokeServer("BuyDragonTalon")
                        return
                    end

                    if not CheckItem(melee.name) then
                        -- [FIXED] Real threshold is 500 Bones (same as CDK), burst-buy
                        -- until they run out, not a trickle of buy(1,1) one at a time
                        local bonesCount = Remotes.CommF_:InvokeServer("Bones", "Check")
                        if bonesCount and bonesCount > 500 then
                            SetTask('MainTask', 'Auto Full Melee | Trading Bones for Fire Essence (' .. bonesCount .. ')')
                            repeat
                                Remotes.CommF_:InvokeServer("Bones", "Buy", 1, 1)
                                task.wait(0.2)
                                bonesCount = Remotes.CommF_:InvokeServer("Bones", "Check")
                            until not bonesCount or bonesCount <= 0
                            return
                        end
                        if not ScriptStorage.Enemies["Reborn Skeleton"] and not ScriptStorage.Enemies["Living Zombie"]
                            and not ScriptStorage.Enemies["Demonic Soul"] and not ScriptStorage.Enemies["Posessed Mummy"] then
                            -- [NEW] No mobs nearby yet -> move to the exact
                            -- Haunted Castle farm point instead of standing still waiting
                            SetTask('MainTask', 'Auto Full Melee | Going to Haunted Castle to farm Bones (' .. (bonesCount or 0) .. '/500)')
                            TweenController.Create(HAUNTED_CASTLE_BONES_CF)
                            return
                        end
                        SetTask('MainTask', 'Auto Full Melee | Farming Bones for Fire Essence (' .. (bonesCount or 0) .. '/500)')
                        CombatController.Attack({'Reborn Skeleton', 'Living Zombie', 'Demonic Soul', 'Posessed Mummy'})
                        return
                    end
                end

                if melee.needMaterials then
                    -- [NEW] "is everything eligible yet" gate - ONLY farm
                    -- Godhuman materials once the other 8 melees are bought + have enough mastery
                    local ready, reason = AllMeleesReady()
                    if not ready then
                        SetTask('MainTask', 'Auto Full Melee | Godhuman: requirements not met — ' .. (reason or "?"))
                        return
                    end

                    local materials = {
                        {name = "Dragon Scale", need = 10, sea = 3, mobs = {"Dragon Crew Warrior", "Dragon Crew Archer"}},
                        {name = "Fish Tail", need = 20, sea = 3, mobs = {"Fishman Raider", "Fishman Captain"}},
                        {name = "Mystic Droplet", need = 10, sea = 2, mobs = {"Sea Soldier", "Water Fighter"}},
                        {name = "Magma Ore", need = 20, sea = 2, mobs = {"Magma Ninja"}},
                    }
                    for _, mat in ipairs(materials) do
                        local count = ScriptStorage.Backpack[mat.name] and ScriptStorage.Backpack[mat.name].Count or 0
                        if count < mat.need then
                            if SeaIndex ~= mat.sea then
                                Remotes.CommF_:InvokeServer(mat.sea == 2 and "TravelDressrosa" or "TravelZou")
                                return
                            end
                            SetTask('MainTask', 'Auto Full Melee | Godhuman: farm ' .. mat.name .. ' (' .. count .. '/' .. mat.need .. ')')
                            CombatController.Attack(mat.mobs)
                            return
                        end
                    end
                    -- Enough materials -> fall through to the money/Fragments check below to buy
                end

                if canBuy then
                    -- [FIXED - DEEP BUG] My GoToTeacher() tweening by
                    -- hand is CORRECT (uses verified coordinates, covers
                    -- DragonClaw/Superhuman which the original table BindedMeleeNPCNames
                    -- does NOT have) - keep this step.
                    -- BUT the remote was called WRONG: until now it only called
                    -- BuyMelee(key, true) - this is the CHECK proxy (2nd arg=true
                    -- makes the original proxy's auto-navigate at line ~427 get skipped because
                    -- it requires "not h"), NOT the real buy command. It must be called
                    -- a 2nd time WITHOUT true so the proxy really runs the buy
                    -- branch (line 446 always invokes for real, but both steps are needed so
                    -- J records it as valid before step 2 runs).
                    if not GoToTeacher(melee.name) then
                        SetTask('MainTask', 'Auto Full Melee | Going to ' .. (MeleeTeacher[melee.name] or "?") .. ' to buy ' .. melee.name)
                        return
                    end
                    SetTask('MainTask', 'Auto Full Melee | Buying ' .. melee.name)
                    local checkResult = BuyMelee(melee.key, true)  -- Step 1: check (the proxy writes to J if valid)
                    task.wait(0.3)
                    BuyMelee(melee.key)                            -- Step 2: real buy (triggers the proxy auto-navigate + the real invoke)
                    task.wait(0.5)
                    if CheckItem(melee.name) then
                        SetTask('MainTask', 'Auto Full Melee | ✅ Bought ' .. melee.name)
                    else
                        SetTask('SubTask', 'Auto Full Melee | Sent buy request for ' .. melee.name .. ' — will check again next round')
                    end
                else
                    -- [FIXED] No longer sets _G.Level=true (permanent lock) -
                    -- just reports the state and returns, Refresh will retry
                    -- next round when money/Fragments are enough (RaidController still
                    -- runs in parallel farming Fragments through TasksOrder as normal)
                    -- As boss man requested: "keep retrying the buy until it works"
                    SetTask('MainTask', 'Auto Full Melee | Need to farm money for ' .. melee.name)
                    return
                end
            else
                -- [FIXED] Mastery is read from ScriptStorage.Melees[name] - this is the
                -- real source (see line ~403). The old "bp.Level.Value" DOES NOT
                -- EXIST on the tool, so the whole mastery check was silently skipped
                -- (bp:FindFirstChild("Level") was always nil -> the condition
                -- was always false) - this is why auto melee thought it was "ready"
                -- even though mastery was still low.
                local mastery = ScriptStorage.Melees[melee.name] or 0

                if melee.levelReq and ScriptStorage.PlayerData.Level < melee.levelReq then
                    SetTask('MainTask', 'Auto Full Melee | Need Player Level ' .. melee.levelReq .. ' for ' .. melee.name)
                    return
                end

                -- [NEW] V1 reached 500 mastery + no matching V2 yet -> prioritize
                -- Raid for Fragments (boss man request: "if it hits 500 mastery
                -- go raid to get F to buy the v2 style"). Once reached, do NOT hard
                -- return - let the loop keep handling the remaining melees ("check
                -- if mastery is enough, then buy other melees").
                local v2Name = V1ToV2[melee.name]
                if Config.Melee.CheckMasteryAfterBuy and v2Name and not CheckItem(v2Name) then
                    if mastery < Config.Melee.RaidAtV1Mastery then
                        SetTask('SubTask', melee.name .. ' training mastery (' .. mastery .. '/' .. Config.Melee.RaidAtV1Mastery .. ')')
                    else
                        local v2Data = MeleePrices[v2Name]
                        local needFrags = (v2Data and v2Data.Price and v2Data.Price.Fragments) or 5000
                        local needBeli  = (v2Data and v2Data.Price and v2Data.Price.Beli) or 2500000
                        local haveFrags = ScriptStorage.PlayerData.Fragments or 0
                        local haveBeli  = ScriptStorage.PlayerData.Beli or 0
