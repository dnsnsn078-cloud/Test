    FunctionsHandler.Saber:RegisterMethod('Refresh', function()
        if not Config.Items.Saber then
            FunctionsHandler.Saber:Set("CurrentProgressLevel", nil)
            FunctionsHandler.Saber:Set('LastestRefreshSenque', os.time())
            saberSetStatus("Off — enable Auto Saber in Goals")
            return
        end
        if ScriptStorage.Backpack.Saber then
            FunctionsHandler.Saber:Set("CurrentProgressLevel", nil)
            FunctionsHandler.Saber:Set('LastestRefreshSenque', os.time())
            saberSetStatus("Complete — Saber owned")
            return
        end
        local level = tonumber(ScriptStorage.PlayerData.Level) or 0
        if level < 200 then
            FunctionsHandler.Saber:Set("CurrentProgressLevel", nil)
            FunctionsHandler.Saber:Set('LastestRefreshSenque', os.time())
            saberSetStatus("Waiting — Saber requires level 200")
            return
        end

        local ok, progress = pcall(function() return Remotes.CommF_:InvokeServer('ProQuestProgress') end)
        if not ok or type(progress) ~= "table" then
            -- Throttle failed/late responses too; otherwise Start can call this remote
            -- on every dispatcher tick while no stage has been cached yet.
            FunctionsHandler.Saber:Set('LastestRefreshSenque', os.time())
            saberSetStatus("Waiting for Saber quest data from the server")
            return
        end

        local stage
        for _, complete in pairs(type(progress.Plates) == "table" and progress.Plates or {}) do
            if complete == false then stage = 1; break end
        end
        if not stage then
            if not progress.UsedTorch then stage = 2
            elseif not progress.UsedCup then stage = 3
            elseif not progress.TalkedSon then stage = 4
            elseif not progress.KilledMob then stage = 5
            elseif not progress.UsedRelic and not saberDoorIsOpen() then stage = 6
            elseif not progress.KilledShanks then stage = 7 end
        end
        if saberDoorIsOpen() and not progress.KilledShanks then stage = 7 end

        FunctionsHandler.Saber:Set("CurrentProgressLevel", stage)
        FunctionsHandler.Saber:Set('LastestRefreshSenque', os.time())
        local labels = {
            [1] = "Activating the Jungle plates",
            [2] = "Getting and using the torch",
            [3] = "Filling the cup for the Sick Man",
            [4] = "Talking to Rich Man",
            [5] = "Defeating Mob Leader",
            [6] = "Getting the Relic and opening the door",
            [7] = "Waiting for or fighting Saber Expert",
        }
        if stage then
            saberSetStatus(labels[stage])
        elseif progress.KilledShanks then
            saberSetStatus("Quest steps complete — waiting for Saber ownership to update")
        else
            saberSetStatus("Checking Saber quest progress")
        end
        return stage
    end)

    FunctionsHandler.Saber:RegisterMethod('GetQuestplates', function()
        local cached = FunctionsHandler.Saber:Get("QuestplatesCache")
        if cached then
            local valid = true
            for _, plate in ipairs(cached) do
                if not plate or not plate.Parent or not plate:FindFirstChild("Button") then valid = false; break end
            end
            if valid and #cached >= 5 then return cached end
        end
        local map = Services.Workspace:FindFirstChild("Map")
        local jungle = map and map:FindFirstChild("Jungle")
        local questPlates = jungle and jungle:FindFirstChild("QuestPlates")
        if not questPlates then return {} end
        local plates = {}
        for _, plate in ipairs(questPlates:GetChildren()) do
            if plate:FindFirstChild("Button") then plates[#plates + 1] = plate end
        end
        table.sort(plates, function(a, b) return a.Name < b.Name end)
        FunctionsHandler.Saber:Set('QuestplatesCache', plates)
        return plates
    end)

    FunctionsHandler.Saber:RegisterMethod('Start', function()
        local stage = FunctionsHandler.Saber:Get("CurrentProgressLevel")
        local refreshedAt = FunctionsHandler.Saber:Get('LastestRefreshSenque')
        -- The Mob Leader can die between refreshes. Refresh late stages every few
        -- seconds, while also throttling missing/late progress responses at startup.
        local refreshWindow = (stage == 5 or stage == 6 or stage == 7) and 3 or (stage and 12 or 5)
        if not refreshedAt or os.time() - refreshedAt > refreshWindow then
            FunctionsHandler.Saber.Methods.Refresh:Call()
            stage = FunctionsHandler.Saber:Get("CurrentProgressLevel")
        end
        if not stage then return end

        if stage == 1 then
            local plates = FunctionsHandler.Saber.Methods.GetQuestplates:Call()
            if #plates == 0 then
                saberSetStatus("Waiting for the Jungle plates to load")
                return
            end
            for index, plate in ipairs(plates) do
                local button = plate:FindFirstChild("Button")
                if button and button:IsA("BasePart") and CaculateDistance(button.CFrame) > 20 then
                    saberSetStatus("Activating Jungle plate " .. tostring(index) .. " of " .. tostring(#plates))
                    SetTask('MainTask', "Auto Saber | Activating Jungle plate " .. tostring(index) .. "/" .. tostring(#plates))
                    TweenController.Create(button.CFrame)
                    return
                end
            end
            task.wait(0.2)
        elseif stage == 2 then
            saberSetStatus("Using the torch at the frozen cave")
            SetTask('MainTask', 'Auto Saber | Using the torch')
            pcall(function() Remotes.CommF_:InvokeServer("ProQuestProgress", 'GetTorch') end)
            task.wait(0.5)
            pcall(function() Remotes.CommF_:InvokeServer('ProQuestProgress', "DestroyTorch") end)
        elseif stage == 3 then
            saberSetStatus("Getting the cup and filling it")
            SetTask('MainTask', "Auto Saber | Filling the cup")
            pcall(function() Remotes.CommF_:InvokeServer('ProQuestProgress', "GetCup") end)
            local cup = (LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Cup"))
                or (LocalPlayer.Backpack and LocalPlayer.Backpack:FindFirstChild("Cup"))
            if cup then
                pcall(function() FunctionsHandler.LocalPlayerController.Methods.EquipTool:Call('Cup') end)
                task.wait(0.35)
                pcall(function()
                    local heldCup = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Cup")
                    if heldCup then Remotes.CommF_:InvokeServer("ProQuestProgress", 'FillCup', heldCup) end
                end)
            else
                saberSetStatus("Waiting for the Cup to appear in inventory")
            end
            pcall(function() Remotes.CommF_:InvokeServer("ProQuestProgress", 'SickMan') end)
        elseif stage == 4 then
            saberGoTalkToRichMan("Starting the Mob Leader quest")
        elseif stage == 5 then
            saberSetStatus("Fighting Mob Leader")
            SetTask("MainTask", "Auto Saber | Defeating Mob Leader")
            CombatController.Attack('Mob Leader')
        elseif stage == 6 then
            if not saberHasRelic() then
                saberGoTalkToRichMan("Talking to Rich Man to get the Relic")
                return
            end
            local doorOpen = saberDoorIsOpen()
            if not doorOpen and CaculateDistance(SABER_RELIC_DOOR) > 14 then
                saberSetStatus("Taking the Relic back to the Jungle door")
                SetTask("MainTask", "Auto Saber | Taking Relic to Jungle door")
                TweenController.Create(SABER_RELIC_DOOR)
                return
            end
            if not doorOpen then
                saberSetStatus("Equipping the Relic and opening the door")
                SetTask("MainTask", "Auto Saber | Opening the Saber Expert door")
                pcall(function() FunctionsHandler.LocalPlayerController.Methods.EquipTool:Call("Relic") end)
                task.wait(0.3)
                pcall(function() Remotes.CommF_:InvokeServer("ProQuestProgress", "PlaceRelic") end)
                task.wait(0.4)
            end
        elseif stage == 7 then
            local enemies = Services.Workspace:FindFirstChild("Enemies")
            local boss = enemies and (enemies:FindFirstChild("Saber Expert")
                or enemies:FindFirstChild("Saber Expert [Lv. 200] [Boss]"))
            if not boss then
                boss = ScriptStorage.Enemies["Saber Expert"]
                if boss and not boss:IsDescendantOf(Services.Workspace) then boss = nil end
            end
            if boss and boss:FindFirstChildOfClass("Humanoid") and boss:FindFirstChildOfClass("Humanoid").Health > 0 then
                saberSetStatus("Fighting Saber Expert")
                SetTask('MainTask', "Auto Saber | Fighting Saber Expert")
                -- The live model may include its level/boss suffix in Name; target that
                -- exact replicated name so Search does not miss the boss after it spawns.
                CombatController.Attack(boss.Name)
            else
                saberSetStatus("Waiting for Saber Expert to spawn")
                SetTask("MainTask", "Auto Saber | Waiting for Saber Expert to spawn")
                if CaculateDistance(SABER_BOSS_AREA) > 35 then TweenController.Create(SABER_BOSS_AREA) end
            end
        end
    end)
