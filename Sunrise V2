    -- Lightweight Misc ESP: event-driven candidates plus shallow periodic reconciliation.
    do
        local espObjects = setmetatable({}, {__mode = "k"})
        local function clearMiscESP(obj)
            local h = espObjects[obj]
            if h then pcall(function() h:Destroy() end); espObjects[obj] = nil end
        end
        local function isFruitObject(obj)
            local n = string.lower(tostring(obj and obj.Name or ""))
            return (obj:IsA("Tool") or obj:IsA("Model") or obj:IsA("BasePart")) and string.find(n, "fruit", 1, true) ~= nil
        end
        local function espAdornee(obj)
            if obj:IsA("Model") then return obj end
            if obj:IsA("BasePart") then return obj end
            if obj:IsA("Tool") then return obj:FindFirstChildWhichIsA("BasePart") end
            return nil
        end
        local function setMiscESP(obj, key, enabled, color)
            local old = espObjects[obj]
            if not enabled or not obj or not obj.Parent then clearMiscESP(obj); return end
            local adorn = espAdornee(obj)
            if not adorn then clearMiscESP(obj); return end
            if old and old.Parent and old.Adornee == adorn then return end
            clearMiscESP(obj)
            local h = Instance.new("Highlight")
            h.Name = "Sunrise_MiscESP_" .. key
            h.Adornee = adorn
            h.FillColor = color
            h.OutlineColor = color
            h.FillTransparency = 0.72
            h.OutlineTransparency = 0.05
            h.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
            h.Parent = obj
            espObjects[obj] = h
        end
        workspace.DescendantAdded:Connect(function(obj)
            if Config.Misc and Config.Misc.FruitESP and isFruitObject(obj) then
                task.defer(function() if obj.Parent then setMiscESP(obj, "Fruit", true, Color3.fromRGB(255, 210, 80)) end end)
            end
        end)
        task.spawn(function()
            while task.wait(3) do
                pcall(function()
                    local fruits = {}
                    if Config.Misc and Config.Misc.FruitESP then
                        for _, obj in ipairs(workspace:GetChildren()) do if isFruitObject(obj) then fruits[obj] = true; setMiscESP(obj, "Fruit", true, Color3.fromRGB(255, 210, 80)) end end
                        local folder = workspace:FindFirstChild("Fruits")
                        if folder then for _, obj in ipairs(folder:GetChildren()) do if isFruitObject(obj) then fruits[obj] = true; setMiscESP(obj, "Fruit", true, Color3.fromRGB(255, 210, 80)) end end end
                    end
                    local npcs = workspace:FindFirstChild("NPCs")
                    local found = {}
                    if npcs then
                        for _, npc in ipairs(npcs:GetChildren()) do
                            local normalized = string.lower(tostring(npc.Name)):gsub("[^%w]", "")
                            local haki = string.find(normalized, "barista", 1, true) or string.find(normalized, "colorsdealer", 1, true) or string.find(normalized, "auracolor", 1, true)
                            local sword = normalized == "legendarysworddealer"
                            if haki and Config.Misc and Config.Misc.HakiDealerESP then found[npc] = true; setMiscESP(npc, "HakiDealer", true, Color3.fromRGB(95, 185, 255))
                            elseif sword and Config.Misc and Config.Misc.LegendarySwordDealerESP then found[npc] = true; setMiscESP(npc, "LegendarySwordDealer", true, Color3.fromRGB(255, 220, 90))
                            else if espObjects[npc] then clearMiscESP(npc) end end
                        end
                    end
                    for obj, h in pairs(espObjects) do
                        if not obj.Parent or (isFruitObject(obj) and not (Config.Misc and Config.Misc.FruitESP)) then clearMiscESP(obj) end
                    end
                end)
            end
        end)
    end

