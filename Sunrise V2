    local function makeDrag(handle, target, onTap)
        handle.InputBegan:Connect(function(input)
            local t = input.UserInputType
            if t ~= Enum.UserInputType.Touch and t ~= Enum.UserInputType.MouseButton1 then return end
            local startPos, startAbs = input.Position, target.AbsolutePosition
            local moved = false
            local mc
            mc = UIS.InputChanged:Connect(function(i)
                if i == input or i.UserInputType == Enum.UserInputType.MouseMovement then
                    local dx, dy = i.Position.X - startPos.X, i.Position.Y - startPos.Y
                    if math.abs(dx) + math.abs(dy) > 8 then moved = true end
                    if moved then
                        local vp = workspace.CurrentCamera.ViewportSize
                        local sz, ap = target.AbsoluteSize, target.AnchorPoint
                        local nx = math.clamp(startAbs.X + dx, 0, math.max(0, vp.X - sz.X))
                        local ny = math.clamp(startAbs.Y + dy, 0, math.max(0, vp.Y - sz.Y))
                        target.Position = UDim2.fromOffset(nx + ap.X * sz.X, ny + ap.Y * sz.Y)
                    end
                end
            end)
            input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then mc:Disconnect(); if not moved and onTap then onTap() end end
            end)
        end)
    end
