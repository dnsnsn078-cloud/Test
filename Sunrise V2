            local noticeWords = {"already", "inventory", "storage", "stored", "full"}
            -- translation helper labels the game spawns for every message: never show them
            pg.DescendantAdded:Connect(function(d)
                pcall(function()
                    if d:IsA("TextLabel") and d.Parent and d.Parent.Name == "TranslationCapture" then d.Visible = false end
                end)
            end)
            -- "already stored / inventory full" notices while we are handling fruit
            local notif = pg:FindFirstChild("Notifications")
            if notif then
                notif.DescendantAdded:Connect(function(d)
                    pcall(function()
                        if (os.clock() < suppressUntil or os.clock() < (S.StoreQuiet or 0)) and d:IsA("TextLabel") then
                            task.wait()
                            local t = string.lower(d.Text or "")
                            for _, w in ipairs(noticeWords) do
                                if string.find(t, w, 1, true) then
                                    d.Visible = false
                                    local f = d:FindFirstAncestorOfClass("Frame")
                                    if f then f.Visible = false end
                                    break
                                end
                            end
                        end
                    end)
                end)
            end
            local lastUiSuppressScan = 0
            local lastHudRestoreScan = 0
            game:GetService("RunService").RenderStepped:Connect(function()
                local now = os.clock()
                if now < suppressUntil and now - lastUiSuppressScan >= 0.15 then
                    lastUiSuppressScan = now
                    local extra = Config.HideUINames or {}
                    for _, g in ipairs(pg:GetChildren()) do
                        if g:IsA("ScreenGui") then
                            local force = (g.Name == "SpinnerWindow" or g.Name == "DialogueGui")
                            if g.Enabled and (force or table.find(extra, g.Name) or (not keepScreens[g.Name] and not snap[g])) then g.Enabled = false end
                            for _, f in ipairs(g:GetChildren()) do
                                if f:IsA("GuiObject") and f.Visible and not snap[f] then
                                    local n = string.lower(f.Name)
                                    local hit = table.find(extra, f.Name) ~= nil
                                    for _, w in ipairs(revealWords) do if string.find(n, w, 1, true) then hit = true break end end
                                    if hit then f.Visible = false end
                                end
                            end
                        end
                    end
                end
                if not rolling or now - lastHudRestoreScan < 0.15 then return end
                lastHudRestoreScan = now
                for _, n in ipairs(hudScreens) do
                    local g = pg:FindFirstChild(n)
                    if g and not g.Enabled then g.Enabled = true end
                end
                for _, path in ipairs(hudFrames) do
                    local o = pg
                    for _, part in ipairs(path) do o = o and o:FindFirstChild(part) end
                    if o and o:IsA("GuiObject") and not o.Visible then o.Visible = true end
                end
            end)
        end)

        -- ===== always-on: store fruits (10 tries, 10 s apart, then skip that fruit) =====
        task.spawn(function()
            local tracked = {}
            while task.wait(0.5) do
                pcall(function()
                    if not Config.Rolls.Store or Config.Mode == "FruitFinder" then return end
                    if os.clock() < (S.StoreHold or 0) then return end
                    local char = lp_.Character
                    local hum = char and char:FindFirstChildOfClass("Humanoid")
                    if not hum then return end
                    for _, container in ipairs({lp_.Backpack, char}) do
                        for _, t in ipairs(container:GetChildren()) do
                            if t:IsA("Tool") and t.Name:find("Fruit") then
                                local st = tracked[t]
                                if not st then st = {attempts = 0, nextTry = 0, blocked = false}; tracked[t] = st end
                                local skip = false
                                if Config.Items.AutoRandomFruit and ScriptStorage.IgnoreStoreFruits then
                                    for _, n in pairs(ScriptStorage.IgnoreStoreFruits) do
                                        if n == t.Name or n == t:GetAttribute("OriginalName") then skip = true end
                                    end
                                end
                                if not skip and not st.blocked and os.clock() >= st.nextTry then
                                    S.StoreQuiet = os.clock() + 6
                                    if st.attempts == 0 and S.inventoryHas(S.fruitKey(t)) then
                                        st.blocked = true -- already stored once: the game refuses duplicates
                                        S.logFruit(t.Name, false, "already in storage")
                                    else
                                        st.attempts = st.attempts + 1
                                        st.nextTry = os.clock() + 10
                                        local done = S.storeOnce(t)
                                        if done then
                                            State.Stored = State.Stored + 1
                                            S.logFruit(t.Name, true)
                                            tracked[t] = nil
                                        elseif st.attempts >= 10 then
                                            st.blocked = true -- 10 tries failed: storage is probably full
                                            S.logFruit(t.Name, false, "storage full?")
                                        end
                                    end
                                end
                            end
                        end
                    end
                    for t in pairs(tracked) do if not t.Parent then tracked[t] = nil end end
                end)
            end
        end)
    end

