        for _, neededItem in ipairs(req.items or {}) do
            local alternatives = {}
            for part in string.gmatch(tostring(neededItem), "([^|]+)") do alternatives[#alternatives + 1] = (part:gsub("^%s+", ""):gsub("%s+$", "")) end
            local isOrList = #alternatives == 1 and alternatives[1]:find(" or ", 1, true)
            if isOrList then
                -- Avoid an unreliable parser for arbitrary names: list alternatives as
                -- text unless one of the exact named keys can be checked safely.
                local found = false
                local left, right = alternatives[1]:match("^(.-)%s+or%s+(.+)$")
                if left and right then found = CheckItem(left) or CheckItem(right) end
                if not found then misses = misses + 1; addLine("MISSING: one of these prerequisites: " .. alternatives[1] .. ".", T.warn, true)
                else addLine("✓ Alternative prerequisite already owned: " .. alternatives[1] .. ".", T.good) end
            elseif CheckItem(neededItem) then
                addLine("✓ Prerequisite owned: " .. tostring(neededItem) .. ".", T.good)
            else
                misses = misses + 1
                addLine("MISSING: prerequisite item/quest object — " .. tostring(neededItem) .. ".", T.warn, true)
            end
        end
        if req.materials and #req.materials > 0 then
            addLine("Materials / quantities to prepare:", T.sub, true)
            for _, material in ipairs(req.materials) do addLine("• " .. tostring(material), T.text) end
        end
        if req.source and req.source ~= "" then addLine("ACQUISITION: " .. tostring(req.source), T.sub, true) end
        if req.warning then addLine("Automation note: a puzzle, timed/event condition, trade, or manual item route is required; the controller may wait for that step instead of completing it automatically.", T.warn) end
        if misses == 0 and status == "available" then addLine("No tracked minimum requirement is currently missing. The item may still need its listed quest, boss, event, or purchase interaction.", T.good, true) end
        addLine("Note: live inventory/currency replication can take a moment to refresh.", T.sub)
        ovList.CanvasPosition = Vector2.new(0, 0)
        overlay.Position = UDim2.fromOffset(0, 12)
        overlay.Visible = true
        tween(overlay, {Position = UDim2.fromOffset(0, 0)}, 0.12)
    end

