    function S.SetMode(mode)
        local prev = Config.Mode
        -- Presets may temporarily enable several switches. Snapshot them once on
        -- entry and restore their prior values on exit instead of leaking them into Custom.
        if mode == "BoneCastle" and prev ~= "BoneCastle" then
            S.BoneCastleSnapshot = {
                Bones = Config.Rolls.Bones,
                Fruits = Config.Rolls.Fruits,
                DefendRaid = Config.CastleBone.DefendRaid,
            }
            Config.Rolls.Bones, Config.Rolls.Fruits, Config.CastleBone.DefendRaid = true, true, true
        end
        if mode == "FruitFinder" and prev ~= "FruitFinder" then
            Config.Finder.PrevMode = (prev == "BoneCastle") and "Custom" or prev
        end
        if prev == "BoneCastle" and mode ~= "BoneCastle" and S.BoneCastleSnapshot then
            Config.Rolls.Bones = S.BoneCastleSnapshot.Bones
            Config.Rolls.Fruits = S.BoneCastleSnapshot.Fruits
            Config.CastleBone.DefendRaid = S.BoneCastleSnapshot.DefendRaid
            S.BoneCastleSnapshot = nil
        end
        Config.Mode = mode
        -- Switching modes stops the previous destination tween immediately; the new mode
        -- may request a fresh tween on its next update cycle.
        if prev ~= mode and TweenController and TweenController.Cancel then
            pcall(function() TweenController.Cancel(false) end)
        end
        S.save()
        if S.OnModeChanged then pcall(S.OnModeChanged, mode, prev) end
        if mode == "FruitFinder" then
            if _G then _G.Stop = true end -- pause the normal script while hunting
            S.Finder.Start()
        elseif prev == "FruitFinder" then
            S.Finder.Stop(true)
            if _G then _G.Stop = false end
        end
    end

