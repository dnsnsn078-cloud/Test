    end
    local function SunriseSetMeleeMasteryAliases(name, mastery)
        ScriptStorage.Melees[name] = mastery
        local normalized = SunriseNormalizeOwnedName(name)
        for _, group in ipairs(SUNRISE_ITEM_ALIAS_GROUPS) do
            local isAlias = false
            for _, alias in ipairs(group) do
                if SunriseNormalizeOwnedName(alias) == normalized then isAlias = true; break end
