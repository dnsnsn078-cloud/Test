-- Incremental descendant traversal. GetDescendants() allocates one huge snapshot
-- synchronously; this walker expands the tree in batches so large maps do not
-- monopolize a frame. Call it from task.spawn/task.defer, as the consumers below do.
local function SunriseWalkDescendantsChunked(root, callback, batchSize)
    if not root or type(callback) ~= "function" then return false end
    batchSize = math.max(50, math.floor(tonumber(batchSize) or 250))
    -- Depth-first traversal keeps only the current branch/sibling stack alive.
    -- A breadth-first queue retains references to nearly the entire world until done.
    local pending, processed = {root}, 0
    while #pending > 0 do
        local current = pending[#pending]
        pending[#pending] = nil
        local children = current:GetChildren()
        for i = #children, 1, -1 do
            local child = children[i]
            local keepGoing = callback(child)
            if keepGoing == false then
                table.clear(pending)
                return false
            end
            pending[#pending + 1] = child
            processed = processed + 1
            if processed % batchSize == 0 then task.wait() end
        end
    end
    table.clear(pending)
    return true
end

-- One shared world index serves all optional controllers. Previously the status panel,
-- island detector and Soul Guitar goal each walked Workspace independently. The index
-- is populated once in yielding batches and thereafter maintained by add/remove events.
local SunriseWorldIndex = {
    Ready = false,
    Chests = {},
    StatusCandidates = {},
    IslandCandidates = {},
}
local function SunriseIndexWorldObject(obj, present)
    if not obj then return end
    if not present then
        SunriseWorldIndex.Chests[obj] = nil
        SunriseWorldIndex.StatusCandidates[obj] = nil
        SunriseWorldIndex.IslandCandidates[obj] = nil
        return
    end
    if not obj:IsDescendantOf(workspace) then return end
    local isPart = obj:IsA("BasePart")
    local isModel = obj:IsA("Model")
    local isTool = obj:IsA("Tool")
    if not (isPart or isModel or isTool) then return end
    local lowerName = string.lower(obj.Name)
    if isPart and string.find(lowerName, "chest", 1, true) then
        SunriseWorldIndex.Chests[obj] = true
    end
    if isModel or isTool then
        -- Avoid allocating normalized strings for the thousands of unrelated Models/Tools.
        if string.find(lowerName, "leviathan", 1, true) or string.find(lowerName, "barista", 1, true)
            or string.find(lowerName, "legendary", 1, true) or string.find(lowerName, "fruit", 1, true) then
            local compact = lowerName:gsub("[^%w]", "")
            if string.find(compact, "leviathan", 1, true) or compact == "barista"
                or compact == "legendarysworddealer" or string.find(compact, "fruit", 1, true) then
                SunriseWorldIndex.StatusCandidates[obj] = true
            end
        end
    end
    if isModel or isPart then
        -- Most part names never contain an island key; do not normalize them needlessly.
        if string.find(lowerName, "mirage", 1, true) or string.find(lowerName, "prehistoric", 1, true)
            or string.find(lowerName, "kitsune", 1, true) then
            local compact = lowerName:gsub("[%s%-%_]", "")
            if string.find(compact, "mirageisland", 1, true)
                or string.find(compact, "prehistoricisland", 1, true)
                or string.find(compact, "kitsuneisland", 1, true) then
                SunriseWorldIndex.IslandCandidates[obj] = true
            end
        end
    end
end
