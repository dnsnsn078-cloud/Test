                    if typeof(point) == "Vector3" then TweenController.Create(CFrame.new(point + Vector3.new(0, 35, 35))) end
                end
                return
            end
            local wizardCF = CFrame.new(5814.427, 1208.327, 884.579)
            if CaculateDistance(wizardCF) > 18 then
                SunriseDracoSeaProfile(nil)
                SetTask("MainTask", "Auto Draco | return to Dragon Wizard to begin/check the V3 trial")
                TweenController.Create(wizardCF)
                return
            end
            local upgradeReady = sunriseDracoV3TrialReady and true or SunriseDracoWizardStep("Upgrade", "V3 trial")
