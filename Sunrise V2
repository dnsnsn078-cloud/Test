    local function SunriseOwnedNameCandidates(itemName)
        local wanted = SunriseNormalizeOwnedName(itemName)
        local result, seen = {tostring(itemName)}, {[wanted] = true}
        for _, group in ipairs(SUNRISE_ITEM_ALIAS_GROUPS) do
            local belongs = false
            for _, alias in ipairs(group) do
                if SunriseNormalizeOwnedName(alias) == wanted then belongs = true; break end
            end
            if belongs then
                for _, alias in ipairs(group) do
                    local normalized = SunriseNormalizeOwnedName(alias)
                    if not seen[normalized] then
                        result[#result + 1] = alias
                        seen[normalized] = true
                    end
                end
            end
        end
        return result, seen
    end
    local function SunriseInventoryEntryIsOwned(entry)
        if entry == nil or entry == false then return false end
        if type(entry) ~= "table" then return true end
        for _, fieldName in ipairs({"Count", "Value", "Quantity"}) do
            local value = tonumber(entry[fieldName])
            if value ~= nil and value <= 0 then return false end
        end
        return true
    end
    local function SunriseCheckItemUncached(itemName)
        if itemName == nil or tostring(itemName) == "" then return false end
        local _, wantedNames = SunriseOwnedNameCandidates(itemName)
        local player = game:GetService("Players").LocalPlayer
        local bp = player and player:FindFirstChild("Backpack")
        local char = player and player.Character

        -- 1) Real tools in Backpack/Character (equipped status is still supported).
        local toolContainers = {}
        if bp then toolContainers[#toolContainers + 1] = bp end
        if char then toolContainers[#toolContainers + 1] = char end
        for _, container in ipairs(toolContainers) do
            for _, tool in ipairs(container:GetChildren()) do
                if tool:IsA("Tool") then
                    local name = SunriseNormalizeOwnedName(tool.Name)
                    if wantedNames[name] then return tool end
                    -- Preserve the old forgiving match, using a plain substring rather than a Lua pattern.
                    local query = SunriseNormalizeOwnedName(itemName)
                    if query ~= "" and #query >= 5 and name:find(query, 1, true) then return tool end
                end
            end
        end

        -- 2) The script's cached ItemReplicationService/getInventory inventory snapshot.
        local storage = ScriptStorage
        local ownedInventory = storage and storage.Backpack
        if type(ownedInventory) == "table" then
            for name, entry in pairs(ownedInventory) do
                local normalized = SunriseNormalizeOwnedName(name)
                if wantedNames[normalized] or (type(entry) == "table" and wantedNames[SunriseNormalizeOwnedName(entry.Name)]) then
                    if SunriseInventoryEntryIsOwned(entry) then return entry end
                end
            end
        end

        -- 3) Fighting-style mastery tables sometimes contain a style even when no Tool is equipped.
        local meleeData = storage and storage.Melees
        if type(meleeData) == "table" then
            for name, mastery in pairs(meleeData) do
                if wantedNames[SunriseNormalizeOwnedName(name)] and mastery ~= nil then
                    return {Name = name, Type = "Melee", Mastery = mastery}
                end
            end
        end

        -- 4) Throttled server inventory cache catches stored weapons/styles missed by replicated local tables.
        local remoteInventory = SunriseRemoteInventoryCache
        for name, entry in pairs(remoteInventory) do
            if wantedNames[SunriseNormalizeOwnedName(name)] or (type(entry) == "table" and wantedNames[SunriseNormalizeOwnedName(entry.Name)]) then
                if SunriseInventoryEntryIsOwned(entry) then return entry end
            end
        end
        -- Fire one non-blocking refresh at most every 8 seconds; never InvokeServer on every check.
        SunriseQueueInventorySnapshot(false)
        return false
    end

    function CheckItem(itemName)
        if itemName == nil or tostring(itemName) == "" then return false end
        local key = SunriseNormalizeOwnedName(itemName)
        local now = os.clock()
