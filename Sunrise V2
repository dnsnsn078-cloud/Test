-- Choose Pirates once only if the player has not joined a team. All legacy
-- startup paths share this one-shot helper to prevent duplicate team requests.
local __SUNRISE_TEAM_SELECT_ATTEMPTED = false
local function SunriseSelectPiratesIfUnassigned()
    local player = game:GetService("Players").LocalPlayer
    if not player then return false end
    if player.Team ~= nil then return true end
    if __SUNRISE_TEAM_SELECT_ATTEMPTED then return false end
    local ok = pcall(function()
        game:GetService("ReplicatedStorage"):WaitForChild("Remotes"):WaitForChild("CommF_"):InvokeServer("SetTeam", "Pirates")
    end)
    if ok then __SUNRISE_TEAM_SELECT_ATTEMPTED = true end
    return ok
end
