                return 39, cachedRegularDone, cachedFinaleDone
            end
            local regularDone, finaleDone = 0, false
            for _, q in ipairs(SUNRISE_SECRET_QUESTS) do
                if SUNRISE_SecretQuestIsDone(q.name) then
                    if q.name == "The Finale" then finaleDone = true else regularDone = regularDone + 1 end
                end
            end
            lastSelectedCountAt, cachedRegularDone, cachedFinaleDone = now, regularDone, finaleDone
            return 39, regularDone, finaleDone
        end
        local function refreshSecretProgress()
            local env = type(getgenv) == "function" and getgenv() or _G
            local bridge = env and env.SunriseAutoSCBridge
            SunriseReadSecretProgress(false)
            local localTotal, localDone, finaleDone = selectedCount()
