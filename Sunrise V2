Sunrise = Sunrise or {}
do
    local S = Sunrise
    local Players = game:GetService("Players")
    local HttpService = game:GetService("HttpService")
    local lp = Players.LocalPlayer

    -- ---------- workspace storage ----------
    S.Dir = "Sunrise"
    local function ensureDir(path)
        pcall(function()
            if typeof(isfolder) == "function" and typeof(makefolder) == "function" and not isfolder(path) then makefolder(path) end
        end)
    end
    ensureDir(S.Dir); ensureDir(S.Dir .. "/profiles")
    function S.readJSON(path)
        local ok, res = pcall(function()
            if typeof(isfile) == "function" and isfile(path) then return HttpService:JSONDecode(readfile(path)) end
        end)
        return ok and res or nil
    end
    function S.writeJSON(path, t)
        if typeof(writefile) ~= "function" then return false end
        return (pcall(function() writefile(path, HttpService:JSONEncode(t)) end))
    end
    local function copy(t)
        local r = {}
        for k, v in pairs(t) do
            local tv = type(v)
            if tv == "table" then r[k] = copy(v) elseif tv == "boolean" or tv == "number" or tv == "string" then r[k] = v end
        end
        return r
    end
    local function merge(dst, src)
        for k, v in pairs(src) do
            if k == "HideUINames" and type(v) == "table" then dst[k] = v
            elseif type(v) == "table" and type(dst[k]) == "table" then merge(dst[k], v)
            elseif dst[k] ~= nil and type(dst[k]) == type(v) then dst[k] = v end
        end
    end
    S.copy, S.merge = copy, merge

    -- ---------- config: everything OFF until you turn it on ----------
    local function zero(t)
        for k, v in pairs(t) do
            if type(v) == "boolean" then t[k] = false elseif type(v) == "table" then zero(v) end
        end
    end
    for _, key in ipairs({"Items", "Sword", "Guns", "Accessories", "BossWeapons", "Melee", "Settings"}) do if type(Config[key]) == "table" then zero(Config[key]) end end
    Config.AutoSea2, Config.AutoSea3, Config.AutoKen = false, false, false
    Config.BringMobs = true -- the "pull mobs together and stand still" behaviour
    Config.PanicMode = Config.PanicMode or {}
    Config.PanicMode.Enabled = false
    Config.Configuration = Config.Configuration or {}
