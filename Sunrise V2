            else
                TweenController.Create(CFrame.new(402.7189, 81.0605, -12259.543))
            end
            return
        end

        if not hasSweet then
            if hasGod and cocoa < 10 then
                SetTask("MainTask", "Dough King | God's Chalice found; gathering Cocoa before crafting")
            else
                -- Elite Pirates can drop God's Chalice. Kill one only when currently
                -- replicated, otherwise wait; no unverified remote is used to spawn it.
                local elite
                for _, eliteName in ipairs({"Deandre", "Urban", "Diablo"}) do
