        -- Raid toggle sets Config.Raid.Enabled=false before requesting this cancel;
        -- manual cancel remains an explicit last-resort override.
        if not manual and Config and Config.Raid and Config.Raid.Enabled then
            return false
        end
        TweenController.CancelVersion = (TweenController.CancelVersion or 0) + 1
        TweenController.TargetCFrame = nil
        local character = game.Players.LocalPlayer.Character
        local hrp = character and character:FindFirstChild("HumanoidRootPart")
        -- Stop the target at the player's current position before disabling the follow loop.
        if hrp and block then pcall(function() block.CFrame = hrp.CFrame end) end
        shouldTween = false
        TweenController.Preparing = false
        pcall(function() getgenv().OnFarm = false end)
        local current = TweenInstance
        TweenInstance = nil
        if current then pcall(function() current:Cancel() end) end
        if TweenInstance2 then pcall(function() TweenInstance2:Cancel() end); TweenInstance2 = nil end
        if manual then TweenController.CancelledUntil = os.clock() + 3 end
        restoreTweenPhysics(true)
    end

