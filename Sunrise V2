-- Read progress in the same shape used by the original AutoSC task engine.
-- The game reports each secret under Sea1/<island>/<quest name>; task completion
-- should be based on those exact keys, not on the number of arbitrary true fields.
local function IsSecretProgressComplete(value)
    if value == true then return true end
    if type(value) == "table" and value.Completed == true then return true end
    return false
end

local function NormalizeSecretProgressName(value)
    return tostring(value or ""):lower():gsub("[^%w]", "")
end

local function SunriseAutoSCProgressSea()
    local id = game.PlaceId
    if id == 2753915549 or id == 85211729168715 then return 1 end
    if id == 4442272183 or id == 79091703265657 then return 2 end
    if id == 7449423635 or id == 7449925015 or id == 100117331123089 then return 3 end
    return 0
end

GetHiddenProgress = function(force)
    -- Scan on join. In Sea 1, later scans are driven by explicit invalidation after
    -- quest progress; Sea 2/3 reuse the initial snapshot. Failed reads retry slowly.
    local now = os.clock()
    local sea = SunriseAutoSCProgressSea()
    HiddenEvent.progressScanBySea = HiddenEvent.progressScanBySea or {}
    local scanned = HiddenEvent.progressScanBySea[sea] == true
    local minRetry = (HiddenEvent.progressLastAttempt and now - HiddenEvent.progressLastAttempt < 2.5) or false
    local refresh = false
    if not scanned then
        refresh = not minRetry and (not HiddenEvent.progressLastAttempt or now - HiddenEvent.progressLastAttempt >= 12)
    elseif sea == 1 and (force == true or (tonumber(HiddenEvent.checked) or 0) <= 0) then
        refresh = not minRetry
    elseif (HiddenEvent.progressLastError or "") ~= "" and now - (HiddenEvent.progressLastAttempt or 0) >= 15 then
        refresh = true
    end
    if refresh then
        HiddenEvent.checked = now
        HiddenEvent.progressLastAttempt = now
        local ok, result = pcall(function()
            return ReplicatedStorage.Modules.Net["RF/RequestBonusMomentReplication"]:InvokeServer({Type="GetMomentProgress"})
        end)
        if ok and type(result) == "table" and type(result.Data) == "table" then
            local previous = type(HiddenEvent.progress) == "table" and HiddenEvent.progress or {}
            local normalized = {}
            local newlyCompleted = false
            for k, value in pairs(result.Data) do
                local done = IsSecretProgressComplete(value) or IsSecretProgressComplete(previous[k])
                normalized[k] = done
                if done and not IsSecretProgressComplete(previous[k]) and tostring(k):sub(1, 5) == "Sea1/" then newlyCompleted = true end
            end
            -- Preserve true entries even when the server omits them from a later snapshot.
            for k, value in pairs(previous) do
                if IsSecretProgressComplete(value) then normalized[k] = true end
            end
            HiddenEvent.progress = normalized
            HiddenEvent.progressVersion = (HiddenEvent.progressVersion or 0) + 1
            HiddenEvent.progressScanBySea[sea] = true
            HiddenEvent.progressScannedSea = sea
            HiddenEvent.progressLastError = nil
            HiddenEvent.progressLastSuccess = now
            if newlyCompleted then
                local env = type(getgenv) == "function" and getgenv() or _G
                local callback = env and env.SunriseOnSecretProgressChanged
                if type(callback) == "function" then task.defer(callback) end
            end
        else
            HiddenEvent.progressLastError = ok and "The server returned no progress data" or tostring(result)
        end
    elseif HiddenEvent.progressLastError and not scanned and now - (HiddenEvent.progressLastAttempt or 0) >= 15 then
        HiddenEvent.checked = 0
    end
    return HiddenEvent.progress or {}
end

local cachedSecretProgressTable = nil
local cachedSecretProgressVersion = -1
local cachedSecretProgressDone = 0
local function CountSecretDone(progress)
    -- A version counter protects against in-place mutations as well as replaced tables.
    progress = type(progress) == "table" and progress or {}
    local version = tonumber(HiddenEvent.progressVersion) or 0
    if progress == cachedSecretProgressTable and version == cachedSecretProgressVersion then
        return cachedSecretProgressDone
    end

    -- Index completed quest names once. The old code rescanned every progress key
    -- for each of the 39 quests on every scheduler tick (often several times/sec).
    local completedNames = {}
    for progressKey, value in pairs(progress) do
        if IsSecretProgressComplete(value) then
            local keyText = tostring(progressKey)
            if keyText:sub(1, 5) == "Sea1/" then
                local leaf = keyText:match("([^/]+)$") or keyText
                completedNames[NormalizeSecretProgressName(leaf)] = true
            end
        end
    end

    local n, seen = 0, {}
    for _, quest in ipairs(HiddenQuests or {}) do
        if type(quest) == "table" and type(quest.Name) == "string" and quest.Name ~= "" then
            local normalizedName = NormalizeSecretProgressName(quest.Name)
            if not seen[normalizedName] then
                seen[normalizedName] = true
                local key = "Sea1/" .. tostring(quest.Island or "") .. "/" .. quest.Name
                if IsSecretProgressComplete(progress[key]) or completedNames[normalizedName] then
                    n += 1
                end
            end
        end
    end

    cachedSecretProgressTable = progress
    cachedSecretProgressVersion = version
    cachedSecretProgressDone = math.min(n, 39)
    return cachedSecretProgressDone
end

