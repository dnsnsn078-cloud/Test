    -- Share child snapshots between the combat helpers. GetChildren() allocates a new
    -- array; several combat paths previously did this repeatedly in the same tick.
    local SunriseChildSnapshotCache = setmetatable({}, {__mode = "k"})
    local function SunriseGetChildrenCached(parent, refreshAfter)
        if not parent then return {} end
        local now = os.clock()
        local entry = SunriseChildSnapshotCache[parent]
        if not entry then
            entry = {items = {}, updated = 0, dirty = true}
            SunriseChildSnapshotCache[parent] = entry
            pcall(function() parent.ChildAdded:Connect(function() entry.dirty = true end) end)
            pcall(function() parent.ChildRemoved:Connect(function() entry.dirty = true end) end)
        end
        if entry.dirty or now - entry.updated >= (refreshAfter or 0.25) then
            local ok, children = pcall(parent.GetChildren, parent)
            entry.items = ok and children or {}
            entry.updated = now
            entry.dirty = false
        end
        return entry.items
    end

    -- Many callers ask for the nearest NPC several times per farm tick. Cache the
    -- sorted list briefly and compute each NPC distance once instead of inside the
    -- O(n log n) sort comparator.
    local SunriseMonRangeCache = {}
    local SunriseMonRangeCacheAt = -math.huge
    function GetMonAsSortedRange()
        local now = os.clock()
        if now - SunriseMonRangeCacheAt < 0.30 then
            return SunriseMonRangeCache
        end

        local W, distanceByModel = {}, {}
        local player = game.Players.LocalPlayer
        local character = player and player.Character
        local playerRoot = character and character:FindFirstChild("HumanoidRootPart")
        local origin = playerRoot and playerRoot.Position
        local function addLivingModels(parent)
            for _, entity in ipairs(SunriseGetChildrenCached(parent, 0.25)) do
                local humanoid = entity and entity:FindFirstChild("Humanoid")
                local root = entity and entity:FindFirstChild("HumanoidRootPart")
                if humanoid and root and humanoid.Health > 0 then
                    W[#W + 1] = entity
                    distanceByModel[entity] = origin and (root.Position - origin).Magnitude or math.huge
                end
            end
        end
        addLivingModels(Services.Workspace:FindFirstChild("Enemies"))
        addLivingModels(game:GetService("ReplicatedStorage"))
        table.sort(W, function(a, b)
            return (distanceByModel[a] or math.huge) < (distanceByModel[b] or math.huge)
        end)
        SunriseMonRangeCache = W
        SunriseMonRangeCacheAt = now
        return SunriseMonRangeCache
    end
