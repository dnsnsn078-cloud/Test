    local autoSCPrerequisiteLastNotice = 0
    local function queueAutoSCMeleeSecret(taskName)
        Config.SecretQuest = Config.SecretQuest or {Enabled=false, Selected={}, Completed={}, Order={}}
        Config.SecretQuest.Selected = Config.SecretQuest.Selected or {}
        Config.SecretQuest.Order = Config.SecretQuest.Order or {}
        Config.SecretQuest.Selected[taskName] = true
        local order = {taskName}
        for _, oldName in ipairs(Config.SecretQuest.Order) do
            if oldName ~= taskName and Config.SecretQuest.Selected[oldName] == true then order[#order + 1] = oldName end
        end
        Config.SecretQuest.Order = order
        local env = getgenv and getgenv()
        local bridge = env and env.SunriseAutoSCBridge
        if bridge and type(bridge.SetSelection) == "function" then
            local ok, err = pcall(bridge.SetSelection, Config.SecretQuest.Selected, order)
            if not ok then warn("[Sunrise AutoSC] could not queue the Fishman Karate prerequisite:", err) end
        end
        pcall(function() S.queueSave() end)
    end
    local function ensureAutoSCForMeleePrerequisite()
        local now = os.clock()
        local env = getgenv and getgenv()
        local bridge = env and env.SunriseAutoSCBridge
        if (SeaIndex or 1) ~= 1 then
            if now - autoSCPrerequisiteLastNotice > 8 then
                autoSCPrerequisiteLastNotice = now
                SetTask("MainTask", "Auto Melee | Fishman Karate needs its First Sea secret; return to First Sea")
            end
            return false
        end
        if not bridge or type(bridge.SetEnabled) ~= "function" or type(bridge.IsEnabled) ~= "function" then
            if now - autoSCPrerequisiteLastNotice > 8 then
                autoSCPrerequisiteLastNotice = now
                SetTask("MainTask", "Auto Melee | waiting for the embedded AutoSC engine")
            end
            return false
        end
        local statusOk, alreadyEnabled = pcall(bridge.IsEnabled)
        if statusOk and alreadyEnabled == true then return true end
        Config.SecretQuest.Enabled = true
        if env and Config.AutoExec and type(Config.AutoExec.Url) == "string" and Config.AutoExec.Url ~= "" then env.SunriseEmbeddedAutoExecUrl = Config.AutoExec.Url end
        local ok, result = pcall(bridge.SetEnabled, true)
        if not ok or result == false then
            Config.SecretQuest.Enabled = false
            if now - autoSCPrerequisiteLastNotice > 8 then
                autoSCPrerequisiteLastNotice = now
                SetTask("MainTask", "Auto Melee | AutoSC could not start the First Sea prerequisite")
            end
            return false
        end
        pcall(function() S.queueSave() end)
        return true
    end

    local function meleeGoalEnabled(name)
        if not Config.Melee.AutoBuy then return false end
        local selected = Config.Items.MeleeGoals or {}
        local allMode = Config.Items.AutoFullyMelees == true
        -- Update 30's Underwater City secret unlocks the Fishman Karate route.
        -- If this is a missing prerequisite for a selected goal, queue it first.
        local fishmanNeeded = allMode or selected["Fishman Karate"] or selected["Sharkman Karate"] or selected["Superhuman"] or selected["Godhuman"]
        if name == "Fishman Karate" and fishmanNeeded and not CheckItem("Fishman Karate")
            and not SUNRISE_SecretQuestIsDone("Scattered Light") then
            queueAutoSCMeleeSecret("Fishman Karate")
            ensureAutoSCForMeleePrerequisite()
            return false
        end
        if allMode then return true end
        if selected[name] == true then return true end
        -- If the chosen target has prerequisites, include those styles in the route
        -- automatically so an individual goal does not deadlock waiting for them.
        local prerequisites = {
            ["Death Step"] = {"Black Leg"}, ["Sharkman Karate"] = {"Fishman Karate"},
            ["Electric Claw"] = {"Electro"}, ["Dragon Talon"] = {"Dragon Claw"},
            ["Superhuman"] = {"Black Leg", "Electro", "Fishman Karate", "Dragon Claw"},
            ["Godhuman"] = {"Black Leg", "Electro", "Fishman Karate", "Dragon Claw", "Superhuman", "Death Step", "Sharkman Karate", "Electric Claw", "Dragon Talon"},
        }
        for target, deps in pairs(prerequisites) do
            if selected[target] then
                for _, dep in ipairs(deps) do if dep == name then return true end end
            end
        end
        return false
    end
