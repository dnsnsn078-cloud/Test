        	local wrap = new("Frame", {Size = UDim2.new(1, 0, 0, 0), BackgroundTransparency = 1, ClipsDescendants = true, Visible = false, BorderSizePixel = 0, LayoutOrder = 2}, box)
        	local drop = new("ScrollingFrame", {Position = UDim2.fromOffset(8, 2), Size = UDim2.new(1, -16, 1, -10), BackgroundColor3 = T.field, BorderSizePixel = 0, ScrollBarThickness = 2, ScrollBarImageColor3 = T.dim, CanvasSize = UDim2.new(), AutomaticCanvasSize = Enum.AutomaticSize.Y}, wrap)
        	round(drop, 9); stroke(drop, T.line2, 1); pad(drop, 4); list(drop, 2)
        	local val, apply
        	local items, count, open = {}, 0, false
        	local function targetH() return math.min(count * 32 + 8, 160) + 10 end
        	local function setOpen(o)
        		open = o
        		if o then wrap.Visible = true end
        		tween(wrap, {Size = UDim2.new(1, 0, 0, o and targetH() or 0)}, .22)
        		tween(chev.Root, {Rotation = o and 180 or 0}, .22)
        		chev:Color(o and T.sun or T.sub)
        		if not o then task.delay(.24, function() if not open then wrap.Visible = false end end) end
        	end
        	local function paint()
        		shown.Text = val ~= nil and tostring(val) or "Choose…"
        		for key, it in pairs(items) do
        			local sel = val ~= nil and key == tostring(val)
        			it.ck.Root.Visible = sel
        			tween(it.btn, {TextColor3 = sel and T.text or T.sub}, .15)
        		end
        	end
        	local function build(opts)
        		for _, c in ipairs(drop:GetChildren()) do if c:IsA("GuiObject") then c:Destroy() end end
        		items, count = {}, #opts
        		if count == 0 then
        			count = 1
        			label(drop, {Text = "Nothing here yet", Size = UDim2.new(1, 0, 0, 30), TextColor3 = T.dim, TextSize = 12, TextXAlignment = Enum.TextXAlignment.Center})
        		end
        		for i, o in ipairs(opts) do
        			local ob = new("TextButton", {Size = UDim2.new(1, 0, 0, 30), BackgroundColor3 = T.hover, BackgroundTransparency = 1, Text = tostring(o), Font = FONT, TextSize = 13, TextColor3 = T.sub, TextXAlignment = Enum.TextXAlignment.Left, AutoButtonColor = false, BorderSizePixel = 0, LayoutOrder = i}, drop)
        			round(ob, 7); pad(ob, 28, 0, 8, 0)
        			local ck = glyph(ob, "check", 12, T.sun)
        			ck.Root.AnchorPoint = Vector2.new(0, .5); ck.Root.Position = UDim2.new(0, -20, .5, 0); ck.Root.Visible = false
        			ob.MouseEnter:Connect(function() tween(ob, {BackgroundTransparency = 0}, .1) end)
        			ob.MouseLeave:Connect(function() tween(ob, {BackgroundTransparency = 1}, .15) end)
        			ob.Activated:Connect(function() ui:_snd("pick"); apply(o); setOpen(false) end)
        			items[tostring(o)] = {btn = ob, ck = ck}
        		end
        		if open then wrap.Size = UDim2.new(1, 0, 0, targetH()) end
        		paint()
        	end
        	apply = self:_bind(def, function(v) val = v; paint() end, def.Default)
        	build(type(def.Options) == "function" and def.Options() or def.Options or {})
        	head.Activated:Connect(function() ui:_snd("click"); setOpen(not open) end)
        	return self:_reg(def, {Set = function(_, v) apply(v, true) end, Get = function() return val end, SetOptions = function(_, o) build(o) end})
        end

