            for _, islandName in ipairs(islandNames) do
                local island = map:FindFirstChild(islandName, true)
                if island then
                    local summon = island:FindFirstChild("RaidSummon2", true)
                    local part = findInSummonRoot(summon)
                    if part then return part end
                end
            end

            -- The exact named model is stable across most game revisions.
            local summon = map:FindFirstChild("RaidSummon2", true)
            local part = findInSummonRoot(summon)
            if part then return part end

            -- Last fallback: identify a clickable/prompt target by its ancestor path.
            -- Keep this search inside Map to avoid accidentally selecting other UI or NPCs.
            for _, node in ipairs(map:GetDescendants()) do
                if node:IsA("ProximityPrompt") or node:IsA("ClickDetector") then
                    local names, ancestor = {}, node
                    for _ = 1, 7 do
                        if not ancestor or ancestor == map then break end
                        names[#names + 1] = tostring(ancestor.Name):lower()
                        ancestor = ancestor.Parent
                    end
                    local path = table.concat(names, "/")
                    if path:find("raid", 1, true) and path:find("summon", 1, true) then
                        local target = targetPart(node)
                        if target then return target end
                    end
                end
            end
            return nil
        end
        local function eligibleFruits()
            -- Classic brute-force loop: use the live GetFruits catalog and let
            -- LoadFruit tell us whether each exact fruit key is stored. Do not gate
            -- the loop on getInventoryFruits; some clients return nil for that call.
            -- The queue/cursor are local to this script session and are rebuilt when
            -- Auto Raid is toggled, the script is relaunched, or a new fruit is stored.
            local limit = tonumber(Config.Raid.MaxFruitPrice) or 1000000
            if raidFruitQueue and raidQueueLimit == limit then return raidFruitQueue end

            local okCatalog, catalog = pcall(function()
                return Remotes.CommF_:InvokeServer("GetFruits")
            end)
            if not okCatalog or type(catalog) ~= "table" then return nil end

            local out, seen = {}, {}
            for _, fruit in pairs(catalog) do
                if type(fruit) == "table" then
                    local key = tostring(fruit.Name or fruit.name or "")
                    local price = tonumber(fruit.Price or fruit.price)
                    if key ~= "" and price and price < limit and not seen[key] then
                        seen[key] = true
                        -- Stored fruit keys are normally "Name-Name". Extract the
                        -- exact repeated name first (handles variants like T-Rex and
                        -- Bird: Phoenix) before using the display-name lookup fallback.
                        local base = key:match("^(.-)%-%1$")
                        if not base then
                            local info = S.FruitInfo(key)
                            base = info and info.name and info.name ~= "???" and info.name or key
                        end
                        out[#out + 1] = {name = key, price = price, base = base}
                    end
                end
            end
            table.sort(out, function(a, b)
                if a.price == b.price then return a.name < b.name end
                return a.price < b.price
            end)
            raidFruitQueue, raidQueueLimit = out, limit
            return raidFruitQueue
        end
