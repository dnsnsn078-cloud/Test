-- Kismile/Zero dungeon-style local-source auto execution.
-- Cache the current source locally and queue only a tiny loader on teleport.
autoExecSetFile = function(state)
    if getgenv().SunriseEmbeddedAutoSC then
        -- Keep hops attached to Sunrise rather than launching a standalone AutoSC copy.
        if state ~= true then
            pcall(function()
                if type(isfile) == "function" and type(delfile) == "function" and isfile(AUTO_EXEC_FILE) then
                    delfile(AUTO_EXEC_FILE)
                end
            end)
            return true
        end
        local g = getgenv()
        local cfg = rawget(g, "Config")
        local url = g.SunriseEmbeddedAutoExecUrl
        if type(url) ~= "string" or url == "" then url = (cfg and cfg.AutoExec and cfg.AutoExec.Url) or g.SunriseURL end
        if type(url) ~= "string" or url == "" then return false end
        local q = rawget(g, "queue_on_teleport")
            or (syn and syn.queue_on_teleport)
            or queueonteleport
            or (fluxus and fluxus.queue_on_teleport)
        if type(q) ~= "function" then return false end
        local loader = 'task.spawn(function() repeat task.wait(1) until game:IsLoaded(); task.wait(2); loadstring(game:HttpGet(' .. string.format('%q', url) .. '))() end)'
        return pcall(q, loader)
    end
    local q = rawget(getgenv(), "queue_on_teleport")
        or (syn and syn.queue_on_teleport)
        or queueonteleport
        or (fluxus and fluxus.queue_on_teleport)

    local supported = q ~= nil
        and type(writefile) == "function"
        and type(isfile) == "function"
        and type(readfile) == "function"
        and type(delfile) == "function"
        and type(makefolder) == "function"
        and type(isfolder) == "function"

    if not supported then
        return false
    end

    local ok = pcall(function()
        if not isfolder(SETTINGS_DIR) then
            makefolder(SETTINGS_DIR)
        end

        if state then
            local source = rawget(getgenv(), "YELU0_KAITUN_SOURCE")
            if type(source) ~= "string" or #source < 1000 then
                error("current Kaitun source is unavailable")
            end

            -- Always refresh script.txt so hops use the exact version currently running.
            writefile(AUTO_EXEC_SOURCE_FILE, source)
            writefile(AUTO_EXEC_FILE, "true")

            local loader = 'task.spawn(function()\n'
                .. '    repeat task.wait(1) until game:IsLoaded()\n'
                .. '    local Players = game:GetService("Players")\n'
                .. '    local p = Players.LocalPlayer\n'
                .. '    repeat task.wait(0.5) until p and p:FindFirstChild("PlayerGui")\n'
                .. '    task.wait(2)\n'
                .. '    local flag = ' .. string.format('%q', AUTO_EXEC_FILE) .. '\n'
                .. '    local sourcePath = ' .. string.format('%q', AUTO_EXEC_SOURCE_FILE) .. '\n'
                .. '    if isfile(flag) and readfile(flag) == "true" then\n'
                .. '        local thisJob = tostring(game.JobId)\n'
                .. '        if getgenv().YELU0_KAITUN_AUTOEXEC_JOB == thisJob then return end\n'
                .. '        getgenv().YELU0_KAITUN_AUTOEXEC_JOB = thisJob\n'
                .. '        if isfile(sourcePath) then\n'
                .. '            local src = readfile(sourcePath)\n'
                .. '            getgenv().YELU0_KAITUN_SOURCE = src\n'
                .. '            local fn, err = loadstring(src)\n'
                .. '            if fn then fn() else warn("[YELU0 KAITUN AutoExec] " .. tostring(err)) end\n'
                .. '        else\n'
                .. '            warn("[YELU0 KAITUN AutoExec] source cache missing: " .. sourcePath)\n'
                .. '        end\n'
                .. '    end\n'
                .. 'end)'

            if Runtime.AutoExecQueuedJob ~= tostring(game.JobId) then
                q(loader)
                Runtime.AutoExecQueuedJob = tostring(game.JobId)
            end
        else
            if isfile(AUTO_EXEC_FILE) then
                delfile(AUTO_EXEC_FILE)
            end
        end
    end)

    return ok
end

