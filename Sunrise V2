    local function secretNormalize(v) return tostring(v or ""):lower():gsub("[^%w]", "") end
    local secretDetectionCache, secretDetectionAt = {}, {}
    function SUNRISE_SecretQuestMarkDone(name)
        if not name or name == "" then return end
        Config.SecretQuest.Completed[name] = true
        S.SecretQuestRuntimeCompleted[name] = true
        secretDetectionCache[name] = true
        secretDetectionAt[name] = os.clock()
        pcall(function() S.queueSave() end)
    end
    function SUNRISE_SecretQuestIsDone(name)
        local bridgeEnv = getgenv and getgenv()
        local bridge = bridgeEnv and bridgeEnv.SunriseAutoSCBridge
        if bridge and type(bridge.IsDone) == "function" then
            local bridgeOk, actualDone = pcall(bridge.IsDone, name)
            if bridgeOk and actualDone ~= nil then
                if actualDone == true then
                    if not (Config.SecretQuest.Completed[name] or (S.SecretQuestRuntimeCompleted and S.SecretQuestRuntimeCompleted[name])) then
                        SUNRISE_SecretQuestMarkDone(name)
                    end
                    return true
                end
                Config.SecretQuest.Completed[name] = nil
                if S.SecretQuestRuntimeCompleted then S.SecretQuestRuntimeCompleted[name] = nil end
                secretDetectionCache[name] = false
                secretDetectionAt[name] = os.clock()
                return false
            end
        end
        if Config.SecretQuest and Config.SecretQuest.Completed and Config.SecretQuest.Completed[name] then return true end
        if S.SecretQuestRuntimeCompleted and S.SecretQuestRuntimeCompleted[name] then return true end
        local now = os.clock()
        if secretDetectionCache[name] == false and now - (secretDetectionAt[name] or 0) < 5 then return false end
        -- Some game versions expose per-secret booleans/folders directly to the client.
        local player = game:GetService("Players").LocalPlayer
        local target = secretNormalize(name)
        pcall(function()
            for _, obj in ipairs(player:GetDescendants()) do
                if secretNormalize(obj.Name) == target then
                    if obj:IsA("BoolValue") and obj.Value == true then SUNRISE_SecretQuestMarkDone(name); return true end
                    if obj:IsA("StringValue") and tostring(obj.Value):lower():find("complete", 1, true) then SUNRISE_SecretQuestMarkDone(name); return true end
                    if (obj:IsA("IntValue") or obj:IsA("NumberValue")) and obj.Value > 0 then SUNRISE_SecretQuestMarkDone(name); return true end
                end
            end
        end)
        -- The current UI may show per-island 3/3 stars or the total secret-star count.
        -- These are live client game-state indicators and also work for pre-completed saves.
        local quest = nil
        for _, q in ipairs(SUNRISE_SECRET_QUESTS) do if q.name == name then quest = q; break end end
        local pg = player:FindFirstChildOfClass("PlayerGui")
        if pg and quest then
            local islandKey = secretNormalize(quest.island)
            local allStars = false
            pcall(function()
                for _, obj in ipairs(pg:GetDescendants()) do
                    if obj:IsA("TextLabel") or obj:IsA("TextButton") or obj:IsA("TextBox") then
                        local txt = tostring(obj.Text or ""):lower()
                        local normText = secretNormalize(txt)
                        if txt:find("40/40", 1, true) or txt:find("39/39", 1, true) or txt:find("39 stars", 1, true)
                            or txt:find("200 secret levels", 1, true) or txt:find("level cap: 3000", 1, true) then allStars = true end
                        local chain = normText
                        local parent = obj.Parent
                        for _ = 1, 4 do if not parent then break end; chain = chain .. secretNormalize(parent.Name); parent = parent.Parent end
                        if chain:find(islandKey, 1, true) and (txt:find("3/3", 1, true) or txt:find("3 stars", 1, true) or txt:find("★★★", 1, true)) then
                            for _, other in ipairs(SUNRISE_SECRET_QUESTS) do if other.island == quest.island and other.name ~= "The Finale" then SUNRISE_SecretQuestMarkDone(other.name) end end
                            return true
                        end
                    end
                end
            end)
            if allStars then
                for _, q in ipairs(SUNRISE_SECRET_QUESTS) do if q.name ~= "The Finale" then SUNRISE_SecretQuestMarkDone(q.name) end end
                return true
            end
        end
        -- A 3000 cap is only reachable after the full secret sequence.
        pcall(function()
            local data = player:FindFirstChild("Data")
            if data then
                for _, key in ipairs({"LevelCap", "MaxLevel", "LevelLimit"}) do
                    local v = data:FindFirstChild(key)
                    if v and tonumber(v.Value) and tonumber(v.Value) >= 3000 then
                        for _, q in ipairs(SUNRISE_SECRET_QUESTS) do SUNRISE_SecretQuestMarkDone(q.name) end
                        return true
                    end
                end
            end
        end)
        local done = Config.SecretQuest.Completed[name] == true or S.SecretQuestRuntimeCompleted[name] == true
        secretDetectionCache[name] = done
        secretDetectionAt[name] = now
        return done
    end
    local function observeSecretCompletion(message)
        local txt = tostring(message or ""):lower()
        if txt == "" then return end
        local completionContext = txt:find("completed", 1, true) or txt:find("complete the secret", 1, true)
            or txt:find("finished", 1, true) or txt:find("brought down", 1, true)
            or txt:find("defeated", 1, true) or txt:find("secret levels", 1, true)
            or txt:find("reward", 1, true) or txt:find("unlocked", 1, true)
        if completionContext then
            for _, q in ipairs(SUNRISE_SECRET_QUESTS) do
                local qn = q.name:lower()
                if txt:find(qn, 1, true) then SUNRISE_SecretQuestMarkDone(q.name) end
            end
        end
        local aliases = {
            ["The Finale"]={"final secret", "secret sequence complete"},
            ["Early Access"]={"tester role"},
            ["Awakened Gorilla King"]={"brought down the awakened gorilla king"},
            ["Awakened Chef"]={"brought down the awakened chef"},
            ["Awakened Yeti"]={"brought down the awakened yeti"},
            ["Awakened Vice Admiral"]={"brought down the awakened vice admiral"},
            ["Awakened Warden"]={"brought down the awakened warden"},
            ["Awakened Magma General"]={"brought down the awakened magma general"},
            ["Awakened Fishman Lord"]={"brought down the awakened fishman lord"},
            ["Awakened Sky Warlord"]={"brought down the awakened sky warlord"},
            ["Awakened Lightning God"]={"brought down the awakened lightning god"},
            ["Awakened Cyborg"]={"brought down the awakened cyborg"},
        }
        for name, phrases in pairs(aliases) do for _, phrase in ipairs(phrases) do if txt:find(phrase, 1, true) then SUNRISE_SecretQuestMarkDone(name) end end end
    end
