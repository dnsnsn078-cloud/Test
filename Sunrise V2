    addTab("Secret Quest", "✦", function(pg)
        hint(pg, "Turn on individual secrets in the order you want them attempted. Selected quests run first, with required prerequisites inserted automatically. If no individual quests are selected, AutoSC runs all remaining secrets using its normal scheduler.")
        toggle(pg, "Auto Secret Quest", "Runs the tested AutoSC secret-progression engine in First Sea", function()
            local env = getgenv and getgenv()
            if env and Config.AutoExec and type(Config.AutoExec.Url) == "string" and Config.AutoExec.Url ~= "" then env.SunriseEmbeddedAutoExecUrl = Config.AutoExec.Url end
            local bridge = env and env.SunriseAutoSCBridge
            if bridge and type(bridge.IsEnabled) == "function" then
                local ok, value = pcall(bridge.IsEnabled)
                if ok then return value == true end
            end
            return Config.SecretQuest.Enabled
        end, function(v)
            local env = getgenv and getgenv()
            local bridge = env and env.SunriseAutoSCBridge
            if v == true and (not bridge or type(bridge.SetEnabled) ~= "function") then
                Config.SecretQuest.Enabled = false
                warn("[Sunrise AutoSC] cannot enable automation: " .. tostring(env and env.SunriseAutoSCInitStatus or "engine bridge is missing"))
                return
            end
            Config.SecretQuest.Enabled = v == true
            if env and Config.AutoExec and type(Config.AutoExec.Url) == "string" and Config.AutoExec.Url ~= "" then env.SunriseEmbeddedAutoExecUrl = Config.AutoExec.Url end
            if bridge and type(bridge.SetEnabled) == "function" then
                local ok, result = pcall(bridge.SetEnabled, v)
                if not ok then
                    warn("[Sunrise AutoSC] toggle bridge failed:", result)
                    Config.SecretQuest.Enabled = false
                elseif result == false then Config.SecretQuest.Enabled = false end
            end
        end)
        local qStatus = info(pg, "Tracker status")
        local function selectedCount()
            local n, done = #SUNRISE_SECRET_QUESTS, 0
            for _, q in ipairs(SUNRISE_SECRET_QUESTS) do
                if SUNRISE_SecretQuestIsDone(q.name) then done = done + 1 end
            end
            return n, done
        end
        updaters[#updaters + 1] = function()
            local env = getgenv and getgenv()
            local bridge = env and env.SunriseAutoSCBridge
            if bridge and type(bridge.GetStatus) == "function" then
                local ok, st = pcall(bridge.GetStatus)
                if ok and type(st) == "table" then
                    if Config.SecretQuest.Enabled ~= (st.enabled == true) then
                        Config.SecretQuest.Enabled = st.enabled == true
                        pcall(function() S.queueSave() end)
                    end
                    local selectionText = (st.manual and ((tonumber(st.selected) or 0) .. " selected in order") or "all remaining secrets")
                    qStatus.Text = string.format("AutoSC %d/40 · %s · %s · %s", tonumber(st.done) or 0,
                        tostring(st.current or "No active secret"), tostring(st.status or st.step or "Ready"), selectionText)
                    return
                end
            end
            local n, done = selectedCount()
            local initStatus = env and env.SunriseAutoSCInitStatus or "AutoSC bridge unavailable"
            qStatus.Text = "AutoSC unavailable · " .. tostring(initStatus) .. " · " .. tostring(done) .. "/" .. tostring(n) .. " detected"
        end
        local function getOrderIndex(name)
            if not (Config.SecretQuest.Selected and Config.SecretQuest.Selected[name]) then return nil end
            for i, selectedName in ipairs(Config.SecretQuest.Order or {}) do
                if selectedName == name then return i end
            end
            return nil
        end
        local function syncAutoSCSelection()
            local selected = Config.SecretQuest.Selected or {}
            local validNames = {}
            for _, quest in ipairs(SUNRISE_SECRET_QUESTS) do validNames[quest.name] = true end
            for name, chosen in pairs(selected) do
                if chosen == true and not validNames[name] then selected[name] = false end
            end
            local savedOrder = Config.SecretQuest.Order or {}
            local order, seen = {}, {}
            for _, name in ipairs(savedOrder) do
                if validNames[name] and selected[name] == true and not seen[name] then
                    order[#order + 1] = name
                    seen[name] = true
                end
            end
            for _, quest in ipairs(SUNRISE_SECRET_QUESTS) do
                if selected[quest.name] == true and not seen[quest.name] then
                    order[#order + 1] = quest.name
                    seen[quest.name] = true
                end
            end
            Config.SecretQuest.Order = order
            local env = getgenv and getgenv()
            local bridge = env and env.SunriseAutoSCBridge
            if bridge and type(bridge.SetSelection) == "function" then
                local ok, count = pcall(bridge.SetSelection, selected, order)
                if not ok then warn("[Sunrise AutoSC] could not sync manual selection:", count) end
            end
        end
        local islands, lastIsland = {}, nil
        for _, q in ipairs(SUNRISE_SECRET_QUESTS) do
            if q.island ~= lastIsland then islands[#islands + 1] = q.island; lastIsland = q.island end
        end
        for _, island in ipairs(islands) do
            section(pg, island)
            for _, q in ipairs(SUNRISE_SECRET_QUESTS) do
                if q.island == island then
                    goalRow(pg, q.name, function() return SUNRISE_SecretQuestIsDone(q.name) end,
                        function() return Config.SecretQuest.Selected[q.name] == true end,
                        function(value)
                            Config.SecretQuest.Selected[q.name] = value == true
                            local order = {}
                            for _, oldName in ipairs(Config.SecretQuest.Order or {}) do
                                if oldName ~= q.name and Config.SecretQuest.Selected[oldName] == true then order[#order + 1] = oldName end
                            end
                            if value == true then order[#order + 1] = q.name end
                            Config.SecretQuest.Order = order
                            syncAutoSCSelection()
                        end,
                        "Click ON to add to the manual quest order", function() return getOrderIndex(q.name) end)
                end
            end
        end
        -- Apply saved selections immediately, not only after the player clicks a row.
        syncAutoSCSelection()
    end)

