                ok3, result3 = pcall(function() return commF:InvokeServer("Wenlocktoad", "1") end)
            end
            -- Do not apply a stale response if the player changed races while the
            -- server calls were in flight.
            if currentRaceName() == raceName then
                if ok4 then
                    raceProgress.v4 = unlockedV4
                else
                    raceProgress.v4 = nil
                end
                if ok2 and result2 ~= nil then
                    raceProgress.v2 = (result2 == -2) or (raceProgress.v4 == true)
                else
