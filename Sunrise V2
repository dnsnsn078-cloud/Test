        corner(knob, 8)
        local function redraw()
            local on = get() and true or false
            tween(track, {BackgroundColor3 = on and accent or T.off}, 0.1)
            tween(knob, {Position = on and UDim2.fromOffset(20, 2) or UDim2.fromOffset(2, 2)}, 0.1)
        end
        row.Activated:Connect(function()
            local wasOn = get() and true or false
            set(not wasOn)
            local isOn = get() and true or false
            if not wasOn and isOn and requirementName then
                local targetName = type(requirementName) == "function" and requirementName() or requirementName
                if targetName then showGoalRequirement(targetName) end
            end
            if cancelTweenWhenOff and wasOn and not isOn then
                pcall(function()
                    if TweenController and TweenController.Cancel then TweenController.Cancel(false) end
                end)
            end
            redraw()
            queueSave()
        end)
        redraws[#redraws + 1] = redraw; refreshers[#refreshers + 1] = redraw
        redraw()
    end
    local function slider(p, label, min, max, step, get, set, fmt)
        local row = new("Frame", {Size = UDim2.new(1, 0, 0, 46), BackgroundColor3 = T.card, BorderSizePixel = 0, LayoutOrder = nextOrder()}, p)
        corner(row, 8)
        text(row, {Position = UDim2.fromOffset(10, 5), Size = UDim2.new(1, -120, 0, 16), Text = label, TextTruncate = Enum.TextTruncate.AtEnd})
        local val = text(row, {Position = UDim2.new(1, -112, 0, 5), Size = UDim2.fromOffset(102, 16), Font = Enum.Font.GothamBold, TextXAlignment = Enum.TextXAlignment.Right,
            TextTruncate = Enum.TextTruncate.AtEnd})
        bindAccent(val, "TextColor3")
        local track = new("TextButton", {Position = UDim2.new(0, 12, 0, 31), Size = UDim2.new(1, -24, 0, 6), BackgroundColor3 = T.off, Text = "",
            AutoButtonColor = false, BorderSizePixel = 0}, row)
        corner(track, 3)
        local fill = new("Frame", {Size = UDim2.new(0, 0, 1, 0), BorderSizePixel = 0}, track)
        corner(fill, 3); bindAccent(fill, "BackgroundColor3")
        local knob = new("Frame", {AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(0, 0, 0.5, 0), Size = UDim2.fromOffset(14, 14),
            BackgroundColor3 = Color3.new(1, 1, 1), BorderSizePixel = 0}, track)
        corner(knob, 7)
        local function redraw()
            local v = tonumber(get()) or min
            local a = math.clamp((v - min) / (max - min), 0, 1)
            fill.Size = UDim2.new(a, 0, 1, 0); knob.Position = UDim2.new(a, 0, 0.5, 0)
            val.Text = fmt and fmt(v) or tostring(v)
        end
        local function setFromX(x)
            local a = math.clamp((x - track.AbsolutePosition.X) / math.max(track.AbsoluteSize.X, 1), 0, 1)
            local v = math.clamp(math.floor((min + a * (max - min)) / step + 0.5) * step, min, max)
            set(v); redraw()
        end
        track.InputBegan:Connect(function(input)
            local t = input.UserInputType
            if t ~= Enum.UserInputType.Touch and t ~= Enum.UserInputType.MouseButton1 then return end
            p.ScrollingEnabled = false
            setFromX(input.Position.X)
            local mc
            mc = UIS.InputChanged:Connect(function(i)
                if i == input or i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch then setFromX(i.Position.X) end
            end)
            input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then mc:Disconnect(); p.ScrollingEnabled = true; queueSave() end
            end)
        end)
        refreshers[#refreshers + 1] = redraw
        redraw()
    end
