                        island = islandAliases[island] or island
                        list[#list + 1] = {name = quest.Name, island = island}
                    end
                end
            end
            table.sort(list, function(a, b)
                local order = {
                    ["Middle Town"] = 1, ["Jungle"] = 2, ["Pirate Village"] = 3, ["Desert"] = 4,
                    ["Frozen Village"] = 5, ["Marine Fortress"] = 6, ["Lower Skylands"] = 7,
                    ["Prison"] = 8, ["Colosseum"] = 9, ["Magma Village"] = 10,
                    ["Underwater City"] = 11, ["Upper Skylands"] = 12, ["Fountain City"] = 13,
                }
                local ai, bi = order[a.island] or 99, order[b.island] or 99
                if ai ~= bi then return ai < bi end
                if a.island ~= b.island then return a.island < b.island end
                return a.name < b.name
            end)
            if localPlayer:GetAttribute("CompletedMap") == true then
                -- Keep The Finale as a separate final checklist row, independent of island grouping.
            end
            list[#list + 1] = {name = "The Finale", island = "Finale"}
            return list
        end,
        GetStatus = function()
            local progress = getgenv().SunriseAutoSCBridge.GetProgress()
            local done = CountSecretDone(progress)
            local data = localPlayer:FindFirstChild("Data")
            local level = data and data:FindFirstChild("Level")
            if localPlayer:GetAttribute("CompletedMap") == true or (level and tonumber(level.Value) and level.Value >= 3000) then done = 40 end
            return {
                enabled = Settings["Auto Secret Quest"] == true,
                done = done,
                total = 40,
                current = tostring(HiddenEvent.current or (done >= 39 and "The Finale" or "No active secret")),
                step = tostring(HiddenEvent.step or Runtime.Step or "Idle"),
                status = tostring(Runtime.Status or "Ready"),
                progressError = tostring(HiddenEvent.progressLastError or ""),
                progressLastSuccess = tonumber(HiddenEvent.progressLastSuccess) or 0,
                mode = tostring(Runtime.Mode or "IDLE"),
                selected = #(HiddenEvent.manualSelectionOrder or {}),
                manual = #(HiddenEvent.manualSelectionOrder or {}) > 0,
            }
        end,
        IsDone = function(displayName)
            local normalized = sunriseAutoSCNormalize(displayName)
            if normalized == "thefinale" then
                local data = localPlayer:FindFirstChild("Data")
                local level = data and data:FindFirstChild("Level")
                return localPlayer:GetAttribute("CompletedMap") == true or (level and tonumber(level.Value) and level.Value >= 3000) or false
            end

            -- The live server progress can still use an older secret name even when
            -- Sunrise shows the newer, human-readable quest title. Try all known labels.
            local targetName = tostring(displayName or "")
            local targetNames = {targetName}
            for key, labels in pairs(completionNames) do
                if key == normalized then
                    for _, label in ipairs(labels) do targetNames[#targetNames + 1] = label end
                    break
                end
            end
            local targets = {}
            for _, label in ipairs(targetNames) do targets[sunriseAutoSCNormalize(label)] = true end

            local progress = getgenv().SunriseAutoSCBridge.GetProgress()
            local matched, known = false, false

            -- First use AutoSC's own task definition and exact server progress key.
            -- This avoids relying on the visible checklist's wording being identical.
            for _, quest in ipairs(HiddenQuests or {}) do
                if type(quest) == "table" and type(quest.Name) == "string" then
                    local questNorm = sunriseAutoSCNormalize(quest.Name)
                    local mappedQuest = sunriseAutoSCAliases[questNorm] or quest.Name
                    if targets[questNorm] or targets[sunriseAutoSCNormalize(mappedQuest)] then
                        known = true
                        local exactKey = "Sea1/" .. tostring(quest.Island or "") .. "/" .. quest.Name
                        if sunriseAutoSCProgressComplete(progress[exactKey]) then return true end
                    end
                end
            end

            -- Compatibility fallback for older server keys and renamed task labels.
            for key, value in pairs(progress or {}) do
                local leaf = tostring(key):match("([^/]+)$") or tostring(key)
                local leafNorm = sunriseAutoSCNormalize(leaf)
                local mappedName = sunriseAutoSCAliases[leafNorm] or leaf
                if targets[sunriseAutoSCNormalize(mappedName)] or targets[leafNorm] then
                    matched = true
                    if sunriseAutoSCProgressComplete(value) then return true end
                end
            end
            if matched or known then return false end
            return nil
        end,
    }
end

