    local function SunriseRaceValue()
        local data = LocalPlayer and LocalPlayer:FindFirstChild("Data")
        local race = data and data:FindFirstChild("Race")
        return race and tostring(race.Value) or "Unknown"
    end

    local function SunriseRaceGoalCount(itemName)
        local inv = ScriptStorage and ScriptStorage.Backpack
        if type(inv) ~= "table" then return 0 end
        local target = tostring(itemName or ""):lower():gsub("[^%w]", "")
        for name, entry in pairs(inv) do
            local key = tostring(name):lower():gsub("[^%w]", "")
            if key == target then
                if type(entry) == "table" then return tonumber(entry.Count or entry.Quantity or entry.Value) or 0 end
                return tonumber(entry) or 0
            end
        end
        return 0
    end

    local function SunriseRaceFindTool(namePart)
        local query = tostring(namePart or ""):lower()
        local backpack = LocalPlayer and (LocalPlayer:FindFirstChildOfClass("Backpack") or LocalPlayer:FindFirstChild("Backpack"))
        local containers = {backpack, LocalPlayer and LocalPlayer.Character}
        for _, container in ipairs(containers) do
            if container then
                for _, obj in ipairs(container:GetChildren()) do
                    if obj:IsA("Tool") and string.find(string.lower(obj.Name), query, 1, true) then return obj end
                end
            end
        end
        return nil
    end

