    Config.SecretQuest = Config.SecretQuest or {Enabled=false, Selected={}, Completed={}}
    Config.SecretQuest.Selected = Config.SecretQuest.Selected or {}
    Config.SecretQuest.Completed = Config.SecretQuest.Completed or {}
    Config.SecretQuest.Order = Config.SecretQuest.Order or {}
    do
        local aliases = SUNRISE_SECRET_QUEST_ALIASES or {}
        local selected, completed = Config.SecretQuest.Selected, Config.SecretQuest.Completed
        for oldName, newName in pairs(aliases) do
            if selected[oldName] == true then selected[newName] = true end
            if completed[oldName] == true then completed[newName] = true end
        end
        local validNames = {}
        for _, quest in ipairs(SUNRISE_SECRET_QUESTS or {}) do validNames[quest.name] = true end
        local migratedOrder, seenOrder = {}, {}
        for _, oldName in ipairs(Config.SecretQuest.Order) do
            local newName = aliases[oldName] or oldName
            if type(newName) == "string" and validNames[newName] and not seenOrder[newName] then
                migratedOrder[#migratedOrder + 1] = newName
                seenOrder[newName] = true
            end
        end
        Config.SecretQuest.Order = migratedOrder
        for oldName in pairs(aliases) do
            selected[oldName] = nil
            completed[oldName] = nil
        end
        for oldName, wasSelected in pairs(selected) do
            if wasSelected == true and not validNames[oldName] then selected[oldName] = false end
        end
        for oldName in pairs(completed) do
            if not validNames[oldName] then completed[oldName] = nil end
        end
    end
    for _, q in ipairs(SUNRISE_SECRET_QUESTS or {}) do
        if Config.SecretQuest.Selected[q.name] == nil then Config.SecretQuest.Selected[q.name] = false end
        if Config.SecretQuest.Completed[q.name] == nil then Config.SecretQuest.Completed[q.name] = false end
    end
    local secretRuntime = {}
    pcall(function()
        local env = getgenv and getgenv()
        if env then
            env.SunriseSecretQuestRuntimeCompleted = env.SunriseSecretQuestRuntimeCompleted or {}
            secretRuntime = env.SunriseSecretQuestRuntimeCompleted
        end
    end)
    S.SecretQuestRuntimeCompleted = secretRuntime
    local function secretNormalize(v) return tostring(v or ""):lower():gsub("[^%w]", "") end
    local secretDetectionCache, secretDetectionAt = {}, {}

    -- One shared progress snapshot for the checklist. Prefer the embedded AutoSC
    -- bridge, but fall back to the same replication remote used by the original
    -- standalone AutoSC when the bridge is missing or returns no usable map.
    -- These two functions are intentionally exported at script scope: the UI and
    -- the post-initialization sync loop are declared after this enclosing `do` block.
    local function sunriseProgressValueIsComplete(value)
        return value == true or (type(value) == "table" and value.Completed == true)
    end

    -- Build name lookups once. Every row can then check its status in O(1) time
    -- instead of repeatedly normalizing and searching the full progress table.
    local sunriseSecretQuestNameByNormalized = {}
    for _, quest in ipairs(SUNRISE_SECRET_QUESTS or {}) do
        sunriseSecretQuestNameByNormalized[secretNormalize(quest.name)] = quest.name
    end
    local sunriseSecretAliasByNormalized = {}
    for oldName, newName in pairs(SUNRISE_SECRET_QUEST_ALIASES or {}) do
        local oldKey = secretNormalize(oldName)
        local newKey = secretNormalize(newName)
        sunriseSecretAliasByNormalized[oldKey] = newName
        if sunriseSecretQuestNameByNormalized[newKey] then
            sunriseSecretQuestNameByNormalized[oldKey] = newName
        end
    end

    local sunriseSecretProgressByName = {}
    local sunriseSecretProgressKnownByName = {}
    local sunriseSecretProgressSnapshot = {}
    local sunriseSecretProgressCheckedAt = 0
    local sunriseSecretProgressLastError = nil
    local sunriseSecretProgressLastSuccess = 0
    local sunriseSecretProgressLastAttemptAt = 0
    local sunriseSecretProgressScannedSea = nil
    local sunriseSecretFallbackCache = {ready = false, checkedAt = 0, byName = {}, byIsland = {}, allStars = false, levelCapDone = false}
    local sunriseLevelCapCache = {checkedAt = -100, reached = false}
    local sunriseFinaleCheckAt = 0
    local sunriseSecretCompletionSavePending = false

    function SunriseCanonicalSecretProgressName(rawName)
        local normalized = secretNormalize(rawName)
        return sunriseSecretAliasByNormalized[normalized]
            or sunriseSecretQuestNameByNormalized[normalized]
            or tostring(rawName or "")
    end

    local function sunriseProgressHasSea1Keys(progress)
        if type(progress) ~= "table" then return false end
        for key in pairs(progress) do
            if tostring(key):sub(1, 5) == "Sea1/" then return true end
        end
        return false
    end

    local function sunriseIndexSecretProgress(progress)
        local completedByName, knownByName = {}, {}
        for key, value in pairs(progress or {}) do
            local keyText = tostring(key)
            if keyText:sub(1, 5) == "Sea1/" then
                local leaf = keyText:match("([^/]+)$") or keyText
                local normalizedLeaf = secretNormalize(leaf)
                local canonical = SunriseCanonicalSecretProgressName(leaf)
                local normalizedCanonical = secretNormalize(canonical)
                knownByName[normalizedLeaf] = true
                knownByName[normalizedCanonical] = true
                if sunriseProgressValueIsComplete(value) then
                    completedByName[normalizedLeaf] = true
                    completedByName[normalizedCanonical] = true
                end
            end
        end
        -- If AutoSC exposes a legacy task name, make that state available through
        -- both the old and current checklist labels.
        for aliasKey, canonicalName in pairs(sunriseSecretAliasByNormalized) do
            local canonicalKey = secretNormalize(canonicalName)
            if knownByName[canonicalKey] then knownByName[aliasKey] = true end
            if completedByName[canonicalKey] then completedByName[aliasKey] = true end
        end
        return completedByName, knownByName
    end

    local function sunriseLevelCapReached()
        local now = os.clock()
        if now - sunriseLevelCapCache.checkedAt < 20 then return sunriseLevelCapCache.reached end
        sunriseLevelCapCache.checkedAt = now
        local reached = false
        pcall(function()
            local player = game:GetService("Players").LocalPlayer
            local data = player and player:FindFirstChild("Data")
            if data then
                for _, key in ipairs({"LevelCap", "MaxLevel", "LevelLimit"}) do
                    local value = data:FindFirstChild(key)
                    if value and tonumber(value.Value) and tonumber(value.Value) >= 3000 then
                        reached = true
                        break
                    end
                end
            end
        end)
        sunriseLevelCapCache.reached = reached
        return reached
    end

    local function sunriseRefreshSecretFallbackCache(force)
        local now = os.clock()
        if not force and sunriseSecretFallbackCache.checkedAt > 0
            and now - sunriseSecretFallbackCache.checkedAt < 30 then
            return sunriseSecretFallbackCache
        end

        local cache = {ready = false, checkedAt = now, byName = {}, byIsland = {}, allStars = false, levelCapDone = sunriseLevelCapReached(), error = nil}
        local player = game:GetService("Players").LocalPlayer
        if not player then
            cache.error = "LocalPlayer is not available"
            sunriseSecretFallbackCache = cache
            return cache
        end
        -- This fallback is deliberately a single shared scan. It used to run once
        -- per quest row, producing dozens of full-tree scans every few seconds.
        local playerScanOk, playerScanError = pcall(function()
            for _, obj in ipairs(player:GetDescendants()) do
                local normalized = secretNormalize(obj.Name)
                local questName = sunriseSecretQuestNameByNormalized[normalized]
                if questName then
                    local done = false
                    if obj:IsA("BoolValue") then
                        done = obj.Value == true
                    elseif obj:IsA("StringValue") then
                        done = tostring(obj.Value):lower():find("complete", 1, true) ~= nil
                    elseif obj:IsA("IntValue") or obj:IsA("NumberValue") then
                        done = tonumber(obj.Value) ~= nil and obj.Value > 0
                    end
                    if done then cache.byName[secretNormalize(questName)] = true end
                end
            end
        end)

        local islandKeys = {}
        for _, quest in ipairs(SUNRISE_SECRET_QUESTS or {}) do
            if quest.island then islandKeys[secretNormalize(quest.island)] = true end
        end
        local pg = player and player:FindFirstChildOfClass("PlayerGui")
        local guiScanOk, guiScanError = true, nil
        if pg then
            guiScanOk, guiScanError = pcall(function()
                for _, obj in ipairs(pg:GetDescendants()) do
                    if obj:IsA("TextLabel") or obj:IsA("TextButton") or obj:IsA("TextBox") then
                        local txt = tostring(obj.Text or ""):lower()
                        local normText = secretNormalize(txt)
                        if txt:find("40/40", 1, true) or txt:find("39/39", 1, true)
                            or txt:find("39 stars", 1, true) or txt:find("200 secret levels", 1, true)
                            or txt:find("level cap: 3000", 1, true) then
                            cache.allStars = true
                        end
                        if txt:find("3/3", 1, true) or txt:find("3 stars", 1, true) or txt:find("★★★", 1, true) then
                            local chain = normText
                            local parent = obj.Parent
                            for _ = 1, 4 do
                                if not parent then break end
                                chain = chain .. secretNormalize(parent.Name)
                                parent = parent.Parent
                            end
                            for islandKey in pairs(islandKeys) do
                                if chain:find(islandKey, 1, true) then cache.byIsland[islandKey] = true end
                            end
                        end
                    end
                end
            end)
        end

        cache.ready = playerScanOk and guiScanOk
        if not cache.ready then
            cache.error = tostring(playerScanError or guiScanError or "Fallback scan failed")
        end
        if cache.ready and (cache.allStars or cache.levelCapDone) then
            for _, quest in ipairs(SUNRISE_SECRET_QUESTS or {}) do
                if cache.levelCapDone or quest.name ~= "The Finale" then
                    cache.byName[secretNormalize(quest.name)] = true
                end
            end
        end
        if cache.ready then
            for islandKey in pairs(cache.byIsland) do
                for _, quest in ipairs(SUNRISE_SECRET_QUESTS or {}) do
                if quest.island and secretNormalize(quest.island) == islandKey and quest.name ~= "The Finale" then
                    cache.byName[secretNormalize(quest.name)] = true
                end
                end
            end
        end
        sunriseSecretFallbackCache = cache

        -- Apply every fallback completion in one batch, rather than scheduling a
        -- settings save separately for each completed row. Failed scans are never authoritative.
        local changed = false
        if cache.ready then
        for _, quest in ipairs(SUNRISE_SECRET_QUESTS or {}) do
            if cache.byName[secretNormalize(quest.name)] and not (Config.SecretQuest.Completed and Config.SecretQuest.Completed[quest.name] == true) then
                if SUNRISE_SecretQuestMarkDone then
                    changed = SUNRISE_SecretQuestMarkDone(quest.name, true) or changed
                end
            end
        end
        if changed or sunriseSecretCompletionSavePending then
            pcall(function() S.queueSave() end)
            sunriseSecretCompletionSavePending = false
        end
        end
        return sunriseSecretFallbackCache
    end

    local function sunriseSecretProgressSea()
        local id = game.PlaceId
        if id == 2753915549 or id == 85211729168715 then return 1 end
        if id == 4442272183 or id == 79091703265657 then return 2 end
        if id == 7449423635 or id == 7449925015 or id == 100117331123089 then return 3 end
        return 0
    end

    function SunriseGetSecretProgressError()
        return sunriseSecretProgressLastError
    end

    function SunriseReadSecretProgress(force)
        local now = os.clock()
        local sea = sunriseSecretProgressSea()
        -- Once a successful scan has been obtained in Sea 2/3, reuse it for the
        -- session: those seas do not expose the Sea 1 secret quest set.
        if sea ~= 1 and sea ~= 0 and sunriseSecretProgressScannedSea == sea
            and sunriseSecretProgressLastSuccess > 0 then
            return sunriseSecretProgressSnapshot, sunriseSecretProgressLastError
        end
        -- Failed reads remain visible and are retried on a bounded interval rather
        -- than turning a transient endpoint failure into a definitive incomplete state.
        if sunriseSecretProgressLastError and now - (sunriseSecretProgressLastAttemptAt or 0) < 15 then
            return sunriseSecretProgressSnapshot, sunriseSecretProgressLastError
        end
        if not force and now - sunriseSecretProgressCheckedAt < 8 then
            return sunriseSecretProgressSnapshot, sunriseSecretProgressLastError
        end
        sunriseSecretProgressCheckedAt = now
        sunriseSecretProgressLastAttemptAt = now

        local env = type(getgenv) == "function" and getgenv() or _G
        local bridge = env and env.SunriseAutoSCBridge
        local progress, readError, okSnapshot
        if bridge and type(bridge.GetProgress) == "function" then
            -- Reuse AutoSC's own cached snapshot during normal UI reads. Only a
            -- manual refresh should force another server request.
            local ok, value = pcall(bridge.GetProgress, force == true)
            if ok and type(value) == "table" and sunriseProgressHasSea1Keys(value) then
                progress, okSnapshot = value, true
                if type(bridge.GetStatus) == "function" then
                    local statusOk, status = pcall(bridge.GetStatus)
                    if statusOk and type(status) == "table" and tostring(status.progressError or "") ~= "" then
                        okSnapshot = false
                        readError = tostring(status.progressError)
                    end
                end
            elseif not ok then
                readError = tostring(value)
            end
        end

        -- Fall back to the original AutoSC endpoint only when its shared bridge
        -- cannot provide a usable map. Manual refresh bypasses the cache.
        if not okSnapshot then
            local remoteOk, result = pcall(function()
                local net = game:GetService("ReplicatedStorage").Modules.Net
                return net["RF/RequestBonusMomentReplication"]:InvokeServer({Type = "GetMomentProgress"})
            end)
            if remoteOk and type(result) == "table" and type(result.Data) == "table" then
                progress = {}
                for key, value in pairs(result.Data) do
                    if tostring(key):sub(1, 5) == "Sea1/" then
                        progress[key] = sunriseProgressValueIsComplete(value)
                    end
                end
                if sunriseProgressHasSea1Keys(progress) then
                    okSnapshot = true
                    readError = nil
                else
                    okSnapshot = false
                    readError = "The server returned progress data without Sea1 task keys"
                end
            else
                readError = remoteOk and "The server returned no progress data" or tostring(result)
            end
        end

        if okSnapshot and type(progress) == "table" then
            local merged = {}
            for key, value in pairs(progress) do
                if tostring(key):sub(1, 5) == "Sea1/" then
                    merged[key] = sunriseProgressValueIsComplete(value)
                end
            end
            -- A partial response must not erase a completion already confirmed once.
            for key, value in pairs(sunriseSecretProgressSnapshot) do
                if value == true then merged[key] = true end
            end
            local foundNewCompletion = false
            for key, value in pairs(merged) do
                if value == true and sunriseSecretProgressSnapshot[key] ~= true then foundNewCompletion = true; break end
            end
            sunriseSecretProgressSnapshot = merged
            sunriseSecretProgressByName, sunriseSecretProgressKnownByName = sunriseIndexSecretProgress(merged)
            sunriseSecretProgressLastError = nil
            sunriseSecretProgressLastSuccess = os.clock()
            sunriseSecretProgressScannedSea = sea
            if foundNewCompletion then SunriseSecretProgressRevision = (SunriseSecretProgressRevision or 0) + 1 end
            if env then env.SunriseSecretQuestProgressSnapshot = merged end
            if bridge and type(bridge.SetProgressSnapshot) == "function" then
                pcall(bridge.SetProgressSnapshot, merged)
            end
        else
            sunriseSecretProgressLastError = readError or "Could not read secret quest progress"
        end
        return sunriseSecretProgressSnapshot, sunriseSecretProgressLastError
    end

    function SUNRISE_SecretQuestMarkDone(name, deferSave)
        if not name or name == "" then return false end
        Config.SecretQuest.Completed = Config.SecretQuest.Completed or {}
        local changed = Config.SecretQuest.Completed[name] ~= true
        Config.SecretQuest.Completed[name] = true
        S.SecretQuestRuntimeCompleted[name] = true
        secretDetectionCache[name] = true
        secretDetectionAt[name] = os.clock()
        if changed then
            SunriseSecretProgressRevision = (SunriseSecretProgressRevision or 0) + 1
            if deferSave then
                sunriseSecretCompletionSavePending = true
            else
                sunriseSecretCompletionSavePending = false
                pcall(function() S.queueSave() end)
                -- Chat/log-confirmed regular completions should request one fresh Sea 1 scan.
                if name ~= "The Finale" and sunriseSecretProgressSea() == 1 then
                    sunriseSecretProgressCheckedAt = 0
                    sunriseSecretFallbackCache.ready = false
                    sunriseSecretFallbackCache.checkedAt = 0
                    local env = type(getgenv) == "function" and getgenv() or _G
                    local bridge = env and env.SunriseAutoSCBridge
                    if bridge and type(bridge.InvalidateProgress) == "function" then pcall(bridge.InvalidateProgress) end
                end
            end
        end
        return changed
    end

    function SUNRISE_SecretQuestIsDone(name)
        if not name or name == "" then return false end
        local target = secretNormalize(name)
        local now = os.clock()

        -- The Finale has one inexpensive direct completion check.
        if target == "thefinale" then
            local finalDone = false
            pcall(function()
                local player = game:GetService("Players").LocalPlayer
                local data = player and player:FindFirstChild("Data")
                local level = data and data:FindFirstChild("Level")
                finalDone = (player and player:GetAttribute("CompletedMap") == true)
                    or (level and tonumber(level.Value) and tonumber(level.Value) >= 3000) or false
            end)
            if finalDone then return SUNRISE_SecretQuestMarkDone(name) or true end
        end

        if Config.SecretQuest and Config.SecretQuest.Completed and Config.SecretQuest.Completed[name] == true then return true end
        if S.SecretQuestRuntimeCompleted and S.SecretQuestRuntimeCompleted[name] == true then return true end

        SunriseReadSecretProgress(false)
        if sunriseSecretProgressByName[target] then
            SUNRISE_SecretQuestMarkDone(name, true)
            return true
        end
        if sunriseSecretFallbackCache.ready and sunriseSecretFallbackCache.byName[target] then
            SUNRISE_SecretQuestMarkDone(name, true)
            return true
        end

        -- A level-cap signal is tiny to read and is checked at most every 20s.
        -- It replaces the old per-row full Data/descendant scan for every quest.
        if sunriseLevelCapReached() then
            local changed = false
            for _, quest in ipairs(SUNRISE_SECRET_QUESTS or {}) do
                changed = SUNRISE_SecretQuestMarkDone(quest.name, true) or changed
            end
            if changed or sunriseSecretCompletionSavePending then
                pcall(function() S.queueSave() end)
                sunriseSecretCompletionSavePending = false
            end
            return Config.SecretQuest.Completed[name] == true
        end

        -- Explicit false entries are authoritative for this progress snapshot.
        -- Do not walk Player/PlayerGui descendants for every known unfinished quest.
        if sunriseSecretProgressKnownByName[target] and not sunriseSecretProgressLastError then
            secretDetectionCache[name] = false
            secretDetectionAt[name] = now
            return false
        end

        -- Unknown/legacy names get a single cached fallback check, not one full scan
        -- per row. The bridge check itself is also throttled by the negative cache.
        -- The same unavailable quest can be queried dozens of times by separate UI
        -- rows and automation checks; retry only after the shared fallback cache ages.
        if secretDetectionCache[name] == false and now - (secretDetectionAt[name] or 0) < 30 then return false end
        local env = type(getgenv) == "function" and getgenv() or _G
        local bridge = env and env.SunriseAutoSCBridge
        if bridge and type(bridge.IsDone) == "function" then
            local bridgeOk, actualDone = pcall(bridge.IsDone, name)
            if bridgeOk and actualDone == true then
                SUNRISE_SecretQuestMarkDone(name, true)
                return true
            end
        end
        local fallback = sunriseRefreshSecretFallbackCache(false)
        if fallback.ready and fallback.byName[target] then
            SUNRISE_SecretQuestMarkDone(name, true)
            return true
        end
        if sunriseSecretProgressLastError or not fallback.ready then
            -- No false result is cached after an unsuccessful read/scan; the next
            -- eligible retry can resolve it without waiting for the negative-cache TTL.
            return false
        end
        secretDetectionCache[name] = false
        secretDetectionAt[name] = now
        return false
    end

    -- A single scheduled sync resolves all positive progress entries together and
    -- writes settings once per batch. It never calls IsDone 39 times per cycle.
    function SunriseSyncSecretProgressCompletions()
        SunriseReadSecretProgress(false)
        local changed = false
        for _, quest in ipairs(SUNRISE_SECRET_QUESTS or {}) do
            if quest.name ~= "The Finale" and sunriseSecretProgressByName[secretNormalize(quest.name)] then
                changed = SUNRISE_SecretQuestMarkDone(quest.name, true) or changed
            end
        end

        local now = os.clock()
        if now - sunriseFinaleCheckAt >= 15 then
            sunriseFinaleCheckAt = now
            local finalDone = false
            pcall(function()
                local player = game:GetService("Players").LocalPlayer
                local data = player and player:FindFirstChild("Data")
                local level = data and data:FindFirstChild("Level")
                finalDone = (player and player:GetAttribute("CompletedMap") == true)
                    or (level and tonumber(level.Value) and tonumber(level.Value) >= 3000) or false
            end)
            if not finalDone then
                local env = type(getgenv) == "function" and getgenv() or _G
                local bridge = env and env.SunriseAutoSCBridge
                if bridge and type(bridge.IsDone) == "function" then
                    local ok, result = pcall(bridge.IsDone, "The Finale")
                    finalDone = ok and result == true
                end
            end
            if finalDone then changed = SUNRISE_SecretQuestMarkDone("The Finale", true) or changed end
        end
        if changed or sunriseSecretCompletionSavePending then
            pcall(function() S.queueSave() end)
            sunriseSecretCompletionSavePending = false
        end
        return changed
    end

    function SunriseHandleSecretProgressChanged()
        sunriseSecretProgressCheckedAt = 0
        sunriseSecretFallbackCache.ready = false
        sunriseSecretFallbackCache.checkedAt = 0
        for name in pairs(secretDetectionCache) do
            secretDetectionCache[name] = nil
            secretDetectionAt[name] = nil
        end
        task.defer(function()
            pcall(SunriseReadSecretProgress, false)
            pcall(SunriseSyncSecretProgressCompletions)
        end)
    end
    pcall(function()
        local env = type(getgenv) == "function" and getgenv() or _G
        if env then env.SunriseOnSecretProgressChanged = SunriseHandleSecretProgressChanged end
    end)

