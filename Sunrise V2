    function S.storeOnce(tool)
        local char = lp.Character
        local hum = char and char:FindFirstChildOfClass("Humanoid")
        if not hum or not tool or not tool.Parent then return false end
        if tool.Parent ~= char then hum:EquipTool(tool); task.wait(0.12) end
        local held = char:FindFirstChild(tool.Name)
        if not held then return false end
        local storedKey = S.fruitKey(held)
        pcall(function() commf():InvokeServer("StoreFruit", storedKey, held) end)
        task.wait(0.2)
        local stored = not held.Parent
        -- Only a confirmed StoreFruit success invalidates the raid's cached lowest fruit.
        -- LoadFruit/unstore events intentionally do not reset this cursor.
        if stored and type(S.OnFruitStored) == "function" then
            pcall(S.OnFruitStored, storedKey, held)
        end
        return stored
    end

