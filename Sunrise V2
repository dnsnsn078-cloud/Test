    -- STATUS: live client-observed signals only; do not fabricate a moon countdown
    -- or claim a dealer/event is available when its server object is not replicated.
    addTab("Status", "📊", function(pg)
        hint(pg, "Live observations from this server. 'Not detected' means the object is not currently replicated to this client.")
        section(pg, "Progress / time")
        local seaInfo = info(pg, "Current Sea")
        local islandInfo = info(pg, "Special islands")
        local eventInfo = info(pg, "Sea event target")
        local moonInfo = info(pg, "Moon texture")
        local moonEtaInfo = info(pg, "Time to full moon")
        section(pg, "World objects")
        local leviathanInfo = info(pg, "Leviathan")
        local fruitInfo = info(pg, "Dropped fruits")
        local auraVendorInfo = info(pg, "Aura vendor")
        local swordDealerInfo = info(pg, "Legendary Sword Dealer")
        hint(pg, "Aura colors use the Barista in current versions; this status row detects the vendor but does not claim color purchases are automated. Full-moon countdown is an estimate learned from observed moon-stage changes, not a guaranteed server timer.")
        local lastStatusScan, scanCache = 0, {Leviathan = false, Fruit = {}, Barista = false, Dealer = false}
        -- Learn the local server's moon-stage cadence instead of inventing a fixed
        -- timer. A countdown appears only after at least one observed stage change.
        local lastObservedMoonStage, lastObservedMoonChangeAt = nil, nil
        local moonStageDurationSamples, moonStageDurationEstimate = {}, nil
        local function compactName(v)
            return string.lower(tostring(v or "")):gsub("[^%w]", "")
        end
        local function updateWorldSignals()
            local now = os.clock()
            if now - lastStatusScan < 8 then return scanCache end
            lastStatusScan = now
            local found = {Leviathan = false, Fruit = {}, Barista = false, Dealer = false}
            -- One workspace traversal per 8 seconds; scanning nested roots separately was redundant.
            for _, obj in ipairs(workspace:GetDescendants()) do
                local n = compactName(obj.Name)
                if (obj:IsA("Model") or obj:IsA("Tool")) and string.find(n, "leviathan", 1, true) then found.Leviathan = true end
                if obj:IsA("Model") or obj:IsA("Tool") then
                    if n == "barista" then found.Barista = true end
                    if n == "legendarysworddealer" then found.Dealer = true end
                    if string.find(n, "fruit", 1, true) and #found.Fruit < 5 then
                        local parent = obj.Parent
                        local player = game:GetService("Players").LocalPlayer
                        local inPlayerInventory = player and ((player.Backpack and obj:IsDescendantOf(player.Backpack))
                            or (player.Character and obj:IsDescendantOf(player.Character)))
                        -- Exclude held/owned tools; only report fruit-like objects in world containers.
                        if not inPlayerInventory and (parent == workspace
                            or string.find(compactName(parent and parent.Name), "fruit", 1, true)) then
                            table.insert(found.Fruit, tostring(obj.Name))
                        end
                    end
                end
            end
            scanCache = found
            return found
        end
        updaters[#updaters + 1] = function()
            seaInfo.Text = (SeaIndex and ("Sea " .. tostring(SeaIndex))) or "Unknown"
            local state = _G.SunriseSeaEventStatus or {}
            islandInfo.Text = string.format("Mirage %s / Prehistoric %s / Kitsune %s", tostring(state.Mirage or "unknown"), tostring(state.Prehistoric or "unknown"), tostring(state.Kitsune or "unknown"))
            eventInfo.Text = tostring(state.Target or "none")
            local ok, moonTexture = pcall(function()
                local lighting = game:GetService("Lighting")
                local sky = lighting:FindFirstChild("FantasySky") or lighting:FindFirstChildOfClass("Sky")
                return sky and tostring(sky.MoonTextureId) or "unavailable"
            end)
            local moonStages = {
                ["9709135895"] = 0, ["9709139597"] = 1, ["9709143733"] = 2,
                ["9709149052"] = 3, ["9709149431"] = 4, ["9709149680"] = 5,
                ["9709150086"] = 6, ["9709150401"] = 7,
            }
            local textureId = (ok and tostring(moonTexture)) or "unavailable"
            local textureDigits = textureId:match("(%d+)%D*$") or textureId:match("id=(%d+)") or ""
            local moonStage = moonStages[textureDigits]
            local nowForMoon = os.clock()
            if moonStage ~= nil then
                if lastObservedMoonStage ~= nil and lastObservedMoonChangeAt and moonStage ~= lastObservedMoonStage then
                    local elapsed = nowForMoon - lastObservedMoonChangeAt
                    local stepDelta = (moonStage - lastObservedMoonStage) % 8
                    if stepDelta > 0 and elapsed >= 30 and elapsed <= 7200 then
                        moonStageDurationSamples[#moonStageDurationSamples + 1] = elapsed / stepDelta
                        while #moonStageDurationSamples > 5 do table.remove(moonStageDurationSamples, 1) end
                        local total = 0
                        for _, sample in ipairs(moonStageDurationSamples) do total = total + sample end
                        moonStageDurationEstimate = total / #moonStageDurationSamples
                    end
                end
                if moonStage ~= lastObservedMoonStage then
                    lastObservedMoonStage, lastObservedMoonChangeAt = moonStage, nowForMoon
                end
            end
            if moonStage == nil then
                moonInfo.Text = "Moon stage unavailable"
                moonEtaInfo.Text = "ETA unavailable until a known moon texture is replicated"
            elseif moonStage == 4 then
                moonInfo.Text = "FULL MOON (4/8)"
                moonEtaInfo.Text = "Full moon is active now"
            else
                moonInfo.Text = "Moon stage " .. tostring(moonStage) .. "/8"
                local nextFullMoonStep = (4 - moonStage) % 8
                if moonStageDurationEstimate and lastObservedMoonChangeAt then
                    local eta = math.max(0, nextFullMoonStep * moonStageDurationEstimate - (nowForMoon - lastObservedMoonChangeAt))
                    local hours = math.floor(eta / 3600)
                    local minutes = math.floor((eta % 3600) / 60)
                    local seconds = math.floor(eta % 60)
                    moonEtaInfo.Text = string.format("~%02d:%02d:%02d (session estimate; may change)", hours, minutes, seconds)
                else
                    moonEtaInfo.Text = tostring(nextFullMoonStep) .. " moon stage(s) away; learning local cycle for an ETA"
                end
            end
            local snapshot = updateWorldSignals()
            leviathanInfo.Text = snapshot.Leviathan and "Detected in replicated world" or "Not detected"
            fruitInfo.Text = #snapshot.Fruit > 0 and table.concat(snapshot.Fruit, ", ") or "None detected"
            auraVendorInfo.Text = snapshot.Barista and "Barista replicated" or "Not detected"
            swordDealerInfo.Text = snapshot.Dealer and "Dealer replicated" or "Not detected"
        end
    end)

