    -- PART 3: item requirement preview. Show confirmed hard gates separately from route notes
    -- so a boss level, event step, or quest item is not accidentally presented as player level.
    -- A single reusable overlay is used for both pickers and prerequisite popups so
    -- the UI does not create a separate ScreenGui or a polling loop per item.
    local function sunriseNormalizeLabel(value)
        return tostring(value or ""):lower():gsub("[^%w]", "")
    end
    local function sunriseFindRequirement(itemName)
        local r = SUNRISE_ITEM_REQUIREMENTS and SUNRISE_ITEM_REQUIREMENTS[itemName]
        if r then return r end
        local wanted = sunriseNormalizeLabel(itemName)
        for key, candidate in pairs(SUNRISE_ITEM_REQUIREMENTS or {}) do
            if sunriseNormalizeLabel(key) == wanted then return candidate end
        end
        return nil
    end
    local function sunriseReadCurrency(name)
        local data = lp and lp:FindFirstChild("Data")
        local value = data and data:FindFirstChild(name)
        if value then return tonumber(value.Value) or 0 end
        return tonumber(ScriptStorage and ScriptStorage.PlayerData and ScriptStorage.PlayerData[name]) or 0
    end
    local function sunriseReadStat(name)
        local data = lp and lp:FindFirstChild("Data")
        local stats = data and data:FindFirstChild("Stats")
        local slot = stats and stats:FindFirstChild(name)
        if not slot and name == "Demon Fruit" then slot = stats and (stats:FindFirstChild("Blox Fruit") or stats:FindFirstChild("BloxFruit")) end
        if slot then
            if slot:IsA("IntValue") or slot:IsA("NumberValue") then return tonumber(slot.Value) or 0 end
            for _, childName in ipairs({"Level", "Points", "Value"}) do
                local child = slot:FindFirstChild(childName)
                if child and (child:IsA("IntValue") or child:IsA("NumberValue")) then return tonumber(child.Value) or 0 end
            end
        end
        return nil
    end
    -- Only open the requirement panel when a tracked minimum requirement is missing.
    -- Challenge items and puzzle steps are shown separately and do not stop a goal from
    -- starting if its minimum requirements are already met.
    local function sunriseRequirementNeedsPreview(itemName)
        local req = sunriseFindRequirement(itemName)
        if not req then return true end
        -- Owning the target means its minimum purchase/acquisition gates are already
        -- cleared. Do not interrupt another enabled automation with a stale Beli/level
        -- warning; the manual REQ button can still open the full reference on demand.
        local category = tostring(req.category or "")
        if category == "Sword" or category == "Gun" or category == "Accessory" then
            local ownedOk, owned = pcall(function() return CheckItem(req.name or itemName) end)
            if ownedOk and owned == true then return false end
        elseif req.name == "Auto Ghoul" and currentRaceName() == "Ghoul" then
            return false
        elseif req.name == "Auto Draco" and currentRaceName() == "Draco" then
            return false
        elseif req.name == "Auto Race V2" or req.name == "Auto Race V3" then
            pcall(function() refreshRaceProgress(false) end)
            if req.name == "Auto Race V2" and raceProgress.v2 == true then return false end
            if req.name == "Auto Race V3" and raceProgress.v3 == true then return false end
        end
        local status = tostring(req.status or "available")
        if status ~= "available" then return true end
        if Config.Mode == "FruitFinder" or Config.Mode == "BoneCastle" or _G.Stop then return true end

        local currentSea = tonumber(SeaIndex) or curSea()
        local currentLevel = sunriseReadCurrency("Level")
        local currentBeli = sunriseReadCurrency("Beli")
        local currentFragments = sunriseReadCurrency("Fragments")
        local requiredSea = tonumber(req.minSea) or 1
        local requiredLevel = tonumber(req.minLevel) or 0
        local requiredBeli = tonumber(req.beli) or 0
        local playerRaceName = "Unknown"
        pcall(function()
            local player = game:GetService("Players").LocalPlayer
            local data = player and player:FindFirstChild("Data")
            local race = data and data:FindFirstChild("Race")
            if race and race.Value ~= nil then playerRaceName = tostring(race.Value) end
        end)
        if req.name == "Auto Race V2" and playerRaceName == "Draco" then
            requiredSea, requiredLevel, requiredBeli = 3, 2000, 1000000
        end
        if requiredSea > currentSea or requiredLevel > currentLevel or requiredBeli > currentBeli
            or (tonumber(req.fragments) or 0) > currentFragments then
            return true
        end
        for _, statReq in ipairs(req.statRequirements or {}) do
            local current = sunriseReadStat(statReq.name)
            if current == nil or current < (tonumber(statReq.level) or 0) then return true end
        end
        for _, masteryReq in ipairs(req.masteries or {}) do
            local current = tonumber(ScriptStorage and ScriptStorage.Melees and ScriptStorage.Melees[masteryReq.name]) or 0
            if current == 0 and masteryReq.name == "Dragon Breath" then
                current = tonumber(ScriptStorage and ScriptStorage.Melees and ScriptStorage.Melees["Dragon Claw"]) or 0
            end
            if current < (tonumber(masteryReq.level) or 0) then return true end
        end
        for _, neededItem in ipairs(req.items or {}) do
            local left, right = tostring(neededItem):match("^(.-)%s+or%s+(.+)$")
            if left and right then
                if not CheckItem(left) and not CheckItem(right) then return true end
            elseif not CheckItem(neededItem) then
                return true
            end
        end
        return false
    end

    local function showGoalRequirement(itemName, force)
        local req = sunriseFindRequirement(itemName)
        if not req then return false end
        if not force and not sunriseRequirementNeedsPreview(itemName) then return false end
        clearOverlayList()
        ovTitle.Text = "Requirements: " .. tostring(req.name or itemName)
        local order, misses = 0, 0
        local function addLine(message, color, bold)
            order = order + 1
            local lbl = new("TextLabel", {Size = UDim2.new(1, -8, 0, 0), AutomaticSize = Enum.AutomaticSize.Y,
                BackgroundTransparency = 1, Text = tostring(message), TextWrapped = true, RichText = false,
                Font = bold and Enum.Font.GothamBold or Enum.Font.GothamMedium, TextSize = 11,
                TextColor3 = color or T.text, TextXAlignment = Enum.TextXAlignment.Left,
                TextYAlignment = Enum.TextYAlignment.Top, LayoutOrder = order, ZIndex = 82}, ovList)
            return lbl
        end
        local currentSea = tonumber(SeaIndex) or curSea()
        local currentLevel = sunriseReadCurrency("Level")
        local playerRaceName = "Unknown"
        pcall(function()
            local player = game:GetService("Players").LocalPlayer
            local data = player and player:FindFirstChild("Data")
            local race = data and data:FindFirstChild("Race")
            if race and race.Value ~= nil then playerRaceName = tostring(race.Value) end
        end)
        local requiredSea = tonumber(req.minSea) or 1
        local requiredLevel = tonumber(req.minLevel) or 0
        local requiredBeli = tonumber(req.beli) or 0
        if req.name == "Auto Race V2" and playerRaceName == "Draco" then
            requiredSea, requiredLevel, requiredBeli = 3, 2000, 1000000
        end
        if Config.Mode == "FruitFinder" then
            misses = misses + 1
            addLine("Gear goals are unavailable in Fruit Finder mode. Switch to Custom mode to run this goal.", T.warn, true)
        end
        if _G.Stop then
            misses = misses + 1
            addLine("Sunrise is stopped. Restart the script to run this goal.", T.warn, true)
        end
        local currentBeli = sunriseReadCurrency("Beli")
        local currentFragments = sunriseReadCurrency("Fragments")
        local status = tostring(req.status or "available")
        if status == "unavailable" then
            addLine("No standard way for players to obtain this item is confirmed.", T.warn, true)
        elseif status == "trade-only" then
            addLine("Trading is the only confirmed acquisition route for this item.", T.warn, true)
        elseif status == "admin" then
            addLine("This item appears to be reserved for staff and is not available through standard player methods.", T.warn, true)
        elseif status == "seasonal" then
            addLine("This is a seasonal reward. The event may no longer be active.", T.warn, true)
        end
        addLine("Minimum requirements:", T.sub, true)
        if requiredSea > currentSea then
            misses = misses + 1
            addLine("Required sea: " .. tostring(requiredSea) .. ". Current sea: " .. tostring(currentSea) .. ".", T.warn, true)
        elseif requiredSea > 1 then
            addLine("✓ Sea requirement met: Sea " .. tostring(requiredSea) .. ".", T.good)
        end
        if requiredLevel > currentLevel then
            misses = misses + 1
            addLine("Required level: " .. tostring(requiredLevel) .. ". Current level: " .. tostring(currentLevel) .. ".", T.warn, true)
        elseif requiredLevel > 0 then
            addLine("✓ Level requirement met: " .. tostring(requiredLevel) .. "+.", T.good)
        end
        if requiredBeli > currentBeli then
            misses = misses + 1
            addLine("Required Beli: " .. tostring(requiredBeli) .. ". Current Beli: " .. tostring(currentBeli) .. ".", T.warn, true)
        elseif requiredBeli > 0 then
            addLine("✓ Beli requirement met: " .. tostring(requiredBeli) .. ".", T.good)
        end
        if (req.fragments or 0) > currentFragments then
            misses = misses + 1
            addLine("Required Fragments: " .. tostring(req.fragments) .. ". Current Fragments: " .. tostring(currentFragments) .. ".", T.warn, true)
        elseif (req.fragments or 0) > 0 then
            addLine("✓ Fragment requirement met.", T.good)
        end
        for _, statReq in ipairs(req.statRequirements or {}) do
            local current = sunriseReadStat(statReq.name)
            if current == nil then
                misses = misses + 1
                addLine("Required stat: " .. tostring(statReq.name) .. " (" .. tostring(statReq.level) .. " points). Current value is unavailable.", T.warn, true)
            elseif current < (statReq.level or 0) then
                misses = misses + 1
                addLine("Required " .. tostring(statReq.name) .. " stat: " .. tostring(statReq.level) .. " points. Current: " .. tostring(current) .. ".", T.warn, true)
            else
                addLine("✓ Current " .. tostring(statReq.name) .. " stat: " .. tostring(current) .. ".", T.good)
            end
        end
        for _, masteryReq in ipairs(req.masteries or {}) do
            local current = tonumber(ScriptStorage and ScriptStorage.Melees and ScriptStorage.Melees[masteryReq.name]) or 0
            if current == 0 and masteryReq.name == "Dragon Breath" then current = tonumber(ScriptStorage and ScriptStorage.Melees and ScriptStorage.Melees["Dragon Claw"]) or 0 end
            if current < (masteryReq.level or 0) then
                misses = misses + 1
                addLine("Required mastery for " .. tostring(masteryReq.name) .. ": " .. tostring(masteryReq.level) .. ". Current mastery: " .. tostring(current) .. ".", T.warn, true)
            else
                addLine("✓ Mastery met: " .. tostring(masteryReq.name) .. " " .. tostring(current) .. ".", T.good)
            end
        end
        if req.items and #req.items > 0 then addLine("Required items and unlocks:", T.sub, true) end
        for _, neededItem in ipairs(req.items or {}) do
            local alternatives = {}
            for part in string.gmatch(tostring(neededItem), "([^|]+)") do alternatives[#alternatives + 1] = (part:gsub("^%s+", ""):gsub("%s+$", "")) end
            local isOrList = #alternatives == 1 and alternatives[1]:find(" or ", 1, true)
            if isOrList then
                -- Avoid an unreliable parser for arbitrary names: list alternatives as
                -- text unless one of the exact named keys can be checked safely.
                local found = false
                local left, right = alternatives[1]:match("^(.-)%s+or%s+(.+)$")
                if left and right then found = CheckItem(left) or CheckItem(right) end
                if not found then misses = misses + 1; addLine("Required prerequisite: " .. alternatives[1] .. ".", T.warn, true)
                else addLine("✓ Prerequisite met: " .. alternatives[1] .. ".", T.good) end
            elseif CheckItem(neededItem) then
                addLine("✓ Owned: " .. tostring(neededItem) .. ".", T.good)
            else
                misses = misses + 1
                addLine("Required item or quest prerequisite: " .. tostring(neededItem) .. ".", T.warn, true)
            end
        end
        local hasChallengeSteps = (req.challengeItems and #req.challengeItems > 0) or (req.materials and #req.materials > 0)
        if hasChallengeSteps then addLine("Quest and challenge steps:", T.sub, true) end
        for _, challengeItem in ipairs(req.challengeItems or {}) do
            local owned = false
            pcall(function() owned = CheckItem(challengeItem) end)
            addLine("• " .. tostring(challengeItem) .. (owned and " (owned)" or " (not owned)"), owned and T.good or T.text)
        end
        if req.materials and #req.materials > 0 then
            local materials = req.materials
            if req.name == "Auto Race V2" and playerRaceName == "Draco" then
                materials = {"5 Fire Flowers", "Speak with the Dragon Wizard", "Have 1,000,000 Beli ready"}
            end
            for _, material in ipairs(materials) do addLine("• " .. tostring(material), T.text) end
        end
        if req.source and req.source ~= "" then addLine("Acquisition route: " .. tostring(req.source), T.sub, true) end
        if req.warning then addLine("Note: this route includes a puzzle, timed event, trade, or manual step and may require additional input to continue.", T.warn) end
        if misses == 0 and status == "available" then addLine("All listed requirements are met. Some steps may still require a quest, boss fight, event, or purchase.", T.good, true) end
        addLine("Inventory and currency updates may take a moment to appear, so completion status may not update immediately.", T.sub)
        ovList.CanvasPosition = Vector2.new(0, 0)
        if presentOverlay then presentOverlay() else
            overlay.Position = UDim2.fromOffset(0, 12)
            overlay.Visible = true
            tween(overlay, {Position = UDim2.fromOffset(0, 0)}, 0.12)
        end
    end

