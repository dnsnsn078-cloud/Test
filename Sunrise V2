pcall(function()
    local Players = game:GetService("Players")
    local CoreGui = game:GetService("CoreGui")
    local player = Players.LocalPlayer
    local containers = {CoreGui}
    if player then
        local playerGui = player:FindFirstChildOfClass("PlayerGui") or player:FindFirstChild("PlayerGui")
        if playerGui then containers[#containers + 1] = playerGui end
    end
    local legacyNames = { ["Noguchi Status"] = true, ["Noguchi Ui"] = true, ["Noguchi Toggle"] = true, ["Hex Hub"] = true }
    for _, container in ipairs(containers) do
        for _, object in ipairs(container:GetDescendants()) do
            if legacyNames[object.Name] then pcall(function() object:Destroy() end) end
        end
    end
    local env = type(getgenv) == "function" and getgenv() or _G
    if env then
        local legacyUi = env.HexUI
        if type(legacyUi) == "table" then
            for _, value in pairs(legacyUi) do
                if typeof(value) == "Instance" and value:IsA("ScreenGui") then pcall(function() value:Destroy() end) end
            end
        end
        env.HexUI = nil
    end
end)
