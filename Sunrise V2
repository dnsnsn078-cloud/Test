    -- ============================================================
    local function GrayAndOptimize(object)
        if object:IsA("BasePart") or object:IsA("MeshPart") or object:IsA("UnionOperation") then
            object.Material = Enum.Material.Plastic
            object.Reflectance = 0
            if not object.Name:find("Handle") and not object.Name:find("Attachment") then
                pcall(function() object.Color = Color3.fromRGB(128, 128, 128) end)
            end
        end
        if object:IsA("Decal") or object:IsA("Texture") then
            object.Transparency = 1
        end
        if object:IsA("ParticleEmitter") or object:IsA("Trail") or object:IsA("Smoke") or object:IsA("Fire") then
            object.Enabled = false
        end
    end

    local function EnableFpsBoost()
        if not (Config.Configuration and Config.Configuration.FpsBoost) then return end
        task.spawn(function()
            pcall(function()
                Services.Lighting.GlobalShadows = false
                Services.Lighting.Brightness = 1
                Services.Lighting.Ambient = Color3.fromRGB(128, 128, 128)
                if settings and settings().Rendering then
                    settings().Rendering.QualityLevel = Enum.QualityLevel.Level01
                end

                SunriseWalkDescendantsChunked(workspace, function(descendant)
                    pcall(GrayAndOptimize, descendant)
                end, 300)

                local function onCharacterAdded(character)
                    if not character then return end
                    task.wait(0.5)
                    for _, descendant in ipairs(character:GetDescendants()) do
                        pcall(GrayAndOptimize, descendant)
                    end
                end
                if LocalPlayer and LocalPlayer.Character then onCharacterAdded(LocalPlayer.Character) end
                LocalPlayer.CharacterAdded:Connect(onCharacterAdded)
                Services.Players.PlayerAdded:Connect(function(player)
                    player.CharacterAdded:Connect(onCharacterAdded)
                end)

                -- [FIXED - LAG] task.wait(0.1) INSIDE an event handler that runs for
                -- EVERY object added to workspace was a huge lag source - while
                -- farming bosses/raids/quests, hundreds of objects spawn every second
                -- (particles, projectiles, corpses, hit effects...),
                -- EACH one creating a 100ms yield -> the schedule backed up, matching exactly
                -- boss man's description "farming boss/lv/quest is very laggy".
                -- Removed the wait entirely, it is not needed (setting Color/Material right after
                -- the object is created is safe). Added filtering of object types
                -- EARLY so pcall is not wasted on things that are definitely unrelated
                -- to graphics (Script, Sound, Folder, Value...).
                local GRAYABLE_CLASSES = {
                    BasePart = true, MeshPart = true, UnionOperation = true,
                    Decal = true, Texture = true, ParticleEmitter = true,
                    Trail = true, Smoke = true, Fire = true,
                }
                local pendingGrayObjects, grayHead, grayTail, grayWorkerActive = {}, 1, 0, false
                local function queueGrayObject(descendant)
                    if not (Config.Configuration and Config.Configuration.FpsBoost) then return end
                    if not descendant or not GRAYABLE_CLASSES[descendant.ClassName] then return end
                    grayTail = grayTail + 1
                    pendingGrayObjects[grayTail] = descendant
                    if grayWorkerActive then return end
                    grayWorkerActive = true
                    task.spawn(function()
                        while grayHead <= grayTail do
                            local batchEnd = math.min(grayTail, grayHead + 199)
                            while grayHead <= batchEnd do
                                local object = pendingGrayObjects[grayHead]
                                pendingGrayObjects[grayHead] = nil
                                grayHead = grayHead + 1
                                if Config.Configuration and Config.Configuration.FpsBoost and object and object.Parent then
                                    pcall(GrayAndOptimize, object)
                                end
                            end
                            task.wait()
                        end
                        pendingGrayObjects, grayHead, grayTail, grayWorkerActive = {}, 1, 0, false
                    end)
                end
                workspace.DescendantAdded:Connect(queueGrayObject)

                print("[✅ FPS Boost] Gray mode on + graphics lowered (raw9jjs)")
            end)
        end)
    end
