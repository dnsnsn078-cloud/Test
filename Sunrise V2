    local SERVER_MEMORY_SECONDS = 40 * 60
    local function visitedList()
        local v = S.readJSON(S.Dir .. "/visited.json")
        if type(v) ~= "table" then v = {} end
        local env = type(getgenv) == "function" and getgenv() or _G
        local sessionMemory = env and env.SunriseVisitedServers
        if type(sessionMemory) == "table" then
            for id, stamp in pairs(sessionMemory) do
                if v[id] == nil or (tonumber(stamp) or 0) > (tonumber(v[id]) or 0) then v[id] = stamp end
            end
        end
        local now, out = os.time(), {}
        for id, stamp in pairs(v) do
            local t = tonumber(stamp)
            if type(id) == "string" and t and now >= t and now - t < SERVER_MEMORY_SECONDS then
                out[id] = t
            end
        end
        if env then env.SunriseVisitedServers = out end
        return out
    end
    local function saveVisitedServers(visited)
        local env = type(getgenv) == "function" and getgenv() or _G
        if env then env.SunriseVisitedServers = visited end
        pcall(function() S.writeJSON(S.Dir .. "/visited.json", visited) end)
    end
    local function serverListHop()
        local TeleportService = game:GetService("TeleportService")
        local visited = visitedList()
        local currentJob = tostring(game.JobId)
        local now = os.time()
        visited[currentJob] = now
        -- Persist the current server immediately, including when no candidate is found.
        saveVisitedServers(visited)

        for attempt = 1, 4 do
            local candidates, cursor, seen = {}, nil, {}
            for page = 1, 3 do
                local url = "https://games.roblox.com/v1/games/" .. game.PlaceId .. "/servers/Public?sortOrder=Asc&limit=100&excludeFullGames=true"
                if cursor then url = url .. "&cursor=" .. HttpService:UrlEncode(cursor) end
                local ok, data = pcall(function()
                    return HttpService:JSONDecode(game:HttpGet(url))
                end)
                if not ok or type(data) ~= "table" then
                    task.wait(1.5)
                    break
                end
                for _, server in ipairs(data.data or {}) do
                    local id = type(server.id) == "string" and server.id or nil
                    local playing = tonumber(server.playing) or 0
                    local maxPlayers = tonumber(server.maxPlayers) or 0
                    if id and id ~= currentJob and not visited[id] and not seen[id]
                        and maxPlayers > 0 and playing < maxPlayers - 1 then
                        seen[id] = true
                        candidates[#candidates + 1] = id
                    end
                end
                cursor = data.nextPageCursor
                if #candidates >= 10 or not cursor then break end
            end

            if #candidates > 0 then
                -- Randomize the order without choosing a server known to be visited recently.
                for i = #candidates, 2, -1 do
                    local j = math.random(1, i)
                    candidates[i], candidates[j] = candidates[j], candidates[i]
                end
                for _, targetJob in ipairs(candidates) do
                    if Config.Mode == "FruitFinder" and not F.Running then return false end
                    visited[targetJob] = os.time()
                    saveVisitedServers(visited)
                    local ok = pcall(function()
                        TeleportService:TeleportToPlaceInstance(game.PlaceId, targetJob, lp)
                    end)
                    if ok then
                        F.Status = "Teleporting to a fresh server-list result..."
                        task.wait(8)
                        if tostring(game.JobId) ~= currentJob then return true end
                    end
                    -- An unsuccessful teleport is remembered so it is not retried repeatedly.
                    task.wait(0.75)
                end
            else
                task.wait(1.5)
            end
        end

        -- Deliberately do not call TeleportService:Teleport(placeId) here: it can
        -- return to a recently visited server and bypass the 40-minute memory rule.
        F.Status = "No fresh server found in the server list; waiting before retry"
        task.wait(5)
        return false
    end
    function S.Hop()
        F.Status = "Hopping via public server list..."
        -- This is intentionally server-list-only. Never use sea travel or a random
        -- Teleport(placeId) fallback, because those bypass the visited-server memory.
        local queued = S.queueOnTeleport()
        if Config.Mode == "FruitFinder" and F.Running and not queued then
            F.Status = "Teleport queue unavailable; retrying server list without auto-resume"
        end
        return serverListHop()
    end
    function S.findFruits()
        local list = {}
        for _, o in ipairs(workspace:GetChildren()) do
            if string.find(o.Name, "Fruit") and o:FindFirstChild("Handle") then list[#list + 1] = o end
        end
        local char = lp.Character
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        if hrp then table.sort(list, function(a, b) return (a.Handle.Position - hrp.Position).Magnitude < (b.Handle.Position - hrp.Position).Magnitude end) end
        return list
    end
    -- is this fruit good enough for the "minimum fruit" filter? unknown fruits are always taken
    function S.fruitWanted(fr)
        local info = S.FruitInfo(fr.Name)
        local minName = Config.Finder.MinFruit
        if info.name == "???" or not minName or minName == "" or minName == "Any" then return true, info end
        local minInfo
        for _, f in ipairs(S.FruitList) do if f.name == minName then minInfo = f end end
        if not minInfo then return true, info end
        return info.price >= minInfo.price, info
    end
    local function removed(fr) return not fr:IsDescendantOf(game) end
    function F.Start()
        if F.Running then return end
        F.Running = true
        task.spawn(function()
            F.Status = "Loading..."
            local char = lp.Character or lp.CharacterAdded:Wait()
            pcall(function() char:WaitForChild("HumanoidRootPart", 15) end)
            pcall(function()
                local pg = lp:WaitForChild("PlayerGui", 10)
                local main = pg and pg:FindFirstChild("Main")
                if main and main:FindFirstChild("ChooseTeam") then
                    SunriseSelectPiratesIfUnassigned()
                    -- Do not issue another request if a team was already selected.
                    if lp.Team ~= nil then pcall(function() main.ChooseTeam:Destroy() end) end
                end
            end)
            while F.Running do
                F.Server = F.Server + 1
                F.Status = "Scanning for fruits..."
                local fruits = S.findFruits()
                if #fruits == 0 then task.wait(1.2); fruits = S.findFruits() end -- fruits can replicate a moment late
                local handled = 0
                for _, fr in ipairs(fruits) do
                    if not F.Running then break end
                    local ok, info = S.fruitWanted(fr)
                    if not ok then
                        F.Skipped = F.Skipped + 1
                        local acc = S.FruitLog.accounts[lp.Name]
                        if not acc then acc = {fruits = {}}; S.FruitLog.accounts[lp.Name] = acc end
                        acc.skipped = (acc.skipped or 0) + 1
                        F.Status = "Skipped " .. info.name .. " (below minimum)"
                    elseif fr:FindFirstChild("Handle") and not removed(fr) then
                        handled = handled + 1
                        F.Status = "Grabbing " .. info.name .. "..."
                        local keys, seen = {}, {}
                        local base = (fr.Name:gsub(" Fruit$", ""))
                        for _, k in ipairs({fr:GetAttribute("OriginalName"), fr.Name, base .. "-" .. base}) do
                            if k and not seen[k] then seen[k] = true; keys[#keys + 1] = k end
                        end
                        local stored, why = false, nil
                        if S.inventoryHas(keys[1]) or S.inventoryHas(base .. "-" .. base) then
                            why = "already in storage"
                        else
                            local t0, iter = os.clock(), 0
                            -- Unknown/"???" fruits can fail when the character is snapped
                            -- directly onto them, so tween to those while retaining instant
                            -- movement for normally identified fruits.
                            if info.name == "???" then
                                pcall(function()
                                    local charNow = lp.Character
                                    local root = charNow and charNow:FindFirstChild("HumanoidRootPart")
                                    if root and fr:FindFirstChild("Handle") then
                                        local target = CFrame.new(fr.Handle.Position + Vector3.new(0, 3, 0))
                                        local distance = (root.Position - target.Position).Magnitude
                                        local duration = math.clamp(distance / 250, 0.35, 8)
                                        local tw = finderTweenService:Create(root, TweenInfo.new(duration, Enum.EasingStyle.Linear), {CFrame = target})
                                        tw:Play()
                                        local started = os.clock()
                                        while F.Running and tw.PlaybackState == Enum.PlaybackState.Playing and os.clock() - started < duration + 0.5 do task.wait(0.1) end
                                    end
                                end)
                            end
                            repeat
                                iter = iter + 1
                                if info.name ~= "???" then
                                    pcall(function()
                                        local charNow = lp.Character
                                        local root = charNow and charNow:FindFirstChild("HumanoidRootPart")
                                        if root and fr:FindFirstChild("Handle") then
                                            root.CFrame = CFrame.new(fr.Handle.Position + Vector3.new(0, 3, 0))
                                        end
                                    end)
                                end
                                task.wait(0.2)
                                local k = keys[((iter - 1) % #keys) + 1] -- one call per round, trying each name format in turn
                                pcall(function() commf():InvokeServer("StoreFruit", k, fr) end)
                                stored = removed(fr)
                                if stored and type(S.OnFruitStored) == "function" then pcall(S.OnFruitStored, k, fr) end
                            until stored or not F.Running or os.clock() - t0 >= (Config.Finder.HopDelay or 5)
                            if not stored then why = "storage full?" end
                        end
                        S.logFruit(fr.Name, stored, why)
                        F.Status = (stored and "Stored " or "Could not store ") .. info.name
                    end
                end
                if not F.Running then break end
                if handled == 0 then
                    local waitForDead = math.clamp(tonumber(Config.Finder.DeadServerDelay) or 5, 1, 60)
                    F.Status = (F.Skipped > 0 and "Nothing worth taking here" or "No fruit here")
                        .. " • treating server as empty in " .. tostring(waitForDead) .. "s"
                    local deadline = os.clock() + waitForDead
                    while F.Running and os.clock() < deadline do task.wait(math.min(0.25, deadline - os.clock())) end
                    if not F.Running then break end
                    F.Status = "Empty server confirmed; hopping via server list..."
                else
                    task.wait(1)
                end
                S.Hop()
            end
            F.Status = "Stopped"
        end)
    end
    function F.Stop(silent)
        F.Running = false
        if not silent then
            Config.Mode = (Config.Finder.PrevMode ~= "FruitFinder" and Config.Finder.PrevMode) or "Custom"
            S.save()
            if S.OnModeChanged then pcall(S.OnModeChanged, Config.Mode, "FruitFinder") end
            if _G then _G.Stop = false end
        end
    end

    -- ---------- which tasks run in which mode (used by the dispatcher) ----------
    function SunriseTaskOrder()
        local mode = Config.Mode
        if mode == "FruitFinder" then return {} end
        -- RefreshTasksData is first-match-wins. Give explicit gear goals a chance before
        -- the raid controller: in Sea 2/3 the raid handler can remain eligible while idle
        -- and otherwise starve shop weapons such as Cutlass and selected boss-drop gear.
        local o = {}
        local function any(t) for _, v in pairs(t or {}) do if v == true then return true end end return false end
        local I = Config.Items
        local gearGoalOn = any(Config.Sword) or any(Config.Guns) or any(Config.Accessories) or I.Saber or I.CursedDualKatana
        if gearGoalOn then table.insert(o, "SwordBossTask") end
        table.insert(o, "SunriseRaid")
        table.insert(o, "SunriseBoss")
        table.insert(o, "SunriseMob")
        table.insert(o, "SunriseMaterial")
        -- Dough King is a high-priority endgame route when explicitly enabled.
        if Config.Goals and Config.Goals.AutoDoughKing then table.insert(o, 1, "DoughKingTask") end
        if Config.Goals and Config.Goals.AutoDraco then table.insert(o, 1, "DracoRaceTask") end
        if Config.Goals and Config.Goals.AutoGhoul then table.insert(o, 1, "GhoulRaceTask") end
        if any(Config.BossWeapons) then o[#o + 1] = "SpecialBossesTask"; o[#o + 1] = "BossesTask" end
        if I.AutoFullyMelees then for _, n in ipairs({"RaidController", "AutoRaidIce", "CakePrinceTask", "MeleesController"}) do o[#o + 1] = n end end
        if Config.Farm.Level then o[#o + 1] = "LevelFarm" end
        if I.CursedDualKatana then
            for _, n in ipairs({"Tushita", "Yama", "CursedDualKatana"}) do o[#o + 1] = n end
        else
            if Config.Sword and Config.Sword["Tushita"] then o[#o + 1] = "Tushita" end
            if Config.Sword and Config.Sword["Yama"] then o[#o + 1] = "Yama" end
        end
        if I.Saber then o[#o + 1] = "Saber" end
        if I.SoulGuitar then o[#o + 1] = "SoulGuitar" end
        if I.RaceV2 then o[#o + 1] = "EvoRace" end
        if I.AutoRaceV3 then o[#o + 1] = "RaceAwakening" end
        if Config.Goals and Config.Goals.AutoRainbowHaki == true and SeaIndex == 3 then
            table.insert(o, 1, "RainbowSaviour")
        end

        -- Explicit UI activation priority: the task enabled most recently is checked first.
        -- RefreshTasksData is first-match-wins, so moving the selected handler to index 1
        -- is what makes the newest conflicting automation actually take control.
        local priorityEnabled = {
            LevelFarm = Config.Farm and Config.Farm.Level == true,
            SunriseMaterial = Config.Farm and Config.Farm.Materials == true,
            SunriseMob = Config.Farm and Config.Farm.Mob == true,
            SunriseBoss = Config.Farm and Config.Farm.Boss == true,
            SunriseRaid = Config.Raid and Config.Raid.Enabled == true,
            DoughKingTask = Config.Goals and Config.Goals.AutoDoughKing == true,
            GhoulRaceTask = Config.Goals and Config.Goals.AutoGhoul == true,
            DracoRaceTask = Config.Goals and Config.Goals.AutoDraco == true,
            Saber = Config.Items and Config.Items.Saber == true,
            CursedDualKatana = Config.Items and Config.Items.CursedDualKatana == true,
            SoulGuitar = Config.Items and Config.Items.SoulGuitar == true,
            EvoRace = Config.Items and Config.Items.RaceV2 == true,
            RaceAwakening = Config.Items and Config.Items.AutoRaceV3 == true,
            RainbowSaviour = Config.Goals and Config.Goals.AutoRainbowHaki == true and SeaIndex == 3,
            MeleesController = Config.Items and Config.Items.AutoFullyMelees == true,
            SwordBossTask = (any(Config.Sword) or any(Config.Guns) or any(Config.Accessories)
                or (Config.Items and (Config.Items.Saber or Config.Items.CursedDualKatana))),
        }
        local priorityStack = _G.SunriseTaskPriorityStack
        if type(priorityStack) == "table" then
            local seen = {}
            for i = 1, #priorityStack do
                local entry = priorityStack[i]
                local taskName = type(entry) == "table" and entry.task or nil
                if taskName and priorityEnabled[taskName] and not seen[taskName] then
                    seen[taskName] = true
                    for j = #o, 1, -1 do
                        if o[j] == taskName then table.remove(o, j) end
                    end
                    table.insert(o, 1, taskName)
                end
            end
        end
        return o
    end

    -- ---------- stats (replaces the old automatic AddPoint) ----------
    function SunriseAddPoints()
        local St = Config.Stats
        if not (St and St.Enabled) then return end
        local pts = lp.Data.Points.Value
        if not pts or pts <= 0 then return end
        local picks = {}
        for _, n in ipairs({"Melee", "Defense", "Sword", "Gun", "Demon Fruit"}) do if St[n] then picks[#picks + 1] = n end end
        if #picks == 0 then return end
        local each = math.max(1, math.floor(pts / #picks))
        for i, n in ipairs(picks) do
            local give = (i == #picks) and (pts - each * (#picks - 1)) or each
            if give > 0 then pcall(function() commf():InvokeServer("AddPoint", n, give) end) end
        end
    end
end


