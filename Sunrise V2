        	self._rows = self._rows + 1
        	local hi = new("Frame", {Position = UDim2.fromOffset(5, 3), Size = hiH and UDim2.new(1, -10, 0, hiH) or UDim2.new(1, -10, 1, -6), BackgroundColor3 = T.hover, BackgroundTransparency = 1, BorderSizePixel = 0}, row)
        	round(hi, 8)
        	return hi
        end
        function Group:_row(h)
        	local r = new("Frame", {Size = UDim2.new(1, 0, 0, h), BackgroundTransparency = 1, BorderSizePixel = 0, LayoutOrder = nextOrder(self)}, self.body)
        	return r, self:_decor(r)
        end
        function Group:_reg(def, h) if def.Id then self.ui.Widgets[def.Id] = h end return h end
        function Group:_bind(def, show, initial)
        	local ui, id = self.ui, def.Id
        	if id then ui.Flags[id] = initial; ui._set[id] = function(v) show(v); ui.Flags[id] = v end end
        	show(initial)
        	return function(v, silent)
        		show(v)
        		if id then ui.Flags[id] = v end
        		if silent then return end
        		if def.Callback then task.spawn(def.Callback, v) end
        		if id then ui:_fire(id, v) end
        	end
        end

