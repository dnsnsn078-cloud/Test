    local function saberRichManPosition(npc)
        if not npc then return nil end
        local root = npc:FindFirstChild("HumanoidRootPart") or npc.PrimaryPart
        if root and root:IsA("BasePart") then return root.CFrame end
        if npc:IsA("Model") then
            local ok, cf = pcall(function() return npc:GetPivot() end)
            if ok then return cf end
        end
        return nil
    end
    local function saberGoTalkToRichMan(actionText)
        local npc = saberRichMan()
