        -- [NEW] "is everything eligible yet" gate - boss man
        -- asked: only when ALL 9 melees (V1+V2, including Superhuman - the new spec
        -- requires Superhuman to reach 500 before Godhuman too, DIFFERENT from my
        -- old design that excluded it, now fixed) are BOUGHT
        -- and at the target mastery (V1=500, V2=400) do we start
        -- farming materials/F/Beli for Godhuman.
        local MASTERY_GATE_MELEES = {
            {name = "Black Leg",       target = Config.Melee.RaidAtV1Mastery},
