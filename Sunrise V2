        end

        local targets = collectTargets(char)
        for _, t in ipairs(targets) do paralyzeMob(t) end

        for mob in pairs(paralyzedMobs) do
            if not mob.Parent or not isAlive(mob) then
                clearParalyze(mob)
            end
        end
    end
end)

