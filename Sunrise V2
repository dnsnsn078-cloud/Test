local function GetValidator2()
    if not SUCCESS_SHOOT or not SHOOT_FUNCTION then
        return math.random(1, 99999999), 1
    end

    local v53 = getupvalue(SHOOT_FUNCTION, 13)
    local v54 = getupvalue(SHOOT_FUNCTION, 14)
    local v55 = getupvalue(SHOOT_FUNCTION, 15)
    local v56 = getupvalue(SHOOT_FUNCTION, 16)
    local v57 = getupvalue(SHOOT_FUNCTION, 17)
    local v58 = getupvalue(SHOOT_FUNCTION, 18)
    local v59 = getupvalue(SHOOT_FUNCTION, 19)

    local v93 = v53 * v54
    local v96 = (v55 * v54 + v53 * v56) % v57
    v96 = (v96 * v57 + v93) % v58
    v55 = math.floor(v96 / v57)
    v53 = v96 - v55 * v57
    v59 = v59 + 1

    setupvalue(SHOOT_FUNCTION, 13, v53)
    setupvalue(SHOOT_FUNCTION, 15, v55)
    setupvalue(SHOOT_FUNCTION, 19, v59)

    return math.floor(v96 / v58 * 16777215), v59
end

local function isAlive(m)
    local h = m and m:FindFirstChildOfClass("Humanoid")
    return h and h.Health > 0
end

local HitboxPartCache = setmetatable({}, {__mode = "k"})
local function getHitbox(m)
    local cached = HitboxPartCache[m]
    if cached and cached.Parent then return cached end
    for _ = 1, 6 do
        local name = CFG.HitboxLimbs[math.random(#CFG.HitboxLimbs)]
        local part = m:FindFirstChild(name)
        if part and part:IsA("BasePart") then
            HitboxPartCache[m] = part
            return part
        end
    end
    local root = m:FindFirstChild("HumanoidRootPart")
    if root then HitboxPartCache[m] = root end
    return root
end

local VOidChildSnapshotCache = setmetatable({}, {__mode = "k"})
local function getVOidChildren(folder)
    if not folder then return {} end
    local entry = VOidChildSnapshotCache[folder]
    if not entry then
        entry = {items = {}, dirty = true, updated = 0}
        VOidChildSnapshotCache[folder] = entry
        pcall(function() folder.ChildAdded:Connect(function() entry.dirty = true end) end)
        pcall(function() folder.ChildRemoved:Connect(function() entry.dirty = true end) end)
    end
    local now = os.clock()
    if entry.dirty or now - entry.updated >= 0.25 then
        local ok, children = pcall(folder.GetChildren, folder)
        entry.items = ok and children or {}
        entry.dirty = false
        entry.updated = now
    end
    return entry.items
end

local function collectTargets(char)
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if not root then return {} end
    local pos = root.Position
    local list = {}

    local function scan(folder)
        if not folder then return end
        for _, e in ipairs(getVOidChildren(folder)) do
            if e ~= char and isAlive(e) then
                local rp = e:FindFirstChild("HumanoidRootPart")
                if rp and (rp.Position - pos).Magnitude <= CFG.Range then
                    list[#list + 1] = e
                end
            end
        end
    end

    if CFG.AttackMobs    then scan(workspace:FindFirstChild("Enemies"))    end
    if CFG.AttackPlayers then scan(workspace:FindFirstChild("Characters")) end
    return list
end

local function buildConfig(targets)
    local cfg = {}
    for _, e in ipairs(targets) do
        local part = getHitbox(e)
        if part then cfg[#cfg + 1] = {e, part} end
    end
    return cfg
end

local function fireStandard(targets, preparedConfig)
    local cfg = preparedConfig or buildConfig(targets)
    if #cfg == 0 then return end

    local primary = cfg[1][1]:FindFirstChild("Head")
                    or cfg[1][1]:FindFirstChild("HumanoidRootPart")
    if not primary then return end

    RE_RegisterAttack:FireServer(0)
    RE_RegisterHit:FireServer(primary, cfg)
end

local function fireObfuscated(targets, preparedConfig)
    if not (CFG.UseObfuscated and capturedChild and RemoteId) then return end
    local cfg = preparedConfig or buildConfig(targets)
    if #cfg == 0 then return end

    local primary = cfg[1][1]:FindFirstChild("Head")
                    or cfg[1][1]:FindFirstChild("HumanoidRootPart")
    if not primary then return end

    pcall(function()
        RE_RegisterAttack:FireServer()
        local key1 = string.gsub("RE/RegisterHit", ".", function(ch)
            return string.char(bit32.bxor(string.byte(ch),
                math.floor(workspace:GetServerTimeNow() / 10 % 10) + 1))
        end)
        local seed = Net.seed:InvokeServer() * 2
        local key2 = bit32.bxor(RemoteId + 909090, seed)
        cloneref(capturedChild):FireServer(key1, key2, primary, cfg)
    end)
end

local CooldownValueCache = setmetatable({}, {__mode = "k"})
local function clearAllCooldowns(tool)
    if not (CFG.ResetCooldown and tool) then return end
    pcall(function()
        local entry = CooldownValueCache[tool]
        if not entry then
            entry = {dirty = true, values = {}}
            CooldownValueCache[tool] = entry
            tool.DescendantAdded:Connect(function() entry.dirty = true end)
            tool.DescendantRemoving:Connect(function() entry.dirty = true end)
        end
        if entry.dirty then
            local values = {}
            for _, v in ipairs(tool:GetDescendants()) do
                if v:IsA("NumberValue") then
                    local n = string.lower(v.Name)
                    if string.find(n, "cooldown", 1, true) or string.find(n, "cd", 1, true)
                        or string.find(n, "reload", 1, true) then
                        values[#values + 1] = v
                    end
                end
            end
            entry.values = values
            entry.dirty = false
        end
        for i = #entry.values, 1, -1 do
            local v = entry.values[i]
            if not v or not v.Parent or not v:IsDescendantOf(tool) then
                table.remove(entry.values, i)
                entry.dirty = true
            elseif v.Value ~= 0 then
                v.Value = 0
            end
        end
    end)
end

local paralyzedMobs = {}

local function paralyzeMob(mob)
    if not CFG.Paralyze or not mob or not mob.Parent then return end

    local hrp = mob:FindFirstChild("HumanoidRootPart")
    local hum = mob:FindFirstChildOfClass("Humanoid")
    if not hrp or not hum then return end

    local stored = paralyzedMobs[mob]
    local now = os.clock()
    if stored and stored.root == hrp and now - (stored.lastUpdate or 0) < 0.30 then
        return -- BodyPosition/BodyGyro already hold this mob; avoid rewriting every pass.
    end
    local lockedPos = stored and stored.pos or hrp.Position
    if not stored then
        stored = {pos = lockedPos, root = hrp, humanoid = hum}
        paralyzedMobs[mob] = stored
        pcall(function()
            if setnetworkowner then setnetworkowner(mob, false) end
        end)
    end
    stored.root = hrp
    stored.humanoid = hum
    stored.lastUpdate = now

    pcall(function()
        if hrp.AssemblyLinearVelocity.Magnitude > 0.05 then hrp.AssemblyLinearVelocity = Vector3.zero end
        if hrp.AssemblyAngularVelocity.Magnitude > 0.05 then hrp.AssemblyAngularVelocity = Vector3.zero end
        if (hrp.Position - lockedPos).Magnitude > 0.5 then
            hrp.CFrame = CFrame.new(lockedPos, lockedPos + hrp.CFrame.LookVector)
        end
    end)

    pcall(function()
        if hum.WalkSpeed ~= 0 then hum.WalkSpeed = 0 end
        if hum.JumpPower ~= 0 then hum.JumpPower = 0 end
        if hum.JumpHeight ~= 0 then hum.JumpHeight = 0 end
        if hum.AutoRotate then hum.AutoRotate = false end
    end)

    pcall(function()
        local bp = hrp:FindFirstChild("VOidLock")
        if not bp then
            bp = Instance.new("BodyPosition")
            bp.Name = "VOidLock"
            bp.MaxForce = Vector3.new(1000000, 1000000, 1000000)
            bp.P = 200000
            bp.D = 1000
            bp.Position = lockedPos
            bp.Parent = hrp
        else
            bp.Position = lockedPos
        end

        local bg = hrp:FindFirstChild("VOidGyro")
        if not bg then
            bg = Instance.new("BodyGyro")
            bg.Name = "VOidGyro"
            bg.MaxTorque = Vector3.new(1000000, 1000000, 1000000)
            bg.P = 200000
            bg.D = 1000
            bg.CFrame = CFrame.new(lockedPos, lockedPos + hrp.CFrame.LookVector)
            bg.Parent = hrp
        else
            bg.CFrame = CFrame.new(lockedPos, lockedPos + hrp.CFrame.LookVector)
        end
    end)
end

local function clearParalyze(mob)
    if not mob then return end
    local hrp = mob:FindFirstChild("HumanoidRootPart")
    if hrp then
        pcall(function()
            if hrp:FindFirstChild("VOidLock") then hrp.VOidLock:Destroy() end
            if hrp:FindFirstChild("VOidGyro") then hrp.VOidGyro:Destroy() end
        end)
    end
    -- Always release the table reference, even when the NPC was already destroyed
    -- and its HumanoidRootPart is no longer accessible.
    paralyzedMobs[mob] = nil
end

local function attackMelee(char, tool, targets)
    for _, t in ipairs(targets) do paralyzeMob(t) end

    -- Build the hit config once per burst. Target models/parts do not change between
    -- multi-hit packets, so rebuilding it on every hit only adds allocations.
    local preparedConfig = buildConfig(targets)
    -- Run each hit burst serially. The obfuscated path uses InvokeServer; spawning
    -- a fresh coroutine for every hit can accumulate blocked coroutines when the
    -- server/network is slow, which looks like a long freeze without a crash.
    for i = 1, CFG.MultiHitCount do
        if #preparedConfig > 0 then
            fireStandard(targets, preparedConfig)
            fireObfuscated(targets, preparedConfig)
        end
        if i < CFG.MultiHitCount then task.wait(CFG.MultiHitDelay) end
    end

    if CFG.VisualActivate and tool then
        pcall(function() tool:Activate() end)
    end
end

