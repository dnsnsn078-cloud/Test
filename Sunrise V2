            if bridge and type(bridge.GetStatus) == "function" then
                local ok, st = pcall(bridge.GetStatus)
                if ok and type(st) == "table" then
                    -- AutoSC's aggregate count includes The Finale; keep the 39 regular
                    -- secret counter separate and show Finale's completion alongside it.
                    done = localDone
                    total = localTotal
                    current = tostring(st.current or current)
                    status = tostring(st.status or st.step or status)
                    manual = st.manual == true
                    selected = tonumber(st.selected) or 0
                end
            end
            done = math.clamp(tonumber(done) or 0, 0, math.max(1, total))
            progressCount.Text = tostring(done) .. " / " .. tostring(total) .. " regular"
            progressFill.Size = UDim2.new(done / math.max(1, total), 0, 1, 0)
            local detailError = SunriseGetSecretProgressError and SunriseGetSecretProgressError() or nil
            progressDetail.Text = (manual and (tostring(selected) .. " selected · ") or "All remaining · ")
                .. current .. " · " .. status .. " · Finale: " .. (finaleDone and "complete" or "not complete")
                .. (detailError and " · progress read failed; retrying" or "")
            return done, total, current, status
        end
        refreshProgressButton.Activated:Connect(function()
            SunriseReadSecretProgress(true)
            selectedCount(true)
            pcall(refreshSecretProgress)
            for _, redraw in ipairs(secretQuestRedraws) do pcall(redraw) end
        end)
        local lastSecretTrackerUiUpdate = 0
        updaters[#updaters + 1] = function()
            local now = os.clock()
