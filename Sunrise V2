        function Sunrise:Select(name)
        	local tab = self._sectionByName and self._sectionByName[name]
        	if tab and tab.Select then tab.Select(); return true end
        	return false
        end

        function Sunrise:Section(name, icon, subtitle)
        	local btn = new("TextButton", {Size = UDim2.new(1, 0, 0, 36), BackgroundColor3 = T.hover, BackgroundTransparency = 1, Text = "", AutoButtonColor = false, BorderSizePixel = 0, LayoutOrder = #self.tabs + 1}, self.Side)
        	round(btn, 9)
        	local bar = new("Frame", {AnchorPoint = Vector2.new(0, .5), Position = UDim2.new(0, 3, .5, 0), Size = UDim2.fromOffset(3, 0), BackgroundColor3 = WHITE, BorderSizePixel = 0}, btn)
        	round(bar, 2); acc(bar, 90)
        	local ico = glyph(btn, icon, 16, T.sub)
        	local nm = label(btn, {Text = name, Position = UDim2.fromOffset(36, 0), Size = UDim2.new(1, -40, 1, 0), TextColor3 = T.sub, TextTruncate = Enum.TextTruncate.AtEnd})

        	local page = new("ScrollingFrame", {Name = name, Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, BorderSizePixel = 0, ScrollBarThickness = 3, ScrollBarImageColor3 = T.dim, CanvasSize = UDim2.new(), AutomaticCanvasSize = Enum.AutomaticSize.Y, ScrollingDirection = Enum.ScrollingDirection.Y, Visible = false}, self.Pages)
        	pad(page, 2, 2, 8, 14); list(page, 14)
        	local head = new("Frame", {Size = UDim2.new(1, 0, 0, 40), BackgroundTransparency = 1, LayoutOrder = 0}, page)
        	local tile = new("Frame", {Position = UDim2.fromOffset(0, 4), Size = UDim2.fromOffset(32, 32), BackgroundColor3 = T.card, BorderSizePixel = 0}, head)
        	round(tile, 10); stroke(tile, T.line, 1)
        	local hg = glyph(tile, icon, 18, T.sun)
        	hg.Root.AnchorPoint = Vector2.new(.5, .5); hg.Root.Position = UDim2.fromScale(.5, .5)
        	label(head, {Text = name, Position = UDim2.fromOffset(44, 2), Size = UDim2.new(1, -44, 0, 20), Font = BOLD, TextSize = 17})
        	label(head, {Text = subtitle or "", Position = UDim2.fromOffset(44, 23), Size = UDim2.new(1, -44, 0, 14), TextSize = 11, TextColor3 = T.sub})

        	local tab = {btn = btn, bar = bar, icon = ico, name = nm, page = page, key = name, on = false}
        	local function select()
        		if self.active == tab then return end
        		self.active = tab
        		for _, t in ipairs(self.tabs) do
        			local on = t == tab
        			t.on = on
        			tween(t.btn, {BackgroundTransparency = on and 0 or 1}, .2)
        			tween(t.bar, {Size = UDim2.fromOffset(3, on and 16 or 0)}, .24)
        			t.icon:Color(on and T.sun or T.sub)
        			tween(t.name, {TextColor3 = on and T.text or T.sub}, .2)
        			if not on then t.page.Visible = false end
        		end
        		page.Position = UDim2.fromOffset(0, 10)
        		page.Visible = true
        		self.PageVeil.BackgroundTransparency = 0
        		tween(self.PageVeil, {BackgroundTransparency = 1}, .22)
        		tween(page, {Position = UDim2.fromOffset(0, 0)}, .28)
        	end
        	btn.MouseEnter:Connect(function() if not tab.on then tween(btn, {BackgroundTransparency = .6}, .12) end end)
        	btn.MouseLeave:Connect(function() if not tab.on then tween(btn, {BackgroundTransparency = 1}, .16) end end)
        	btn.Activated:Connect(function()
        		if self.active ~= tab then self:_snd("pick") end
        		select()
        	end)
        	tab.Select = select
        	self._sectionByName = self._sectionByName or {}
        	self._sectionByName[name] = tab
        	table.insert(self.tabs, tab)
        	if #self.tabs == 1 then select() end
        	self:_layout()
        	return setmetatable({ui = self, page = page, _n = 0}, Section)
        end

        ---------------------------------------------------------------- window
        function Sunrise:_c(conn) table.insert(self._conns, conn); return conn end
        function Sunrise:_fire(id, v) for _, fn in ipairs(self._on[id] or {}) do task.spawn(fn, v) end end
        function Sunrise:On(id, fn) self._on[id] = self._on[id] or {}; table.insert(self._on[id], fn) end
        function Sunrise:Set(id, v) local s = self._set[id]; if s then s(v) end end
        function Sunrise:Get(id) return self.Flags[id] end
        function Sunrise:Destroy()
        	for _, c in ipairs(self._conns) do c:Disconnect() end
        	for _, s in pairs(self._snds) do s:Destroy() end
        	self.Gui:Destroy()
        end

        function Sunrise:_snd(kind, pitch)
        	if not self.Sound.Enabled then return end
        	local d = SOUNDS[kind]
        	if not d then return end
        	if kind == "tick" then
        		local n = os.clock()
        		if n - (self._tk or 0) < .045 then return end
