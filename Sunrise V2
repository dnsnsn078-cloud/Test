        -- every second, and only when BOTH Yama+Tushita >= 350 does CDK start.
        if k["Cursed Dual Katana"] then return end
        if not k.Tushita or (k.Tushita.Mastery or 0) < 350 or not k.Yama or (k.Yama.Mastery or 0) < 350 then
            return {"trainSwords"}
