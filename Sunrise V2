    local SunriseModernLibrary = (function()
        --[[ Sunrise UI -- interface only, zero game logic.
        Wire your features from the outside:
          local UI = getgenv().SunriseUI
          UI:On("farm.level", function(on) ... end)   -- react to a control
          UI.Flags["farm.level"]                      -- read a value any time
          UI:Set("now.task", "Farming Bandits")       -- push a value into the UI (fires no callback)
          UI.Widgets["farm.mob"]:SetOptions({...})    -- fill dropdowns
