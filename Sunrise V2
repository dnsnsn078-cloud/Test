                    if castle and CaculateDistance(castle:GetModelCFrame()) > 1800 then
                        TweenController.Create(castle:GetModelCFrame())
                    end
                end
            end
            return
        end

        -- CakePrinceSpawner reports the 500-kill progress and is the same spawn
        -- remote used by BananaHub. Only request the summon after progress is ready.
        local progressResponse
        pcall(function() progressResponse = Remotes.CommF_:InvokeServer("CakePrinceSpawner") end)
