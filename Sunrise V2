        if not anchorHumanoid or not anchorRoot or anchorHumanoid.Health <= 0 then
            SunriseSetMobPullStatus("Waiting for a live target")
            return
        end

        local bringRange = math.clamp(tonumber(Config.BringMobsRange) or 500, 150, 600)
        local targetDistance = (anchorRoot.Position - playerRoot.Position).Magnitude
        -- While moving between islands or travelling to a spawn, just leave physics alone.
        if targetDistance > math.min(bringRange, 200) then
            SunriseSetMobPullStatus("Waiting until the target is nearby")
            return
        end

        SunriseEnsureSimulationRadius(player, 600)
        local anchorPosition = anchorRoot.Position
        local pulled = 0
        local enemyList = SunriseGetNearbyBringMobs(enemies, anchorPosition, bringRange)

        for _, enemy in ipairs(enemyList) do
            if enemy ~= anchor and enemy:IsA("Model") then
                local humanoid, root = SunriseGetBringMobParts(enemy)
                if humanoid and root and humanoid.Health > 0 and not root.Anchored then
                    local offset = root.Position - anchorPosition
                    local distanceFromAnchor = offset.Magnitude
                    if distanceFromAnchor <= bringRange
                        and (root.Position - playerRoot.Position).Magnitude <= bringRange then
                        local needsPosition = distanceFromAnchor > 3
                        local needsFreeze = root.CanCollide or humanoid.WalkSpeed ~= 0
                            or humanoid.JumpPower ~= 0 or humanoid.AutoRotate

                        -- An already gathered mob needs no owner check or repeated writes.
                        -- Only ask the network-ownership API when an actual change is needed.
                        if needsPosition or needsFreeze then
                            local ownsPart = false
                            pcall(function()
                                if isnetworkowner then
                                    ownsPart = isnetworkowner(root)
                                else
                                    ownsPart = root.ReceiveAge == 0
                                end
                            end)
                            if ownsPart then
                                if needsPosition then
                                    if not root:FindFirstChild("BodyVelocity") then
                                        local bodyVelocity = Instance.new("BodyVelocity")
                                        bodyVelocity.Name = "BodyVelocity"
                                        bodyVelocity.MaxForce = Vector3.new(1000000, 1000000, 1000000)
                                        bodyVelocity.Velocity = Vector3.zero
                                        bodyVelocity.Parent = root
                                    end
                                    root.CFrame = CFrame.new(anchorPosition)
                                end
                                if root.CanCollide then root.CanCollide = false end
                                if humanoid.WalkSpeed ~= 0 then humanoid.WalkSpeed = 0 end
                                if humanoid.JumpPower ~= 0 then humanoid.JumpPower = 0 end
                                if humanoid.AutoRotate then humanoid.AutoRotate = false end
                                pulled = pulled + 1
                            end
                        end
                    end
                end
            end
        end
        SunriseSetMobPullStatus(pulled > 0 and ("Pulling nearby mobs (" .. tostring(pulled) .. ")") or "Fight active — no nearby mobs to pull")
    end

