    -- LEVEL FARM - COMPLETE
    -- ============================================================
    -- [ADDED - as boss man requested: "fix the level farm system... from file
    -- message 10"] QuestController - tracks quests via the real REMOTE EVENT
    -- (Remotes.QuestUpdate) instead of GetCurrentClaimQuest() (reads GUI text
    -- PlayerGui.Main.Quest.Container.QuestTitle.Title.Text). Reading GUI text
    -- has real replication delay - after firing StartQuest, reading the GUI right
    -- on the next frame may still show the OLD quest name, making the comparison "CurrentClaim
    -- Quest1 ~= Q.NameMon" wrong and calling AbandonQuest right on the quest just taken.
    -- Remotes.QuestUpdate:OnClientEvent fires DIRECTLY from the server whenever the quest
    -- state changes - no polling, no delay.
    QuestController = {
        CurrentQuest = "",
        CurrentQuestName = "",
        QuestConnection = nil,
    }
    QuestController.Set = function(self, data)
        self.CurrentQuest = (function()
            for i, _ in next, data.Progress do
                return i
            end
        end)()
        self.CurrentQuestName = data.InternalQuestName
    end
    QuestController.Reset = function(self)
        self.CurrentQuest = ""
        self.CurrentQuestName = ""
    end
    local questConnectOk = pcall(function()
        QuestController.QuestConnection = Services.ReplicatedStorage.Remotes.QuestUpdate.OnClientEvent:Connect(function(a2, a3)
            if a2 and typeof(a2) == "table" then
                QuestController:Set(a2)
                return
            end
            QuestController:Reset()
        end)
    end)
    -- [FIXED] QuestController.CurrentQuestName is the QUEST name (e.g.
    -- "BanditQuest1"), DIFFERENT from GetCurrentClaimQuest() (the MOB name read from the GUI
    -- text) - the two cannot be compared with each other. HasActiveQuest()/GetActive
    -- QuestName() are kept separate, and if Remotes.QuestUpdate cannot be connected
    -- it returns nil so Start() falls back to GetCurrentClaimQuest() (comparing mob
    -- name as before) - do not mix the 2 kinds of names.
    function HasActiveQuestEvent()
        return questConnectOk and QuestController.QuestConnection ~= nil
    end
    function GetActiveQuestName()
        if not HasActiveQuestEvent() then return nil end
        if QuestController.CurrentQuest == "" then return false end
        return QuestController.CurrentQuestName
    end

