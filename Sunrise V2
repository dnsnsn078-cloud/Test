-- Farm-style proxy tween + Vxeze-style FloatForce/pinning.
-- The character itself is NOT directly tweened. An invisible anchored proxy
-- is tweened, then HRP is synced to it every physics step.
local tbl3 = { LastCall = 0 }
local TweenManager = { PauseUntil = 0 }
local MOVE_PROXY_NAME = "YELU0_OptimizedTweenPart"
local MoveState = {
    Tween = nil,
    Goal = nil,
    Proxy = nil,
    Active = false,
    Hold = false,
    HoldCFrame = nil,
    HoldWasAnchored = nil,
    Token = 0,
    Root = nil,
}

local function getCharacter()
    local c = localPlayer.Character or localPlayer.CharacterAdded:Wait()
    local hrp = c:WaitForChild("HumanoidRootPart")
    local hum = c:FindFirstChildOfClass("Humanoid") or c:WaitForChild("Humanoid")
    return c, hrp, hum
end

local function getTweenProxy()
    local p = workspace:FindFirstChild(MOVE_PROXY_NAME)
    if p and p:IsA("BasePart") then
        MoveState.Proxy = p
        return p
    end
    p = Instance.new("Part")
    p.Name = MOVE_PROXY_NAME
    p.Size = Vector3.one
    p.Anchored = true
    p.CanCollide = false
    p.CanTouch = false
    p.CanQuery = false
    p.CastShadow = false
    p.Massless = true
    p.Transparency = 1
    p.Parent = workspace
    MoveState.Proxy = p
    return p
end

local function addFloatForce(hrp)
    if not hrp then return end
    local force = hrp:FindFirstChild("FloatForce")
    if not force then
        force = Instance.new("BodyVelocity")
        force.Name = "FloatForce"
        force.Velocity = Vector3.zero
        force.MaxForce = Vector3.new(100000,100000,100000)
        force.P = 10000
        force.Parent = hrp
    else
        if force.Velocity.Magnitude > 0.01 then force.Velocity = Vector3.zero end
        local wantedForce = Vector3.new(100000,100000,100000)
        if force.MaxForce ~= wantedForce then force.MaxForce = wantedForce end
    end
end

local function removeFloatForce()
    local c = localPlayer.Character
    local hrp = c and c:FindFirstChild("HumanoidRootPart")
    if hrp then
        local force = hrp:FindFirstChild("FloatForce")
        if force then pcall(function() force:Destroy() end) end
        pcall(function()
            hrp.AssemblyLinearVelocity = Vector3.zero
            hrp.AssemblyAngularVelocity = Vector3.zero
        end)
    end
end

local NoclipCharacter = nil
local NoclipDescendantConnection = nil
local NoclipLastScan = 0
local NoclipScanInterval = 0.75
local NoclipOriginalCollision = setmetatable({}, {__mode = "k"})
local function disableNoclipPart(part)
    if not part or not part:IsA("BasePart") then return end
    if NoclipOriginalCollision[part] == nil then NoclipOriginalCollision[part] = part.CanCollide end
    if part.CanCollide then part.CanCollide = false end
end
local function clearCharacterNoclip()
    if NoclipDescendantConnection then
        pcall(function() NoclipDescendantConnection:Disconnect() end)
        NoclipDescendantConnection = nil
    end
    for part, original in pairs(NoclipOriginalCollision) do
        if part and part.Parent and original ~= nil then
            pcall(function() part.CanCollide = original end)
        end
    end
    table.clear(NoclipOriginalCollision)
    NoclipCharacter = nil
    NoclipLastScan = 0
end
local function setCharacterNoclip(character)
    if not character then return end
    if NoclipCharacter ~= character then
        clearCharacterNoclip()
        NoclipCharacter = character
        NoclipLastScan = 0
        NoclipDescendantConnection = character.DescendantAdded:Connect(function(part)
            task.defer(disableNoclipPart, part)
        end)
    end
    local now = os.clock()
    if now - NoclipLastScan < NoclipScanInterval then return end
    NoclipLastScan = now
    for _,part in ipairs(character:GetDescendants()) do
        disableNoclipPart(part)
    end
end

local function stopMove(keepForce)
    MoveState.Token += 1

    local tw = MoveState.Tween
    local holdRoot = MoveState.Root
    local wasHolding = MoveState.Hold
    local previousAnchored = MoveState.HoldWasAnchored

    -- Never leave the player anchored if a recovery/cancel happens.
    if wasHolding and holdRoot and holdRoot.Parent then
        pcall(function()
            holdRoot.Anchored = previousAnchored == true
            holdRoot.AssemblyLinearVelocity = Vector3.zero
            holdRoot.AssemblyAngularVelocity = Vector3.zero
        end)
    end

    MoveState.Tween = nil
    Runtime.CurrentTween = nil
    Runtime.TweenGoal = nil
    MoveState.Active = false
    MoveState.Hold = false
    MoveState.HoldCFrame = nil
    MoveState.HoldWasAnchored = nil
    MoveState.Root = nil

    if tw then
        pcall(function()
            tw:Cancel()
            tw:Destroy()
        end)
    end

    if not keepForce then
        removeFloatForce()
    end
end

local function cancelTween()
    stopMove(false)
end

TweenManager.CancelTweenOnly = cancelTween
TweenManager.CancelCurrent = cancelTween
StopTweenNow = cancelTween

local function beginPositionHold(cf)
    stopMove(true)
    local c, hrp, hum = getCharacter()
    if not hrp or not hum or hum.Health <= 0 then
        removeFloatForce()
        return false
    end

    MoveState.Token += 1
    MoveState.Active = true
    MoveState.Hold = true
    MoveState.HoldCFrame = cf or hrp.CFrame
    MoveState.HoldWasAnchored = hrp.Anchored
    MoveState.Root = hrp

    -- Hard local lock for the short Portal-C UI window. BodyVelocity alone was
    -- not enough when Portal C was cast from high above water.
    setCharacterNoclip(c)
    hrp.AssemblyLinearVelocity = Vector3.zero
    hrp.AssemblyAngularVelocity = Vector3.zero
    hrp.CFrame = MoveState.HoldCFrame
    hrp.Anchored = true
    return true
end

local function releasePositionHold()
    if MoveState.Hold then
        stopMove(false)
    end
end

