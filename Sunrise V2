-- Acquisition/prerequisite data used by the goal UI. This is intentionally separate
-- from task execution: the popup explains unmet requirements without silently disabling
-- a goal that may be able to work toward its prerequisite.
SUNRISE_ITEM_REQUIREMENTS = {}
local function SunriseDefineRequirement(name, category, groupSea, minSea, minLevel, beli, fragments, source, status, masteries, items, materials, warning)
    SUNRISE_ITEM_REQUIREMENTS[name] = {
        name=name, category=category, seaGroup=groupSea or minSea or 3, minSea=minSea or 1,
        minLevel=minLevel or 0, beli=beli or 0, fragments=fragments or 0,
        source=source or "Acquisition details not fully verified; ownership tracking only.",
        status=status or "available", masteries=masteries or {}, items=items or {},
        materials=materials or {}, warning=warning == true
    }
end
local function SunriseReqGroup(names, category, sea, source)
    for _, name in ipairs(names) do
        SunriseDefineRequirement(name, category, sea, sea, ({[1]=0,[2]=700,[3]=1500})[sea], 0, 0, source)
    end
end

