        function Group:Slider(def)
        	local lo, hi, step = def.Min or 0, def.Max or 100, def.Step or 1
        	local r, hl = self:_row(54)
        	label(r, {Text = def.Label, Position = UDim2.fromOffset(14, 8), Size = UDim2.new(1, -100, 0, 18), TextTruncate = Enum.TextTruncate.AtEnd})
        	local val = label(r, {AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -14, 0, 8), Size = UDim2.fromOffset(80, 18), TextXAlignment = Enum.TextXAlignment.Right, TextColor3 = T.sun, Font = BOLD, TextSize = 13})
        	local hit = new("TextButton", {Position = UDim2.new(0, 14, 0, 27), Size = UDim2.new(1, -28, 0, 26), BackgroundTransparency = 1, Text = "", AutoButtonColor = false}, r)
        	local track = new("Frame", {AnchorPoint = Vector2.new(0, .5), Position = UDim2.fromScale(0, .5), Size = UDim2.new(1, 0, 0, 4), BackgroundColor3 = T.track, BorderSizePixel = 0}, hit)
        	round(track, 2)
        	local fill = new("Frame", {Size = UDim2.fromScale(0, 1), BackgroundColor3 = WHITE, BorderSizePixel = 0}, track)
        	round(fill, 2); acc(fill, 0)
        	local knob = new("Frame", {AnchorPoint = Vector2.new(.5, .5), Position = UDim2.fromScale(1, .5), Size = UDim2.fromOffset(14, 14), BackgroundColor3 = WHITE, BorderSizePixel = 0}, fill)
        	round(knob, 7)
        	local halo = stroke(knob, T.sun, 0); halo.Transparency = .55
        	local cur
        	local function show(x)
        		cur = x
        		fill.Size = UDim2.fromScale(hi > lo and (x - lo) / (hi - lo) or 0, 1)
        		local ok, s
        		if type(def.Format) == "function" then ok, s = pcall(def.Format, x) else ok, s = pcall(string.format, def.Format or "%s", x) end
        		val.Text = ok and tostring(s) or tostring(x)
        	end
        	local apply = self:_bind(def, show, math.clamp(def.Default or lo, lo, hi))
        	local ui, page, down = self.ui, self.page, false
        	local function grow(g)
        		tween(knob, {Size = UDim2.fromOffset(g and 18 or 14, g and 18 or 14)}, .14, BACK)
        		tween(halo, {Thickness = g and 6 or 0}, .16)
        	end
        	local function fromX(x)
        		local t = math.clamp((x - track.AbsolutePosition.X) / math.max(track.AbsoluteSize.X, 1), 0, 1)
        		local n = math.clamp(lo + math.floor((t * (hi - lo)) / step + .5) * step, lo, hi)
        		n = tonumber(string.format("%.3f", n))
        		if n ~= cur then apply(n); ui:_snd("tick", .9 + t * .9) end
        	end
        	hover(hl, hit)
        	hit.InputBegan:Connect(function(i) if isPress(i) then down = true; page.ScrollingEnabled = false; grow(true); fromX(i.Position.X) end end)
        	ui:_c(UIS.InputChanged:Connect(function(i) if down and isMove(i) then fromX(i.Position.X) end end))
        	ui:_c(UIS.InputEnded:Connect(function(i) if down and isPress(i) then down = false; page.ScrollingEnabled = true; grow(false) end end))
        	return self:_reg(def, {Set = function(_, v) apply(v, true) end, Get = function() return cur end})
        end

        function Group:Dropdown(def)
        	local ui = self.ui
        	local box = new("Frame", {Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundTransparency = 1, BorderSizePixel = 0, LayoutOrder = nextOrder(self)}, self.body)
