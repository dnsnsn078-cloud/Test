    local function SunriseQueueInventorySnapshot(force)
        local now = os.clock()
        if SunriseRemoteInventoryFetchBusy or (not force and now - SunriseRemoteInventoryFetchAt < 8) then return end
        SunriseRemoteInventoryFetchAt = now
        SunriseRemoteInventoryFetchBusy = true
        task.spawn(function()
            local ok, response = pcall(function()
                return game:GetService("ReplicatedStorage").Remotes.CommF_:InvokeServer("getInventory")
            end)
            if ok and type(response) == "table" then
