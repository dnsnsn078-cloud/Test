    local function SunriseDracoBlueBeltStep()
        local now = os.clock()
        SunriseDracoSeaProfile(nil)
        if sunriseDracoBlueDropAt > 0 then
            if now - sunriseDracoBlueDropAt < 20 then
                SetTask("MainTask", "Auto Draco | Blue Belt: fruit dropped; checking trainer progress")
                return
            end
            sunriseDracoBlueDropAt = 0
            sunriseDracoBlueFruit = nil
            sunriseDracoQuestAt = 0
            sunriseDracoQuestCache = nil
        end

        -- A dropped fruit is a direct Workspace child. Once it is picked up its
        -- Parent changes to Backpack/Character, which must go through the drop-back
        -- branch below rather than repeatedly touching a Handle inside the inventory.
        if sunriseDracoBlueFruit and sunriseDracoBlueFruit.Parent == workspace then
            if now - sunriseDracoBlueWaitAt > 45 then
                sunriseDracoBlueFruit = nil
                SetTask("MainTask", "Auto Draco | Blue Belt: pickup did not register; searching another server")
                SunriseDracoHopForBlueFruit()
                return
            end
            local handle = sunriseDracoBlueFruit:FindFirstChild("Handle")
            if handle then
                SetTask("MainTask", "Auto Draco | Blue Belt: picking up " .. sunriseDracoBlueFruit.Name)
                SunriseDracoTouchPart(handle)
                return
            end
        end
        if sunriseDracoBlueFruit and sunriseDracoBlueFruit.Parent ~= workspace then
            -- The Tool left Workspace, so find the picked fruit in the player's inventory.
            local pickedName = sunriseDracoBlueFruit.Name
            local backpack = LocalPlayer:FindFirstChildOfClass("Backpack") or LocalPlayer:FindFirstChild("Backpack")
            local character = LocalPlayer.Character
            local pickedTool
            for _, container in ipairs({backpack, character}) do
                if container then
                    for _, obj in ipairs(container:GetChildren()) do
                        if obj:IsA("Tool") and (obj.Name == pickedName or (obj:GetAttribute("OriginalName") and tostring(obj:GetAttribute("OriginalName")) == pickedName)) then
                            pickedTool = obj; break
                        end
                    end
                end
                if pickedTool then break end
            end
            if pickedTool then
                if not SunriseDracoFindNearbyPlayer(100) and now - sunriseDracoBlueWaitAt < 50 then
                    SetTask("MainTask", "Auto Draco | Blue Belt: fruit collected; waiting for a player nearby before returning it")
                    return
                end
                local char = LocalPlayer.Character
                local hum = char and char:FindFirstChildOfClass("Humanoid")
                if hum and pickedTool.Parent ~= char then pcall(function() hum:EquipTool(pickedTool) end); task.wait(0.15) end
                local eatRemote = pickedTool:FindFirstChild("EatRemote", true)
                if eatRemote and eatRemote:IsA("RemoteFunction") then
                    SetTask("MainTask", "Auto Draco | Blue Belt: dropping the received fruit back")
                    local dropped = pcall(function() eatRemote:InvokeServer("Drop") end)
                    if dropped then
                        sunriseDracoBlueDropAt = now
                        sunriseDracoQuestAt = 0
                        sunriseDracoQuestCache = nil
                    end
                    return
                end
            end
            -- If the Tool is removed but is not in our inventory, wait briefly for
            -- replication. If it never arrives, release the stale reference and resume
            -- server search rather than getting stuck forever.
            if now - sunriseDracoBlueWaitAt > 25 then
                sunriseDracoBlueFruit = nil
                SetTask("MainTask", "Auto Draco | Blue Belt: fruit pickup did not replicate; searching again")
                SunriseDracoHopForBlueFruit()
                return
            end
            SetTask("MainTask", "Auto Draco | Blue Belt: waiting for fruit pickup to replicate")
            return
        end

        local fruit, handle = SunriseDracoFindGroundTool("Fruit")
        if fruit and handle then
            sunriseDracoBlueFruit = fruit
            sunriseDracoBlueWaitAt = now
            SetTask("MainTask", "Auto Draco | Blue Belt: found dropped fruit " .. fruit.Name)
            SunriseDracoTouchPart(handle)
        else
            SetTask("MainTask", "Auto Draco | Blue Belt: searching this server for a dropped fruit")
            SunriseDracoHopForBlueFruit()
        end
    end

