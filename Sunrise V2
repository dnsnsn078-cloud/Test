            -- the loop on getInventoryFruits; some clients return nil for that call.
            -- The queue/cursor are local to this script session and are rebuilt when
            -- Auto Raid is toggled, the script is relaunched, or a new fruit is stored.
            local limit = tonumber(Config.Raid.MaxFruitPrice) or 1000000
            if raidFruitQueue and raidQueueLimit == limit then return raidFruitQueue end

            local okCatalog, catalog = pcall(function()
                return Remotes.CommF_:InvokeServer("GetFruits")
            end)
            if not okCatalog or type(catalog) ~= "table" then return nil end

            local out, seen = {}, {}
            for _, fruit in pairs(catalog) do
                if type(fruit) == "table" then
                    local key = tostring(fruit.Name or fruit.name or "")
                    local price = tonumber(fruit.Price or fruit.price)
                    if key ~= "" and price and price < limit and not seen[key] then
                        seen[key] = true
                        -- Stored fruit keys are normally "Name-Name". Extract the
                        -- exact repeated name first (handles variants like T-Rex and
                        -- Bird: Phoenix) before using the display-name lookup fallback.
                        local base = key:match("^(.-)%-%1$")
                        if not base then
                            local info = S.FruitInfo(key)
                            base = info and info.name and info.name ~= "???" and info.name or key
                        end
                        out[#out + 1] = {name = key, price = price, base = base}
                    end
                end
            end
            table.sort(out, function(a, b)
                if a.price == b.price then return a.name < b.name end
                return a.price < b.price
