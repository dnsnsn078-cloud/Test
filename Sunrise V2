    function RefreshInventory()
        SunriseInvalidateItemCheckCache()
        ScriptStorage.Backpack = {}
        local LP = game.Players.LocalPlayer
        local ok, Items = pcall(function() return require(game.ReplicatedStorage.ItemReplicationService)._UserCache[LP.UserId] end)
        if not ok or not Items then
            -- If the local replication cache is unavailable, a single getInventory call
            -- supplies both Sunrise's inventory table and the completion-check cache.
            local invOk, inventory = pcall(function()
                return game:GetService("ReplicatedStorage").Remotes.CommF_:InvokeServer("getInventory")
            end)
            if invOk and type(inventory) == "table" then
                local snapshot = {}
                for _, item in pairs(inventory) do
                    if type(item) == "table" and type(item.Name) == "string" then
                        ScriptStorage.Backpack[item.Name] = item
                        snapshot[item.Name] = item
                    end
                end
                SunriseRemoteInventoryCache = snapshot
                SunriseRemoteInventoryFetchAt = os.clock()
                SunriseInvalidateItemCheckCache()
            end
            return
        end
        local Q = Items:GetItems("Quantity")
        local M = Items:GetItems("Mastery")
        local C = require(game.ReplicatedStorage.ItemConfig)
        local W = require(game.ReplicatedStorage.Modules.CombatUtil)
        local mas = {}
        if M then for _, v in pairs(M) do mas[v.ItemId] = v.Value end end
        local function clean(s) return s:gsub(" %[.-%]", "") end
        for _, v in pairs(Q) do
            local id, qt = v.ItemId, v.Value
            local ty, dn = "?", ""
            pcall(function()
                local c = C.match(id):unwrap()
                if c and c.Index then ty = c.Index.IdType; dn = c.Index.DebugLabel end
            end)
            local name = clean(dn)
            if name ~= "" then
                local entry = {Name = name, Count = qt, ItemId = id}
                ScriptStorage.Backpack[name] = entry
                if ty == "Moveset" or ty == "PhysicalMoveset" then
                    local md = mas[id]
                    if md then
                        local wd = W:GetWeaponData(name)
                        if wd then
                            if tostring(wd.WeaponType):find("Sword") then
                                entry.Type = "Sword"
                                entry.Mastery = md
                                entry.MasteryRequirements = {[1] = 350}
                            else
                                SunriseSetMeleeMasteryAliases(name, md)
                            end
                        end
                    end
                end
            end
        end
        -- Some learned styles appear in the Mastery table even when their Quantity
        -- entry is not returned. Resolve those IDs through ItemConfig and preserve
        -- their mastery under both legacy and current style names.
        if M then
            for _, item in pairs(M) do
                if type(item) == "table" then
                    local id, mastery = item.ItemId, item.Value
                    if id ~= nil and mastery ~= nil then
                        local itemType, debugName = "?", ""
                        pcall(function()
                            local configEntry = C.match(id):unwrap()
                            if configEntry and configEntry.Index then
                                itemType = configEntry.Index.IdType
                                debugName = configEntry.Index.DebugLabel
                            end
                        end)
                        local styleName = clean(tostring(debugName or ""))
                        if styleName ~= "" and (itemType == "Moveset" or itemType == "PhysicalMoveset") then
                            local weaponData
                            pcall(function() weaponData = W:GetWeaponData(styleName) end)
                            if weaponData and not tostring(weaponData.WeaponType):find("Sword", 1, true) then
                                SunriseSetMeleeMasteryAliases(styleName, mastery)
                                if not ScriptStorage.Backpack[styleName] then
                                    ScriptStorage.Backpack[styleName] = {
                                        Name = styleName, Count = 1, ItemId = id, Type = "Melee", Mastery = mastery
                                    }
                                end
                            end
                        end
                    end
                end
            end
        end
        -- Supplement the local ItemReplicationService list without blocking this refresh.
        SunriseQueueInventorySnapshot(false)
    end
