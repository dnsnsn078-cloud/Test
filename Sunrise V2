    local function SunriseDracoHopForBlueFruit()
        local now = os.clock()
        if now - sunriseDracoLastBlueHopAt < 65 then return end
        sunriseDracoLastBlueHopAt = now
        local ok, servers = pcall(function() return GetServers() end)
        local bestId, bestCount
        if ok and type(servers) == "table" then
            for jobId, data in pairs(servers) do
                local count = type(data) == "table" and tonumber(data.Count) or 99
                if jobId ~= game.JobId and not sunriseDracoHopVisited[jobId] and count and count < 12 then
                    if not bestCount or count < bestCount then bestId, bestCount = jobId, count end
                end
            end
        end
        SetTask("MainTask", "Auto Draco | Blue Belt: no dropped fruit here; hopping to look in another server")
        if bestId then
            sunriseDracoHopVisited[bestId] = true
            local browser = game:GetService("ReplicatedStorage"):FindFirstChild("__ServerBrowser")
            if browser then
                local hopOk = pcall(function() browser:InvokeServer("teleport", bestId) end)
                if hopOk then return end
            end
        end
        -- Use Sunrise's existing server-list hopper as a fallback, but never hop after
        -- a fruit has already been picked up; un-stored fruits can be lost on rejoin.
        if type(Hop) == "function" then pcall(function() Hop(12) end) end
