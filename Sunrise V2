    FunctionsHandler.DracoRaceTask:RegisterMethod("Start", function()
        if not (Config.Goals and Config.Goals.AutoDraco) then SunriseDracoSeaProfile(nil); return end
        if SeaIndex ~= 3 then
            SunriseDracoSeaProfile(nil)
            SetTask("MainTask", "Auto Draco | traveling to Third Sea")
            pcall(function() Remotes.CommF_:InvokeServer("TravelZou") end)
            return
        end
        local now = os.clock()
        if now - sunriseDracoLastInventoryAt >= 8 then
            sunriseDracoLastInventoryAt = now
            pcall(RefreshInventory)
        end
        local stage = tonumber(Config.Goals.AutoDracoStage) or 1
        local race = SunriseRaceValue()
        if race == "Draco" and stage < 2 then
            stage = 2
            Config.Goals.AutoDracoStage = 2
            queueSave()
        end

        -- A previously unlocked Draco can be re-equipped without spending another Egg.
        if race ~= "Draco" and stage >= 2 then
            SunriseDracoSeaProfile(nil)
            local switched = SunriseDracoWizardStep("DragonRace", "switching to Draco")
            if SunriseRaceValue() == "Draco" then SetTask("MainTask", "Auto Draco | ✅ Draco selected") end
            return
        end

        -- All Dojo belts require 500 Dragon Talon mastery before the Dragon Tether / Egg route.
        if stage <= 1 then
            local mastery = tonumber(ScriptStorage.Melees and ScriptStorage.Melees["Dragon Talon"]) or 0
            local entry = ScriptStorage.Backpack and ScriptStorage.Backpack["Dragon Talon"]
            if entry and type(entry) == "table" then mastery = math.max(mastery, tonumber(entry.Mastery) or 0) end
            local blackBelt = CheckItem("Dojo Belt (Black)")
            local eggCount = SunriseDracoItemCount("Dragon Egg")
            if not blackBelt then
                local progress = SunriseDracoQuestState(false)
                local belt = SunriseDracoBelt(progress)
                if not belt then
