		if type(hint) == "table" and (hint.Boss or hint.Island) then
			local neededQuest = nil
			for _, quest in ipairs(HiddenQuests) do
				local key = "Sea1/" .. quest.Island .. "/" .. quest.Name
				if progress[key] ~= true and quest.BossNames
