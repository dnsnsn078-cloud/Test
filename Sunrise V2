    local function tweenStopRequested()
        return _G.Stop == true and not (Config and Config.Raid and Config.Raid.Enabled)
    end
    local block -- forward declaration so Cancel() can reposition the active tween target
    local originalTweenCollisions = setmetatable({}, {__mode = "k"})
    local function restoreTweenPhysics(releaseCharacter)
        local character = game.Players.LocalPlayer.Character
        if character then
            for part, original in pairs(originalTweenCollisions) do
                if part and part.Parent and part:IsA("BasePart") then
                    pcall(function() part.CanCollide = original end)
                end
                originalTweenCollisions[part] = nil
            end
            local head = character:FindFirstChild("Head")
            local hold = head and head:FindFirstChild("eltrul")
            if hold then pcall(function() hold:Destroy() end) end
            local hum = character:FindFirstChildOfClass("Humanoid")
            if hum then pcall(function() hum.PlatformStand = false end) end
            local root = character:FindFirstChild("HumanoidRootPart")
            if releaseCharacter and root then
                -- This controller never intentionally anchors the player. Release any stale
                -- anchor/velocity state so an interrupted tween falls under normal gravity.
                pcall(function()
                    root.Anchored = false
                    root.AssemblyLinearVelocity = Vector3.zero
                    root.AssemblyAngularVelocity = Vector3.zero
                end)
                if hum then
                    pcall(function()
                        if hum.FloorMaterial == Enum.Material.Air then
                            hum:ChangeState(Enum.HumanoidStateType.Freefall)
                        else
                            hum:ChangeState(Enum.HumanoidStateType.Running)
                        end
                    end)
                end
            end
        else
            table.clear(originalTweenCollisions)
        end
    end

