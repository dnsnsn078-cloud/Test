    function S.loaderString(resumeFinder)
        local url = Config.AutoExec.Url
        if type(url) ~= "string" or url == "" then return nil end
        local urlLiteral = string.format("%q", url)
        -- Queue-on-teleport loaders carry a one-shot marker; persistent autoexec
        -- loaders wait briefly so a queued Finder continuation wins the race.
        local resumeLine = resumeFinder and '    g.SunriseResumeFruitFinder = true\n' or ''
        local startupDelay = resumeFinder and '' or '    task.wait(2)\n'
        local alreadyLoadedCheck = resumeFinder and '' or '    if g.SunriseMainJobId == tostring(game.JobId) then return end\n'
        return 'task.spawn(function()\n'
            .. '    repeat task.wait(0.5) until game:IsLoaded()\n'
            .. '    local g = (type(getgenv) == "function" and getgenv()) or _G\n'
            .. startupDelay
            .. alreadyLoadedCheck
            .. resumeLine
            .. '    g.SunriseURL = ' .. urlLiteral .. '\n'
            .. '    local ok, err = pcall(function()\n'
            .. '        local source = game:HttpGet(' .. urlLiteral .. ')\n'
            .. '        local fn, compileErr = loadstring(source)\n'
            .. '        if not fn then error(compileErr or "loadstring failed") end\n'
            .. '        fn()\n'
            .. '    end)\n'
            .. '    if not ok then warn("[Sunrise AutoExec] " .. tostring(err)) end\n'
            .. 'end)'
    end
    function S.queueOnTeleport()
        local resumeFinder = Config.Mode == "FruitFinder" and S.Finder and S.Finder.Running == true
        local src = S.loaderString(resumeFinder)
        if not src then return false end
        local env = type(getgenv) == "function" and getgenv() or _G
        local candidates = {}
        local function addQueue(fn) if type(fn) == "function" then candidates[#candidates + 1] = fn end end
        addQueue(env and env.queue_on_teleport)
        addQueue(queue_on_teleport)
        addQueue(syn and syn.queue_on_teleport)
        addQueue(queueonteleport)
        addQueue(fluxus and fluxus.queue_on_teleport)
        for _, queueFn in ipairs(candidates) do
            local ok = pcall(queueFn, src)
            if ok then return true end
        end
        return false
    end
