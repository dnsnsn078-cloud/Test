            queueAutoSCMeleeSecret("Fishman Karate")
            ensureAutoSCForMeleePrerequisite()
            return false
        end
        if allMode then return true end
        if selected[name] == true then return true end
        -- If the chosen target has prerequisites, include those styles in the route
        -- automatically so an individual goal does not deadlock waiting for them.
        local prerequisites = {
            ["Death Step"] = {"Black Leg"}, ["Sharkman Karate"] = {"Fishman Karate"},
            ["Electric Claw"] = {"Electro"}, ["Dragon Talon"] = {"Dragon Claw"},
            ["Superhuman"] = {"Black Leg", "Electro", "Fishman Karate", "Dragon Claw"},
            ["Godhuman"] = {"Black Leg", "Electro", "Fishman Karate", "Dragon Claw", "Superhuman", "Death Step", "Sharkman Karate", "Electric Claw", "Dragon Talon"},
        }
        for target, deps in pairs(prerequisites) do
            if selected[target] then
                for _, dep in ipairs(deps) do if dep == name then return true end end
            end
        end
        return false
    end
    local function hasAnyMeleeGoal()
        if not Config.Melee.AutoBuy then return false end
        if Config.Items.AutoFullyMelees then return true end
        for _, name in ipairs({"Black Leg", "Electro", "Fishman Karate", "Dragon Claw", "Superhuman", "Death Step", "Sharkman Karate", "Electric Claw", "Dragon Talon", "Godhuman", "Sanguine Art"}) do
            if Config.Items.MeleeGoals and Config.Items.MeleeGoals[name] then return true end
        end
        return false
    end
    local function SunriseSanguineMaterialCount(name)
        local row = ScriptStorage.Backpack and ScriptStorage.Backpack[name]
        if type(row) == "table" then return tonumber(row.Count or row.Quantity or row.Value) or 0 end
        return tonumber(row) or 0
    end
    local function SunriseShouldYieldForManualSanguinePrerequisite()
        if not meleeGoalEnabled("Sanguine Art") or CheckItem("Sanguine Art") then return false end
        -- Keep obtaining the other requested styles first. Once those are done and all
        -- farmable Sanguine materials are collected, yield to other controllers until
        -- the player manually brings back the Leviathan Heart / currencies.
        for _, name in ipairs({"Black Leg", "Electro", "Fishman Karate", "Dragon Claw", "Superhuman", "Death Step", "Sharkman Karate", "Electric Claw", "Dragon Talon", "Godhuman"}) do
            if meleeGoalEnabled(name) and not CheckItem(name) then return false end
        end
        if SunriseSanguineMaterialCount("Demonic Wisp") < 20
            or SunriseSanguineMaterialCount("Vampire Fang") < 20
            or SunriseSanguineMaterialCount("Dark Fragment") < 2 then return false end
        local hasHeart = SunriseSanguineMaterialCount("Leviathan Heart") >= 1 or CheckItem("Leviathan Heart")
        local hasBeli = (ScriptStorage.PlayerData.Beli or 0) >= 5000000
        local hasFragments = (ScriptStorage.PlayerData.Fragments or 0) >= 5000
        return not hasHeart or not hasBeli or not hasFragments
    end

