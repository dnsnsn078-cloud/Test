local function FindQuest(name)
    for _,q in ipairs(HiddenQuests or {}) do if q.Name==name then return q end end
end
local XMarkQuest = FindQuest("X Marks The Spot")
local EarlyAccessQuest = FindQuest("Early Access")

local function hasTreasureMapTool()
    local c=localPlayer.Character
    return localPlayer.Backpack:FindFirstChild("Treasure Map") ~= nil or (c and c:FindFirstChild("Treasure Map") ~= nil)
end

local function findTreeM1()
    local map=workspace:FindFirstChild("Map")
    local town=map and map:FindFirstChild("Town")
    local tree=town and town:FindFirstChild("Tree")
    if not tree then return nil end
    local best,dist
    local _,hrp=getCharacter()
    for _,p in ipairs(CollectionService:GetTagged("M1HitRegistry")) do
        if p:IsA("BasePart") and p:IsDescendantOf(tree) then
            local d=(p.Position-hrp.Position).Magnitude
            if not dist or d<dist then best,dist=p,d end
        end
    end
    return best, tree
end

if XMarkQuest then
    XMarkQuest.Run = function(moment)
        Runtime.Mode="SECRET"
        Runtime.Step="XMark"
        if not moment then
            Runtime.XMark.treeSince=nil
            return "Waiting for X Marks The Spot moment", true
        end
        local state = moment.MiscData and moment.MiscData._xMarksTheSpotState
        if not state then
            if tick()-(Runtime.XMark.initAt or 0)>2 then
                Runtime.XMark.initAt=tick(); pcall(function() moment:FireServer("Initialize") end)
            end
            return "Initialize treasure map state"
        end
        local stage=tostring(state.stage or "Tree")
        Runtime.Step=stage

        if stage=="Tree" then
            local part,tree=findTreeM1()
            if not tree then Runtime.XMark.treeSince=nil; return "Waiting for Middle Town tree to stream", true end
            if not part then
                Runtime.XMark.treeSince=Runtime.XMark.treeSince or tick()
                local elapsed=tick()-Runtime.XMark.treeSince
                Runtime.Status=("XMark Tree scan %.1f/6s"):format(math.min(elapsed,6))
                if elapsed>=6 then
                    Runtime.XMark.treeSince=nil
                    HopHiddenServer("XMark tree unavailable after 6s")
                end
                return "Scanning XMark tree target", false
            end
            Runtime.XMark.treeSince=nil
            if localPlayer:DistanceFromCharacter(part.Position)>11 then
                HiddenMove(part.CFrame*CFrame.new(0,0,6)); return "Go to XMark tree"
            end
            HiddenHold(localPlayer.Character.HumanoidRootPart.CFrame)
            EquipHiddenWeapon("Melee")
            if os.clock()-Runtime.XMark.lastHit>=0.35 then
                Runtime.XMark.lastHit=os.clock(); Runtime.XMark.hits+=1
                pcall(function() HiddenModules.RegisterAttack:FireServer(0.3) end)
                pcall(function() HiddenModules.RegisterHit:FireServer(part) end)
                local melee=NameWeapon("Melee",true); if melee then pcall(function() melee:Activate() end) end
                if Runtime.XMark.hits>=10 then
                    Runtime.XMark.hits=0
                    pcall(function() moment:FireServer("Initialize") end)
                end
            end
            if hasTreasureMapTool() then return "Treasure Map obtained; waiting for state" end
            return "Shake XMark tree until Treasure Map drops"
        end

        Runtime.XMark.hits=0
        if stage=="Pickup" then
            if state.pickupCFrame then
                if HiddenSettle(state.pickupCFrame.Position+Vector3.new(0,2,0),6) then
                    pcall(function() moment:FireServer("PickupMap") end); task.wait(0.4)
                end
                return "Pick up Treasure Map"
            end
            return "Waiting for Treasure Map drop"
        elseif stage=="Map" then
            if state.mapPieceCFrame then
                if HiddenSettle(state.mapPieceCFrame.Position+Vector3.new(0,2,0),6) then
                    pcall(function() moment:FireServer("CollectCheckpoint") end); task.wait(0.35)
                end
                return "Collect broken map piece #"..tostring((state.checkpointIndex or 0)+1)
            end
            return "Waiting for next map piece"
        elseif stage=="Dig" then
            if state.targetCFrame then
                local target = workspace:FindFirstChild("_WorldOrigin") and workspace._WorldOrigin:FindFirstChild("PersistentParts") and workspace._WorldOrigin.PersistentParts:FindFirstChild("X Marks The Spot")
                target = (target and target:IsA("BasePart") and target) or FindTaggedPartNear(state.targetCFrame.Position,10)
                if target then HitHiddenPart(target) else HiddenGoTo(state.targetCFrame.Position+Vector3.new(0,3,5),6) end
                return "Dig at the X "..tostring(state.hits or 0).."/3"
            end
            return "Waiting for dig location"
        elseif stage=="Chest" then
            local persistent=workspace:FindFirstChild("_WorldOrigin") and workspace._WorldOrigin:FindFirstChild("PersistentParts")
            local chest=persistent and persistent:FindFirstChild("Buried Treasure")
            local prompt=chest and chest:FindFirstChildWhichIsA("ProximityPrompt",true)
            if prompt and HiddenSettle(prompt.Parent.Position+Vector3.new(0,2,3),6) then
                pcall(function() fireproximityprompt(prompt) end); task.wait(0.5)
            end
            return "Open Buried Treasure"
        elseif stage=="Enemies" then
            local enemy=FindHiddenEnemy({"Desert Skeleton"}, state.targetCFrame and state.targetCFrame.Position or localPlayer.Character:GetPivot().Position,300)
            if enemy then KillHiddenEnemy(enemy) end
            return "Defeat treasure guards with "..Settings["Select Weapon"]
        elseif stage=="Completing" then
            return "Completing X Marks The Spot"
        end
        return "XMark stage: "..stage
    end
end

-- Early Access P0: poll the server globally through the same remote wrapper used by
-- BonusMomentsController. This allows Developer/Early Access to preempt from any island.
local BonusMomentRF = ReplicatedStorage.Remotes:WaitForChild("BonusMomentsRemoteFunction")
local EarlyAccessProxy = {}
function EarlyAccessProxy:InvokeServer(...)
    return BonusMomentRF:InvokeServer("Early Access", ...)
end
local function TryEarlyAccessP0(progress)
    if not EarlyAccessQuest then return false end
    if progress["Sea1/Middle Town/Early Access"]==true then return false end
    HiddenEvent.earlyAccess = HiddenEvent.earlyAccess or {time=0}
    local cache=HiddenEvent.earlyAccess
    if tick()-(cache.time or 0)>3 then
        cache.time=tick()
        local ok1,available=pcall(function() return EarlyAccessProxy:InvokeServer("IsAvailable") end)
        local ok2,stage=pcall(function() return EarlyAccessProxy:InvokeServer("GetState") end)
        if ok1 then cache.available=available==true end
        if ok2 and tonumber(stage) then cache.stage=tonumber(stage) end
    end
    local stage=tonumber(cache.stage) or 0
    if not cache.available and stage<=0 then return false end
    HiddenEvent.current="Early Access"
    HiddenEvent.currentIsland="Middle Town"
    Runtime.Mode="P0 EARLY ACCESS"
    Runtime.Step="Stage "..stage
    local text,waiting=EarlyAccessQuest.Run(EarlyAccessProxy)
    SetHiddenStep(text or "Early Access")
    Runtime.Status=text or "Early Access"
    return true
end

-- The Finale (#40): the decompiled WorldTeleporter UI sends only CompleteMap once all
-- 39 BonusMoments are complete, so we invoke the same server request after moving to it.
local WorldTeleporterRF
pcall(function() WorldTeleporterRF=require(ReplicatedStorage.Modules.Net):RemoteFunction("WorldTeleporter") end)
local function RunFinale()
    Runtime.Mode="FINALE"
    Runtime.Step="Gateway"
    HiddenEvent.current="The Finale"
    SetHiddenStep("Complete the World Teleporter map")
    local data=localPlayer:FindFirstChild("Data")
    local level=data and data:FindFirstChild("Level")
    if localPlayer:GetAttribute("CompletedMap")==true or (level and level.Value>=3000) then
        Runtime.Mode="COMPLETE"; Runtime.Step="40/40"; Runtime.Status="Level 3000 reached"
        SaveSettings("Auto Secret Quest",false); Runtime.Enabled=false; cancelTween()
        return true
    end
    local tp=CollectionService:GetTagged("WORLD_TELEPORTER")[1]
    if not tp then Runtime.Status="Waiting for Middle Town World Teleporter"; HiddenGoToIsland("Middle Town"); return true end
    local anchor=tp:FindFirstChild("Smokes") or tp:FindFirstChildWhichIsA("BasePart",true)
    if anchor and localPlayer:DistanceFromCharacter(anchor.Position)>20 then
        HiddenMove(CFrame.new(anchor.Position+Vector3.new(0,3,0))); Runtime.Status="Going to The Finale gateway"; return true
    end
    if localPlayer:GetAttribute("UnlockedGateways")~=true then
        Runtime.Status="Gateway prerequisite not replicated yet (UnlockedGateways=false)"; return true
    end
    if WorldTeleporterRF and tick()-Runtime.FinaleLastRequest>3 then
        Runtime.FinaleLastRequest=tick()
        Runtime.Status="Sending CompleteMap"
        pcall(function() WorldTeleporterRF:InvokeServer({Type="GetLocations"}) end)
        local ok,res=pcall(function() return WorldTeleporterRF:InvokeServer({Type="CompleteMap"}) end)
        if ok and type(res)=="table" and res.ErrMessage then Runtime.Status="Finale: "..tostring(res.ErrMessage) end
        HiddenEvent.checked=0
    end
    return true
end


FindNeededAwakenedQuest = function(progress, hint)
    if type(hint) ~= "table" or not hint.Boss or not hint.Island then
        return nil
    end

    for _, quest in ipairs(HiddenQuests or {}) do
        local key = "Sea1/" .. quest.Island .. "/" .. quest.Name
        if progress[key] ~= true and quest.BossNames
            and IsHiddenBossHinted(hint, quest.HintIsland or quest.Island, quest.BossNames)
        then
            return quest
        end
    end

    return nil
end

local function HasMatchingActiveAwakenedBoss(quest)
    if not quest or not quest.BossNames then return false end

    for _, enemy in ipairs(workspace.Enemies:GetChildren()) do
        if enemy:GetAttribute("BossIndicatorAwakened") and IsHiddenTarget(enemy) then
            for _, bossName in ipairs(quest.BossNames) do
                if string.find(enemy.Name, bossName, 1, true) then
                    return true
                end
            end
        end
    end

    return false
end

local function TryNeededAwakenedHold(progress)
    -- A started ordinary Secret wins over an upcoming awakened boss.
    if IsHiddenTaskLockValid(progress) then
        return false
    end

    local minute = os.date("!*t").min
    if minute < 50 or minute > 58 then
        HiddenEvent.neededBossHold = nil
        return false
    end

    local hint = GetHiddenRaidHint()
    local quest = FindNeededAwakenedQuest(progress, hint)

    if not quest then
        HiddenEvent.neededBossHold = nil
        return false
    end

    -- If the awakened boss is already physically spawned, let the mature
    -- scheduler take over immediately so it can fight / execute the Secret.
    if HasMatchingActiveAwakenedBoss(quest) then
        HiddenEvent.neededBossHold = nil
        HiddenEvent.deadHourIdleSince = nil
        return false
    end

    HiddenEvent.neededBossHold = quest.Name
    HiddenEvent.deadHourIdleSince = nil
    HiddenEvent.hopAt = nil
    HiddenEvent.current = quest.Name
    HiddenEvent.currentIsland = quest.Island

    local boss = tostring(hint.Boss or "?")
    local state = tostring(hint.State or "?")
    local seconds = math.max(0, math.floor(tonumber(hint.Seconds) or 0))

    Runtime.Mode = "BOSS HOLD"
    Runtime.Step = quest.Name
    Runtime.Status =
        "Needed awakened " .. boss
        .. " | " .. state
        .. " | " .. seconds .. "s"
        .. " | staying in server"

    SetHiddenStep(
        "Needed=YES " .. boss
        .. " -> " .. quest.Name
        .. " | WAIT " .. seconds .. "s | NO HOP"
    )

    local logKey = boss .. "|" .. state .. "|" .. tostring(math.floor(seconds / 10))
    if Runtime.LastNeededBossHoldLog ~= logKey then
        Runtime.LastNeededBossHoldLog = logKey
        print(
            "[YELU0/Hidden][Awakened] NEEDED HOLD -> "
            .. boss .. "@" .. tostring(hint.Island)
            .. " State=" .. state
            .. " T=" .. seconds .. "s"
            .. " -> " .. quest.Name
            .. " | STAY SERVER / NO HOP"
        )
    end

    -- Park at the correct island while waiting, but do not constantly bounce
    -- between other ordinary tasks.
    if HiddenGoToIsland(quest.Island) then
        local island = GetHiddenIsland(quest.Island)
        local world = island and island.World
        if world then
            HiddenHold(world.CFrame * CFrame.new(0, 30, 0))
        end
    end

    return true
end

-- Manual-order support. Selected tasks are attempted in the user's click order; incomplete
-- prerequisite tasks are inserted immediately before the selected task that needs them.
local function BuildManualSelection(progress)
    local queue = HiddenEvent.manualSelectionOrder
    if type(queue) ~= "table" or #queue == 0 then return nil, nil end
    local byName = {}
    for _, quest in ipairs(HiddenQuests or {}) do
        if type(quest) == "table" and type(quest.Name) == "string" then byName[quest.Name] = quest end
    end
    local allowed, ranks = {}, {}
    local function addTaskAndPrerequisites(name, rank, visiting)
        local quest = byName[name]
        if not quest then return end
        local key = "Sea1/" .. tostring(quest.Island) .. "/" .. tostring(quest.Name)
        if progress and progress[key] == true then return end
        if visiting[name] then return end
        visiting[name] = true
        if quest.Requires and (not progress or progress[quest.Requires] ~= true) then
            local requiredName = tostring(quest.Requires):match("([^/]+)$")
            if requiredName then addTaskAndPrerequisites(requiredName, rank - 0.01, visiting) end
        end
        visiting[name] = nil
        allowed[name] = true
        if ranks[name] == nil or rank < ranks[name] then ranks[name] = rank end
    end
    for index, name in ipairs(queue) do
        if name ~= "The Finale" then addTaskAndPrerequisites(name, index, {}) end
    end
    return allowed, ranks
end

-- wrapper around the mature 39-secret scheduler
local BaseAutoHiddenEvent=AutoHiddenEvent
AutoHiddenEvent=function()
    local progress=GetHiddenProgress()
    local done=CountSecretDone(progress)
    local manualQueue = HiddenEvent.manualSelectionOrder
    local manualMode = type(manualQueue) == "table" and #manualQueue > 0
    local manualChosen = HiddenEvent.manualSelectedSet or {}

    if done>=39 then
        if manualMode and not manualChosen["The Finale"] then
            HiddenEvent.current = nil
            Runtime.Mode="SECRET"
            Runtime.Status="39/39 secrets complete; select The Finale to finish"
            SetHiddenStep("The Finale is not selected")
            return
        end
        return RunFinale()
    end

    if manualMode then
        local allowed, ranks = BuildManualSelection(progress)
        HiddenEvent.manualAllowedTasks = allowed or {}
        HiddenEvent.manualOrderRanks = ranks or {}
        if not next(HiddenEvent.manualAllowedTasks) then
            HiddenEvent.current = nil
            Runtime.Mode="SECRET"
            Runtime.Status="Selected secret quests are complete (or only The Finale is selected)"
            SetHiddenStep("Waiting for a selected task")
            return
        end
    else
        HiddenEvent.manualAllowedTasks = nil
        HiddenEvent.manualOrderRanks = nil
    end

    -- Automatic all-quest mode keeps AutoSC's tested global priorities. In manual mode,
    -- only the user's selected tasks and their required prerequisites are eligible.
    if (not manualMode or HiddenEvent.manualAllowedTasks["Early Access"]) and TryEarlyAccessP0(progress) then return end
    if not manualMode and TryNeededAwakenedHold(progress) then return end

    Runtime.Mode="SECRET"
    Runtime.Step="Task"
    return BaseAutoHiddenEvent()
end

-- recovery: soft at 60 sec for deterministic steps; hard at 10 min of no meaningful progress
local function waitingStep(step)
    step=string.lower(tostring(step or ""))
    return step:find("waiting",1,true) or step:find("stirs on",1,true) or step:find("needs time",1,true) or step:find("xx:",1,true) or step:find("saving the",1,true) or step:find("not up",1,true)
end
CheckHiddenStall=function()
    local progress=GetHiddenProgress()
    local done=CountSecretDone(progress)
    local sig=table.concat({tostring(done),tostring(HiddenEvent.current),tostring(HiddenEvent.step),tostring(Runtime.Step)},"|")
    if sig~=Runtime.LastSignature then Runtime.LastSignature=sig; Runtime.LastMeaningfulProgress=tick(); Runtime.LastSoftRecovery=tick(); return end
    if waitingStep(HiddenEvent.step) then Runtime.LastMeaningfulProgress=tick(); Runtime.LastSoftRecovery=tick(); return end
    local idle=tick()-Runtime.LastMeaningfulProgress
    if idle>=60 and tick()-Runtime.LastSoftRecovery>=60 then
        Runtime.LastSoftRecovery=tick(); Runtime.Status="Soft recovery: retry current action"
        HiddenEvent.arrived=nil; HiddenEvent.islandArrived=nil; HiddenEvent.waitingSince=nil; pcall(HiddenRelease); cancelTween()
    end
    if idle>=600 then
        Runtime.LastMeaningfulProgress=tick(); Runtime.Status="Hard stuck 10m: hopping server"
        HopHiddenServer("10 minute hard-stuck recovery")
    end
end

