    end)

    local function _SgGetChests()
        -- nil means the shared background index is still warming; callers should wait, not hop.
        if not SunriseWorldIndex.Ready then return nil end
        local now = os.clock()
        if _SgChestCacheDirty or now - _SgChestCacheAt >= 0.75 then
            local chests = {}
            for obj in pairs(_SgChestSet) do
                if obj and obj:IsDescendantOf(workspace) then
                    chests[#chests + 1] = obj
                else
                    _SgChestSet[obj] = nil
                end
            end
            local hrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
            if hrp then
                local pos = hrp.Position
                table.sort(chests, function(a, b)
                    if a and b and a.Parent and b.Parent then
                        return (pos - a.Position).Magnitude < (pos - b.Position).Magnitude
                    end
                    return a ~= nil and a.Parent ~= nil
                end)
            end
            _SgSortedChestCache = chests
            _SgChestCacheDirty = false
            _SgChestCacheAt = now
        end
        return _SgSortedChestCache
    end

    local function _SgCollectChest(chest)
        pcall(function()
            if not chest or not chest.Parent then return end
            local char = LocalPlayer.Character
            local hrp = char and char:FindFirstChild("HumanoidRootPart")
            if not hrp then return end
            for _, v in ipairs(char:GetDescendants()) do
                if v:IsA("BasePart") then v.CanCollide = false end
            end
            local targetCF = chest.CFrame + Vector3.new(0, 3, 0)
            -- [FIXED - as boss man requested: "remove the teleport bypass"] Removed the
            -- BypassTP branch for far chests (>3000 studs) - always uses a
            -- normal TweenController.Create, no more spawn point changes.
            TweenController.Create(targetCF)
            task.wait(0.35)
            if firetouchinterest then
                firetouchinterest(hrp, chest, 0)
                task.wait()
                firetouchinterest(hrp, chest, 1)
            end
        end)
    end

    local _SgChestPhaseDone = false
