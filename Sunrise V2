        if redDoor and doughKingTool("Red Key") then
            local doorPart = redDoor:IsA("BasePart") and redDoor or redDoor:FindFirstChildWhichIsA("BasePart", true)
            if doorPart then
                SetTask("MainTask", "Dough King | using Red Key at the Cake Land door")
