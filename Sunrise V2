        local function redraw()
            -- Collapsed dropdowns and inactive tabs do not need inventory/goal scans.
            local ancestor = row
            while ancestor and ancestor ~= gui do
                if ancestor:IsA("GuiObject") and not ancestor.Visible then return end
                ancestor = ancestor.Parent
            end
            local done = false
            pcall(function() done = isDone and isDone() or false end)
            local raceLock = raceUpgradeLockStatus(label)
            if done then
                state.Text = "✓ COMPLETED"
                state.TextColor3 = T.good
                row.Active = true
                row.BackgroundColor3 = Color3.fromRGB(35, 54, 32)
            elseif raceLock then
                state.Text = raceLock
                state.TextColor3 = T.warn
                row.Active = true
                row.BackgroundColor3 = Color3.fromRGB(55, 43, 20)
            elseif readOnlyStatus then
                local status = "NOT YET"
                pcall(function() status = tostring(readOnlyStatus() or "NOT YET") end)
                state.Text = status
                state.TextColor3 = (status == "CHECKING") and T.warn or T.sub
                row.Active = true
                row.BackgroundColor3 = T.card
            elseif not get and not set then
                state.Text = "PENDING"
                state.TextColor3 = T.sub
                row.Active = true
                row.BackgroundColor3 = T.card
            else
                local on = get and get() == true
                local orderNumber = nil
                if on and getOrder then pcall(function() orderNumber = getOrder() end) end
                state.Text = on and (orderNumber and ("#" .. tostring(orderNumber) .. " ON") or "ON") or "OFF"
                state.TextColor3 = on and accent or T.sub
                row.Active = true
                row.BackgroundColor3 = T.card
            end
        end
        row.Activated:Connect(function()
            local done = false; pcall(function() done = isDone and isDone() or false end)
            if done or raceUpgradeLockStatus(label) or not set or not get then return end
            local on = get() == true
            set(not on)
            if _G.SunriseTrackActivation then pcall(_G.SunriseTrackActivation, label, not on) end
            if not on then
                local targetName = requirementName or label
                if type(targetName) == "function" then
                    local ok, value = pcall(targetName)
                    targetName = ok and value or label
                end
                showGoalRequirement(targetName or label)
            end
            redraw()
            queueSave()
        end)
        refreshers[#refreshers + 1] = redraw
        -- Secret Quest rows use a separate five-second refresh queue, so each row
        -- reflects the cached AutoSC progress snapshot without repeatedly scanning UI.
        local isSecretQuestRow = secretQuestRowNames[label] == true
        if isSecretQuestRow then
            secretQuestRedraws[#secretQuestRedraws + 1] = redraw
        else
            goalCompletionRedraws[#goalCompletionRedraws + 1] = redraw
        end
        redraw()
        return redraw
    end
