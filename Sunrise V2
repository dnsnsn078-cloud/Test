            State.Mode = "Raid"
            local r = hrp()
            local world = workspace:FindFirstChild("_WorldOrigin")
            local locations = world and world:FindFirstChild("Locations")
            if not r or not locations then
                SetTask('MainTask', 'Raid | Waiting for island locations')
                return
            end

            -- Match BananaHub's raid flow: find the nearest numbered island, attack
            -- living enemies close to that island, then tween to the next island.
            -- Preserve the island number instead of compacting a sparse list.
            local currentIndex, nearestDistance, currentIsland = nil, math.huge, nil
            for i, islandName in ipairs(raidIslandNames) do
                local island = locations:FindFirstChild(islandName)
                if island and island:IsA("BasePart") then
                    local d = (island.Position - r.Position).Magnitude
                    if d < nearestDistance then
                        currentIndex, nearestDistance, currentIsland = i, d, island
                    end
                elseif island and island:IsA("Model") then
                    local part = island.PrimaryPart or island:FindFirstChildWhichIsA("BasePart", true)
                    if part then
                        local d = (part.Position - r.Position).Magnitude
                        if d < nearestDistance then
                            currentIndex, nearestDistance, currentIsland = i, d, part
                        end
                    end
                end
            end
            if not currentIndex or not currentIsland then
                SetTask('MainTask', 'Raid | Waiting for Island 1 to appear')
                return
            end
            if currentIndex ~= lastRaidIslandIndex then
                lastRaidIslandIndex = currentIndex
                waitForIslandUntil = os.clock() + 3.5 -- allow a new wave to replicate
            end

            local enemies = workspace:FindFirstChild("Enemies")
            local target, targetDistance = nil, math.huge
            if enemies then
                for _, enemy in ipairs(enemies:GetChildren()) do
                    local hum = enemy:FindFirstChildOfClass("Humanoid")
                    local root = enemy:FindFirstChild("HumanoidRootPart")
                    if hum and root and hum.Health > 0 then
                        local islandDistance = (root.Position - currentIsland.Position).Magnitude
                        local playerDistance = (root.Position - r.Position).Magnitude
                        if islandDistance < 450 and playerDistance < targetDistance then
                            target, targetDistance = enemy, playerDistance
                        end
                    end
                end
            end
            if target then
                waitForIslandUntil = 0
                SetTask('MainTask', 'Raid | Island ' .. currentIndex .. '/5 | Fighting ' .. target.Name)
                if currentIndex <= 4 and targetDistance <= 65 and Sunrise.RaidKillAuraPulse then
                    -- Islands 1-4 use the existing local kill-aura worker; Island 5 stays on normal melee.
                    Sunrise.RaidKillAuraPulse()
                else
                    CombatController.Attack(target.Name)
                end
                return
            end

            if os.clock() < waitForIslandUntil then
                SetTask('MainTask', 'Raid | Waiting for enemies on island ' .. currentIndex .. '/5')
                return
            end
            local nextIndex = currentIndex + 1
            local nextIsland = locations:FindFirstChild(raidIslandNames[nextIndex])
            if nextIsland then
                local part = nextIsland:IsA("BasePart") and nextIsland
                    or (nextIsland:IsA("Model") and (nextIsland.PrimaryPart or nextIsland:FindFirstChildWhichIsA("BasePart", true)))
                if not part then
                    SetTask('MainTask', 'Raid | Waiting for island ' .. nextIndex)
                    return
                end
                -- Stay above the island marker itself; the old sideways +120-stud
                -- offset could put the player over the sea when the tween completed.
                local targetCF = CFrame.new(part.Position + Vector3.new(0, 55, 0))
                local activeTween = TweenInstance and TweenInstance.PlaybackState == Enum.PlaybackState.Playing
                if (r.Position - targetCF.Position).Magnitude > 250 and not activeTween then
                    TweenController.Create(targetCF)
                end
                SetTask('MainTask', 'Raid | Moving to island ' .. nextIndex .. '/5')
            else
                SetTask('MainTask', 'Raid | Final island cleared; waiting for raid completion')
            end
        end
