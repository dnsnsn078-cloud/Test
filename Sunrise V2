FindNeededAwakenedQuest = function(progress, hint)
    if type(hint) ~= "table" or not hint.Boss or not hint.Island then
        return nil
    end

    for _, quest in ipairs(HiddenQuests or {}) do
        local key = "Sea1/" .. quest.Island .. "/" .. quest.Name
        if progress[key] ~= true and quest.BossNames
            and IsHiddenBossHinted(hint, quest.HintIsland or quest.Island, quest.BossNames)
        then
            return quest
        end
    end

    return nil
end

local function HasMatchingActiveAwakenedBoss(quest)
    if not quest or not quest.BossNames then return false end

    for _, enemy in ipairs(workspace.Enemies:GetChildren()) do
        if enemy:GetAttribute("BossIndicatorAwakened") and IsHiddenTarget(enemy) then
            for _, bossName in ipairs(quest.BossNames) do
                if string.find(enemy.Name, bossName, 1, true) then
                    return true
                end
            end
        end
    end

    return false
end

local function TryNeededAwakenedHold(progress)
    -- A started ordinary Secret wins over an upcoming awakened boss.
    if IsHiddenTaskLockValid(progress) then
        return false
    end

    local minute = os.date("!*t").min
    if minute < 50 or minute > 58 then
        HiddenEvent.neededBossHold = nil
        return false
    end

    local hint = GetHiddenRaidHint()
    local quest = FindNeededAwakenedQuest(progress, hint)

    if not quest then
        HiddenEvent.neededBossHold = nil
        return false
    end

    -- If the awakened boss is already physically spawned, let the mature
    -- scheduler take over immediately so it can fight / execute the Secret.
    if HasMatchingActiveAwakenedBoss(quest) then
        HiddenEvent.neededBossHold = nil
        HiddenEvent.deadHourIdleSince = nil
        return false
    end

    HiddenEvent.neededBossHold = quest.Name
    HiddenEvent.deadHourIdleSince = nil
    HiddenEvent.hopAt = nil
    HiddenEvent.current = quest.Name
    HiddenEvent.currentIsland = quest.Island

    local boss = tostring(hint.Boss or "?")
    local state = tostring(hint.State or "?")
    local seconds = math.max(0, math.floor(tonumber(hint.Seconds) or 0))

    Runtime.Mode = "BOSS HOLD"
    Runtime.Step = quest.Name
    Runtime.Status =
        "Needed awakened " .. boss
        .. " | " .. state
        .. " | " .. seconds .. "s"
        .. " | staying in server"

    SetHiddenStep(
        "Needed=YES " .. boss
        .. " -> " .. quest.Name
        .. " | WAIT " .. seconds .. "s | NO HOP"
    )

    local logKey = boss .. "|" .. state .. "|" .. tostring(math.floor(seconds / 10))
    if Runtime.LastNeededBossHoldLog ~= logKey then
        Runtime.LastNeededBossHoldLog = logKey
        print(
            "[YELU0/Hidden][Awakened] NEEDED HOLD -> "
            .. boss .. "@" .. tostring(hint.Island)
            .. " State=" .. state
            .. " T=" .. seconds .. "s"
            .. " -> " .. quest.Name
            .. " | STAY SERVER / NO HOP"
        )
    end

    -- Park at the correct island while waiting, but do not constantly bounce
    -- between other ordinary tasks.
    if HiddenGoToIsland(quest.Island) then
        local island = GetHiddenIsland(quest.Island)
        local world = island and island.World
        if world then
            HiddenHold(world.CFrame * CFrame.new(0, 30, 0))
        end
    end

    return true
end

-- Manual-order support. Selected tasks are attempted in the user's click order; incomplete
-- prerequisite tasks are inserted immediately before the selected task that needs them.
local function BuildManualSelection(progress)
    local queue = HiddenEvent.manualSelectionOrder
    if type(queue) ~= "table" or #queue == 0 then return nil, nil end
    local byName = {}
    for _, quest in ipairs(HiddenQuests or {}) do
        if type(quest) == "table" and type(quest.Name) == "string" then byName[quest.Name] = quest end
    end
    local allowed, ranks = {}, {}
    local function addTaskAndPrerequisites(name, rank, visiting)
        local quest = byName[name]
        if not quest then return end
        local key = "Sea1/" .. tostring(quest.Island) .. "/" .. tostring(quest.Name)
        if progress and progress[key] == true then return end
        if visiting[name] then return end
        visiting[name] = true
        if quest.Requires and (not progress or progress[quest.Requires] ~= true) then
            local requiredName = tostring(quest.Requires):match("([^/]+)$")
            if requiredName then addTaskAndPrerequisites(requiredName, rank - 0.01, visiting) end
        end
        visiting[name] = nil
        allowed[name] = true
        if ranks[name] == nil or rank < ranks[name] then ranks[name] = rank end
    end
    for index, name in ipairs(queue) do
        if name ~= "The Finale" then addTaskAndPrerequisites(name, index, {}) end
    end
    return allowed, ranks
end

-- wrapper around the mature 39-secret scheduler
local BaseAutoHiddenEvent=AutoHiddenEvent
AutoHiddenEvent=function()
    local progress=GetHiddenProgress()
    local done=CountSecretDone(progress)
    local manualQueue = HiddenEvent.manualSelectionOrder
    local manualMode = type(manualQueue) == "table" and #manualQueue > 0
    local manualChosen = HiddenEvent.manualSelectedSet or {}

    if done>=39 then
        if manualMode and not manualChosen["The Finale"] then
            HiddenEvent.current = nil
            Runtime.Mode="SECRET"
            Runtime.Status="39/39 secrets complete; select The Finale to finish"
            SetHiddenStep("The Finale is not selected")
            return
        end
        return RunFinale()
    end

    if manualMode then
        local allowed, ranks = BuildManualSelection(progress)
        HiddenEvent.manualAllowedTasks = allowed or {}
        HiddenEvent.manualOrderRanks = ranks or {}
        if not next(HiddenEvent.manualAllowedTasks) then
            HiddenEvent.current = nil
            Runtime.Mode="SECRET"
            Runtime.Status="Selected secret quests are complete (or only The Finale is selected)"
            SetHiddenStep("Waiting for a selected task")
            return
        end
    else
        HiddenEvent.manualAllowedTasks = nil
        HiddenEvent.manualOrderRanks = nil
    end

    -- Automatic all-quest mode keeps AutoSC's tested global priorities. In manual mode,
    -- only the user's selected tasks and their required prerequisites are eligible.
    if (not manualMode or HiddenEvent.manualAllowedTasks["Early Access"]) and TryEarlyAccessP0(progress) then return end
    if not manualMode and TryNeededAwakenedHold(progress) then return end

    Runtime.Mode="SECRET"
    Runtime.Step="Task"
    return BaseAutoHiddenEvent()
end

-- recovery: soft at 60 sec for deterministic steps; hard at 10 min of no meaningful progress
local function waitingStep(step)
    step=string.lower(tostring(step or ""))
    return step:find("waiting",1,true) or step:find("stirs on",1,true) or step:find("needs time",1,true) or step:find("xx:",1,true) or step:find("saving the",1,true) or step:find("not up",1,true)
end
CheckHiddenStall=function()
    local progress=GetHiddenProgress()
    local done=CountSecretDone(progress)
    local sig=table.concat({tostring(done),tostring(HiddenEvent.current),tostring(HiddenEvent.step),tostring(Runtime.Step)},"|")
    if sig~=Runtime.LastSignature then Runtime.LastSignature=sig; Runtime.LastMeaningfulProgress=tick(); Runtime.LastSoftRecovery=tick(); return end
    if waitingStep(HiddenEvent.step) then Runtime.LastMeaningfulProgress=tick(); Runtime.LastSoftRecovery=tick(); return end
    local idle=tick()-Runtime.LastMeaningfulProgress
    if idle>=60 and tick()-Runtime.LastSoftRecovery>=60 then
        Runtime.LastSoftRecovery=tick(); Runtime.Status="Soft recovery: retry current action"
        HiddenEvent.arrived=nil; HiddenEvent.islandArrived=nil; HiddenEvent.waitingSince=nil; pcall(HiddenRelease); cancelTween()
    end
    if idle>=600 then
        Runtime.LastMeaningfulProgress=tick(); Runtime.Status="Hard stuck 10m: hopping server"
        HopHiddenServer("10 minute hard-stuck recovery")
    end
end

