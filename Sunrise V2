        ---------------------------------------------------------------- icons
        -- Line icons drawn on a 24x24 grid from rounded bars, rings and clipped arcs.
        -- Everything is sized in scale (no fractional pixel offsets), so shapes stay crisp at any size.
        local Icons = {}

        local function glyph(parent, name, px, color, th)
        	local H = {Fills = {}, Strokes = {}, th = th or 2.1}
        	local box = new("Frame", {BackgroundTransparency = 1, Size = UDim2.fromOffset(px, px), BorderSizePixel = 0}, parent)
        	H.Root = box
        	local build = Icons[name]
        	if not build then -- plain text fallback
        		local t = label(box, {Text = tostring(name), Size = UDim2.fromScale(1, 1), TextXAlignment = Enum.TextXAlignment.Center, TextSize = math.floor(px * .9), TextColor3 = color})
        		function H:Color(c, tm) tween(t, {TextColor3 = c}, tm or .2) end
        		return H
        	end
        	local k = px / 24
        	local C = {f = box, x = 0, y = 0, w = 24, h = 24}
        	local function geom(ctx, x, y, w, h) -- centered at (x, y) in grid units
        		return UDim2.fromScale((x - ctx.x) / ctx.w, (y - ctx.y) / ctx.h), UDim2.fromScale(w / ctx.w, h / ctx.h)
        	end
        	local P = {}
        	function P.blk(x, y, w, h, rot, r, ctx) -- filled rounded bar
        		ctx = ctx or C
        		local pos, size = geom(ctx, x, y, w, h)
        		local f = new("Frame", {AnchorPoint = Vector2.new(.5, .5), Position = pos, Size = size, Rotation = rot or 0, BackgroundColor3 = color, BorderSizePixel = 0}, ctx.f)
        		new("UICorner", {CornerRadius = UDim.new(math.clamp((r or math.min(w, h) / 2) / math.min(w, h), 0, .5), 0)}, f)
        		table.insert(H.Fills, f)
        		return f
        	end
        	function P.seg(x1, y1, x2, y2, ctx) -- line with round caps between two points
        		local dx, dy = x2 - x1, y2 - y1
        		local len = math.sqrt(dx * dx + dy * dy)
        		return P.blk((x1 + x2) / 2, (y1 + y2) / 2, H.th, len + H.th, math.deg(math.atan2(-dx, dy)), H.th / 2, ctx)
        	end
        	function P.poly(pts, ctx)
        		for i = 1, #pts - 1 do P.seg(pts[i][1], pts[i][2], pts[i + 1][1], pts[i + 1][2], ctx) end
        	end
        	function P.ring(x, y, R, ctx) -- R = radius of the stroke centerline
        		ctx = ctx or C
        		local d = 2 * R - H.th
        		local pos, size = geom(ctx, x, y, d, d)
        		local f = new("Frame", {AnchorPoint = Vector2.new(.5, .5), Position = pos, Size = size, BackgroundTransparency = 1, BorderSizePixel = 0}, ctx.f)
        		new("UICorner", {CornerRadius = UDim.new(.5, 0)}, f)
        		table.insert(H.Strokes, stroke(f, color, H.th * k))
        		return f
        	end
        	function P.box(x, y, w, h, r, ctx) -- outlined rounded rect (w, h = stroke centerline size)
        		ctx = ctx or C
        		local iw, ih = w - H.th, h - H.th
        		local pos, size = geom(ctx, x, y, iw, ih)
        		local f = new("Frame", {AnchorPoint = Vector2.new(.5, .5), Position = pos, Size = size, BackgroundTransparency = 1, BorderSizePixel = 0}, ctx.f)
        		new("UICorner", {CornerRadius = UDim.new(math.clamp(((r or math.min(iw, ih) / 2) - H.th / 2) / math.min(iw, ih), 0, .5), 0)}, f)
        		table.insert(H.Strokes, stroke(f, color, H.th * k))
        		return f
        	end
        	function P.clip(x, y, w, h, ctx) -- clipping window, returns a child context
        		ctx = ctx or C
        		local pos, size = geom(ctx, x + w / 2, y + h / 2, w, h)
        		local f = new("Frame", {AnchorPoint = Vector2.new(.5, .5), Position = pos, Size = size, BackgroundTransparency = 1, ClipsDescendants = true, BorderSizePixel = 0}, ctx.f)
        		return {f = f, x = x, y = y, w = w, h = h}
        	end
        	function P.grp(x, y, w, h, ctx) -- plain group centered at (x, y) (used for spinning rays)
        		ctx = ctx or C
        		local pos, size = geom(ctx, x, y, w, h)
        		local f = new("Frame", {AnchorPoint = Vector2.new(.5, .5), Position = pos, Size = size, BackgroundTransparency = 1, BorderSizePixel = 0}, ctx.f)
        		return {f = f, x = x - w / 2, y = y - h / 2, w = w, h = h}
        	end
        	build(P, H)
        	function H:Color(c, tm)
        		for _, f in ipairs(self.Fills) do tween(f, {BackgroundColor3 = c}, tm or .2) end
        		for _, s in ipairs(self.Strokes) do tween(s, {Color = c}, tm or .2) end
        	end
        	return H
        end

