        if enabled then
            _G.SunriseLastActivated = labelText
            _G.SunriseActivationClock = os.clock()
        end
        if handler then
            local stack = _G.SunriseTaskPriorityStack
            for i = #stack, 1, -1 do
                if stack[i] and stack[i].task == handler then table.remove(stack, i) end
            end
            if enabled then stack[#stack + 1] = {label = labelText, task = handler, at = os.clock()} end
        end
        local stack = _G.SunriseTaskPriorityStack
        local latest
        for i = #stack, 1, -1 do
            local entry = stack[i]
            if entry and entry.task then latest = entry; break end
        end
        if not enabled and _G.SunriseLastActivated == labelText then
            _G.SunriseLastActivated = latest and latest.label or "None"
