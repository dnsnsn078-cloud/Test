    local function goalRow(p, label, isDone, get, set, desc, getOrder, readOnlyStatus, requirementName)
        local h = desc and 44 or 34
        local row = new("TextButton", {Size = UDim2.new(1, 0, 0, h), BackgroundColor3 = T.card, AutoButtonColor = false,
            Text = "", BorderSizePixel = 0, LayoutOrder = nextOrder()}, p)
        corner(row, 8)
        text(row, {Position = UDim2.fromOffset(10, desc and 4 or 0), Size = UDim2.new(1, -112, 0, desc and 16 or h), Text = label, TextTruncate = Enum.TextTruncate.AtEnd})
        if desc then text(row, {Position = UDim2.fromOffset(10, 22), Size = UDim2.new(1, -112, 0, 13), Text = desc, TextSize = 10, TextColor3 = T.sub, TextTruncate = Enum.TextTruncate.AtEnd}) end
        local state = text(row, {Position = UDim2.new(1, -104, 0, 0), Size = UDim2.fromOffset(94, h), Text = "OFF", Font = Enum.Font.GothamBold,
            TextSize = 10, TextXAlignment = Enum.TextXAlignment.Right, TextColor3 = T.sub})
        local function redraw()
            -- Collapsed dropdowns and inactive tabs do not need inventory/goal scans.
            local ancestor = row
            while ancestor and ancestor ~= gui do
                if ancestor:IsA("GuiObject") and not ancestor.Visible then return end
                ancestor = ancestor.Parent
            end
            local done = false
            pcall(function() done = isDone and isDone() or false end)
            if done then
                state.Text = "✓ COMPLETED"
                state.TextColor3 = T.good
                row.Active = false
                row.BackgroundColor3 = Color3.fromRGB(35, 54, 32)
            elseif readOnlyStatus then
                local status = "NOT YET"
                pcall(function() status = tostring(readOnlyStatus() or "NOT YET") end)
                state.Text = status
                state.TextColor3 = (status == "CHECKING") and T.warn or T.sub
                row.Active = false
                row.BackgroundColor3 = T.card
            elseif not get and not set then
                state.Text = "PENDING"
                state.TextColor3 = T.sub
                row.Active = false
                row.BackgroundColor3 = T.card
            else
                local on = get and get() == true
                local orderNumber = nil
                if on and getOrder then pcall(function() orderNumber = getOrder() end) end
                state.Text = on and (orderNumber and ("#" .. tostring(orderNumber) .. " ON") or "ON") or "OFF"
                state.TextColor3 = on and accent or T.sub
                row.Active = true
                row.BackgroundColor3 = T.card
            end
        end
        row.Activated:Connect(function()
            local done = false; pcall(function() done = isDone and isDone() or false end)
            if done or not set or not get then return end
            local on = get() == true
            set(not on)
            if not on then showGoalRequirement(requirementName or label) end
            redraw()
            queueSave()
        end)
        refreshers[#refreshers + 1] = redraw
        -- Item/style/sword goal rows refresh live. Secret-quest rows use their own
        -- throttled detector; keeping them out of this loop avoids 40 extra GUI scans.
        local isSecretQuestRow = Config.SecretQuest and Config.SecretQuest.Selected
            and Config.SecretQuest.Selected[label] ~= nil
        if not isSecretQuestRow then goalCompletionRedraws[#goalCompletionRedraws + 1] = redraw end
        redraw()
        return redraw
    end
