    -- BRING MOBS - adapted from Banana Hub's BringEnemy approach.
    -- Uses the current combat target as the anchor. Spatial queries limit work to
    -- nearby NPC roots, so a crowded island does not trigger a full NPC scan.
    -- ============================================================
    local SunriseBringMobParts = setmetatable({}, {__mode = "k"})
    local SunriseBringOverlapParams = nil
    local SunriseBringOverlapFolder = nil
    local function SunriseSetMobPullStatus(message)
        if _G.SunriseMobPullStatus ~= message then _G.SunriseMobPullStatus = message end
    end
    local function SunriseGetBringMobParts(enemy)
        local cached = SunriseBringMobParts[enemy]
        if cached and cached.Humanoid and cached.Root
            and cached.Humanoid.Parent == enemy and cached.Root.Parent == enemy then
            return cached.Humanoid, cached.Root
        end
        local humanoid = enemy and enemy:FindFirstChildOfClass("Humanoid")
        local root = enemy and enemy:FindFirstChild("HumanoidRootPart")
        if humanoid and root then
            SunriseBringMobParts[enemy] = {Humanoid = humanoid, Root = root}
            return humanoid, root
        end
        return nil, nil
    end

    local function SunriseGetNearbyBringMobs(enemies, center, radius)
        -- GetPartBoundsInRadius uses Workspace's spatial index and skips distant NPCs.
        -- Reuse the filter object; if the API is unsupported, fall back to the cached
        -- child list rather than breaking combat.
        if type(workspace.GetPartBoundsInRadius) == "function" and OverlapParams then
            local ok, result = pcall(function()
                if not SunriseBringOverlapParams then
                    SunriseBringOverlapParams = OverlapParams.new()
                    SunriseBringOverlapParams.FilterType = Enum.RaycastFilterType.Include
                    SunriseBringOverlapParams.MaxParts = 0
                end
                if SunriseBringOverlapFolder ~= enemies then
                    SunriseBringOverlapFolder = enemies
                    SunriseBringOverlapParams.FilterDescendantsInstances = {enemies}
                end
                return workspace:GetPartBoundsInRadius(center, radius, SunriseBringOverlapParams)
            end)
            if ok and type(result) == "table" then
                local nearby, seen = {}, {}
                for _, part in ipairs(result) do
                    if part.Name == "HumanoidRootPart" then
                        local model = part.Parent
                        if model and model:IsA("Model") and not seen[model] then
                            seen[model] = true
                            nearby[#nearby + 1] = model
                        end
                    end
                end
                return nearby
            end
        end
        return SunriseGetChildrenCached(enemies, 0.50)
    end

