                -- Keep them on separate ticks so the rate limiter cannot suppress the
                -- second request every loop.
                if beforeBeli >= 3000000 and CaculateDistance(wizardCF) <= 18 and now - sunriseDracoLastNpcActionAt >= 7 then
                    sunriseDracoLastNpcActionAt = now
                    local result = SunriseDragonQuestInvoke("Dragon Wizard", "Upgrade")
