    -- Sea Events + special-island controller. Auto Sail borrows the proven BananaHub
    -- ownership check / BuyBoat flow and patrols between the adjacent danger zones.
    task.spawn(function()
        local VirtualUser = game:GetService("VirtualUser")
        local TweenService = game:GetService("TweenService")
        local ReplicatedStorage = game:GetService("ReplicatedStorage")
        local eventPlayer = game:GetService("Players").LocalPlayer
        local islandNames = {
            Mirage = {"Mirage Island", "MirageIsland"},
            Prehistoric = {"Prehistoric Island", "PrehistoricIsland"},
            Kitsune = {"Kitsune Island", "KitsuneIsland"},
        }
        local islandHighlights, activeMove, activeMoveTarget = {}, nil, nil
        local lastAttack, lastBoatPurchase, patrolOuter = 0, 0, true
        local lastPatrolLevel = nil
        local dockCF = CFrame.new(-16927.451, 9.086, 433.864)
        local seaZones = {
            [1] = CFrame.new(-21998.375, 30.0006084, -682.309143),
            [2] = CFrame.new(-26779.5215, 30.0005474, -822.858032),
            [3] = CFrame.new(-31171.957, 30.0001011, -2256.93774),
            [4] = CFrame.new(-34054.6875, 30.2187767, -2560.12012),
            [5] = CFrame.new(-38887.5547, 30.0004578, -2162.99023),
            [6] = CFrame.new(-44541.7617, 30.0003204, -1244.8584),
        }
        local function rootPart()
            local char = eventPlayer and eventPlayer.Character
            return char and char:FindFirstChild("HumanoidRootPart")
        end
        local function humanoid()
            local char = eventPlayer and eventPlayer.Character
            return char and char:FindFirstChildOfClass("Humanoid")
        end
        local function modelPosition(model)
            if not model then return nil end
            if model:IsA("BasePart") then return model.Position end
            if not model:IsA("Model") then return nil end
            local part = model.PrimaryPart or model:FindFirstChild("HumanoidRootPart") or model:FindFirstChildWhichIsA("BasePart", true)
            return part and part.Position or nil
        end
        local function locateIsland(alias)
            local roots = {}
            local wo = workspace:FindFirstChild("_WorldOrigin")
            if wo and wo:FindFirstChild("Locations") then roots[#roots + 1] = wo.Locations end
            local map = workspace:FindFirstChild("Map")
            if map then roots[#roots + 1] = map end
            for _, container in ipairs(roots) do
                for _, obj in ipairs(container:GetDescendants()) do
                    if obj:IsA("Model") or obj:IsA("BasePart") then
                        local name = string.lower(obj.Name)
                        for _, expected in ipairs(islandNames[alias]) do
                            if string.find(name, string.lower(expected), 1, true) then
                                if modelPosition(obj) then return obj end
                                local parent = obj.Parent
                                if parent and modelPosition(parent) then return parent end
                            end
                        end
                    end
                end
            end
        end
        local function stopMove()
            if activeMove then pcall(function() activeMove:Cancel() end) end
            activeMove, activeMoveTarget = nil, nil
        end
        local function moveRootTo(targetCF, targetKey)
            local root = rootPart()
            if not root then return end
            if activeMoveTarget == targetKey and activeMove and activeMove.PlaybackState == Enum.PlaybackState.Playing then return end
            stopMove()
            activeMoveTarget = targetKey
            local distance = (root.Position - targetCF.Position).Magnitude
            if distance <= 25 then activeMove, activeMoveTarget = nil, nil; return end
            activeMove = TweenService:Create(root, TweenInfo.new(math.clamp(distance / 260, 2, 22), Enum.EasingStyle.Linear), {CFrame = targetCF})
            activeMove:Play()
        end
        local function moveBoatSeatTo(seat, targetCF, targetKey)
            if not seat or not seat.Parent then return end
            if activeMoveTarget == targetKey and activeMove and activeMove.PlaybackState == Enum.PlaybackState.Playing then return end
            stopMove()
            local boatRoot = seat.AssemblyRootPart or seat
            activeMoveTarget = targetKey
            local distance = (boatRoot.Position - targetCF.Position).Magnitude
            if distance <= 18 then activeMove, activeMoveTarget = nil, nil; return end
            -- Tween the welded boat assembly root, not just the VehicleSeat; tweening
            -- the seat alone can separate it visually from the hull or fail to move it.
            activeMove = TweenService:Create(boatRoot, TweenInfo.new(math.clamp(distance / 300, 2, 45), Enum.EasingStyle.Linear), {CFrame = targetCF})
            activeMove:Play()
        end
        local function approach(model, height)
            local root, pos = rootPart(), modelPosition(model)
            if not root or not pos then return end
            local distance = (root.Position - pos).Magnitude
            if distance < 220 then stopMove(); return end
            local part = model:IsA("BasePart") and model or (model.PrimaryPart or model:FindFirstChildWhichIsA("BasePart", true))
            if not part then return end
            moveRootTo(part.CFrame * CFrame.new(0, height or 8, 0), model)
        end
        local function setIslandESP(alias, model)
            local old = islandHighlights[alias]
            if old and (not model or old.Parent ~= model) then pcall(function() old:Destroy() end); islandHighlights[alias] = nil end
            if not Config.SeaEvents.IslandESP or not model then
                if islandHighlights[alias] then pcall(function() islandHighlights[alias]:Destroy() end); islandHighlights[alias] = nil end
                return
            end
            if not islandHighlights[alias] then
                local h = Instance.new("Highlight")
                h.Name = "Sunrise_" .. alias .. "_IslandESP"
                h.FillTransparency, h.OutlineTransparency = 0.78, 0
                h.DepthMode, h.Adornee, h.Parent = Enum.HighlightDepthMode.AlwaysOnTop, model, model
                islandHighlights[alias] = h
            end
        end
        local function alive(model)
            local hum = model:FindFirstChildOfClass("Humanoid")
            if hum then return hum.Health > 0 end
            local health = model:FindFirstChild("Health")
            if health and health:IsA("ValueBase") and tonumber(health.Value) then return health.Value > 0 end
            return modelPosition(model) ~= nil
        end
        local function enabledTarget(name)
            local c, low = Config.SeaEvents, string.lower(name)
            local compact = low:gsub("[%s%-%_]", "")
            local isTerrorShark = string.find(compact, "terrorshark", 1, true) ~= nil
            local isSeaBeast = string.find(compact, "seabeast", 1, true) ~= nil
            local isShark = string.find(compact, "shark", 1, true) ~= nil
            local isPiranha = string.find(compact, "piranha", 1, true) ~= nil
            local isFishCrew = string.find(compact, "fishcrewmember", 1, true) ~= nil
            local isHauntedCrew = string.find(compact, "hauntedcrewmember", 1, true) ~= nil
            local isFishBoat = string.find(compact, "fishboat", 1, true) ~= nil
            local isGrandBrigade = string.find(compact, "pirategrandbrigade", 1, true) ~= nil
            local isSeaTarget = isTerrorShark or isSeaBeast or isShark or isPiranha or isFishCrew or isHauntedCrew or isFishBoat or isGrandBrigade
            if c.AutoSeaEnemyFarming and isSeaTarget then return true end
            if isTerrorShark then return c.AutoTerrorShark end
            if isSeaBeast then return c.AutoSeaBeast or c.AutoAttackSeaBeast or c.AutoRumbling end
            if isShark then return c.AutoShark end
            if isPiranha then return c.AutoPiranha end
            if isFishCrew then return c.AutoFishCrewMember end
            if isHauntedCrew then return c.AutoHauntedCrewMember end
            if isFishBoat then return c.AutoAttackFishBoat end
            if isGrandBrigade then return c.AutoAttackPirateGrandBrigade end
            return false
        end
        local function eventSearchEnabled()
            local c = Config.SeaEvents
            return c.AutoSeaEnemyFarming or c.AutoSeaBeast or c.AutoRumbling or c.AutoShark or c.AutoPiranha
                or c.AutoTerrorShark or c.AutoFishCrewMember or c.AutoHauntedCrewMember
                or c.AutoAttackFishBoat or c.AutoAttackSeaBeast or c.AutoAttackPirateGrandBrigade
        end
        local function nearestTarget()
            local root = rootPart()
            if not root then return nil end
            local best, bestDistance
            for _, folderName in ipairs({"SeaBeasts", "Enemies", "Characters"}) do
                local folder = workspace:FindFirstChild(folderName)
                if folder then
                    for _, model in ipairs(folder:GetChildren()) do
                        if model:IsA("Model") and enabledTarget(model.Name) and alive(model) then
                            local pos = modelPosition(model)
                            if pos then
                                local distance = (root.Position - pos).Magnitude
                                if distance <= 1400 and (not bestDistance or distance < bestDistance) then best, bestDistance = model, distance end
                            end
                        end
                    end
                end
            end
            return best, bestDistance
        end
        local function ownedBoat()
            local boats = workspace:FindFirstChild("Boats")
            if not boats then return nil end
            for _, boat in ipairs(boats:GetChildren()) do
                local owner = boat:FindFirstChild("Owner")
                local seat = boat:FindFirstChildWhichIsA("VehicleSeat", true)
                if owner and seat and tostring(owner.Value) == tostring(eventPlayer and eventPlayer.Name) then return boat, seat end
            end
        end
        local function buyBoatIfNeeded()
            if (SeaIndex or 1) ~= 3 then return "Auto Sail needs the Third Sea" end
            local root = rootPart()
            if not root then return "waiting for character" end
            if (root.Position - dockCF.Position).Magnitude > 30 then
                moveRootTo(dockCF * CFrame.new(0, 6, 0), "boat-dock")
                return "going to boat dealer"
            end
            if os.clock() - lastBoatPurchase >= 15 then
                lastBoatPurchase = os.clock()
                pcall(function()
                    ReplicatedStorage:WaitForChild("Remotes"):WaitForChild("CommF_"):InvokeServer("BuyBoat", Config.SeaEvents.SelectedBoat or "Beast Hunter")
                end)
            end
            return "requesting selected boat"
        end
        local function sailStep(forceIslandSearch)
            local cfg = Config.SeaEvents
            if not cfg.AutoSail and not forceIslandSearch then return false end
            if (SeaIndex or 1) ~= 3 then
                stopMove()
                return "Auto Sail needs the Third Sea"
            end
            local boat, seat = ownedBoat()
            if not boat then return buyBoatIfNeeded() end
            local root, hum = rootPart(), humanoid()
            if not root or not seat or not hum then return "waiting for boat seat" end
            if hum.Sit ~= true then
                if (root.Position - seat.Position).Magnitude > 12 then
                    moveRootTo(seat.CFrame * CFrame.new(0, 2, 0), boat)
                    return "boarding selected boat"
                end
                stopMove()
                pcall(function() seat:Sit(hum) end)
                return "boarding selected boat"
            end
            local level = tonumber(tostring(cfg.SelectedSeaLevel or "Level 3"):match("%d+")) or 3
            level = math.clamp(level, 1, 6)
            if lastPatrolLevel ~= level then lastPatrolLevel, patrolOuter = level, true end
            local targetLevel
            if level == 1 then targetLevel = patrolOuter and 2 or 1
            elseif level == 6 then targetLevel = patrolOuter and 6 or 5
            else targetLevel = patrolOuter and (level + 1) or (level - 1) end
            local targetCF = seaZones[targetLevel]
            if (root.Position - targetCF.Position).Magnitude <= 140 then
                patrolOuter = not patrolOuter
                targetLevel = (level == 1) and (patrolOuter and 2 or 1)
                    or ((level == 6) and (patrolOuter and 6 or 5)
                    or (patrolOuter and (level + 1) or (level - 1)))
                targetCF = seaZones[targetLevel]
            end
            moveBoatSeatTo(seat, targetCF, "sail-zone-" .. tostring(level) .. "-" .. tostring(targetLevel))
            return "patrolling danger level " .. level .. " (sweeping zone " .. targetLevel .. ")"
        end
        while task.wait(3) do
            pcall(function()
                local cfg = Config.SeaEvents
                local state = {Mirage = "not found", Prehistoric = "not found", Kitsune = "not found", Target = "none", Controller = "idle"}
                local chosenIsland, chosenAlias
                for _, alias in ipairs({"Mirage", "Prehistoric", "Kitsune"}) do
                    local model = locateIsland(alias)
                    if model then
                        state[alias] = "FOUND"
                        local root, pos = rootPart(), modelPosition(model)
                        local close = root and pos and (root.Position - pos).Magnitude <= 260
                        if close then setIslandESP(alias, nil) else setIslandESP(alias, model) end
                        local on = (alias == "Mirage" and cfg.AutoMirage) or (alias == "Prehistoric" and cfg.AutoPrehistoric) or (alias == "Kitsune" and cfg.AutoKitsuneIsland)
                        if on and not chosenIsland then chosenIsland, chosenAlias = model, alias end
                    else
                        setIslandESP(alias, nil)
                    end
                end
                if chosenIsland then
                    local root, islandPos = rootPart(), modelPosition(chosenIsland)
                    local hum = humanoid()
                    local distance = (root and islandPos) and (root.Position - islandPos).Magnitude or math.huge
                    if distance > 500 then
                        local boat, seat = ownedBoat()
                        if boat and seat and hum and hum.Sit then
                            -- Keep the character aboard while crossing open water. The island
                            -- has been found so zone patrol stops, but the boat gets close before
                            -- the short final character approach (avoids long swims/water deaths).
                            local delta = islandPos - seat.Position
                            local direction = delta.Magnitude > 0 and delta.Unit or Vector3.new(0, 0, -1)
                            local boatTarget = CFrame.lookAt(islandPos - direction * 160 + Vector3.new(0, 4, 0), islandPos)
                            moveBoatSeatTo(seat, boatTarget, "island-approach-" .. chosenAlias)
                            state.Controller = "island found; sailing closer while ESP stays visible"
                        else
                            local sailStatus = sailStep(true)
                            state.Controller = sailStatus or "boarding boat before island approach"
                        end
                    else
                        if activeMoveTarget ~= chosenIsland then stopMove() end
                        if hum and hum.Sit then pcall(function() hum.Sit = false end) end
                        approach(chosenIsland, 8)
                        state.Controller = "Auto " .. chosenAlias .. " active: patrol paused / final approach"
                    end
                else
                    local target, distance = nearestTarget()
                    if target then
                        local eventMoveKey = "sea-target-approach-" .. target.Name
                        if activeMoveTarget ~= eventMoveKey then
                            stopMove() -- stop the boat patrol when switching to an event target
                        end
                        state.Target = target.Name .. " (" .. tostring(math.floor(distance)) .. " studs)"
                        local root, pos, hum = rootPart(), modelPosition(target), humanoid()
                        if root and pos then
                            local boat, seat = ownedBoat()
                            hum = humanoid()
                            if distance > 95 then
                                if boat and seat and hum and hum.Sit then
                                    local delta = pos - seat.Position
                                    local direction = delta.Magnitude > 0 and delta.Unit or Vector3.new(0, 0, -1)
                                    -- Keep the player seated and move the boat assembly toward the event;
                                    -- do not tween the character out into the ocean.
                                    local boatTarget = CFrame.lookAt(pos - direction * 65 + Vector3.new(0, 4, 0), pos)
                                    moveBoatSeatTo(seat, boatTarget, "sea-target-approach-" .. target.Name)
                                    state.Controller = "sailing to detected target; character stays aboard"
                                else
                                    local sailStatus = sailStep(true)
                                    state.Controller = sailStatus or "target detected; boarding selected boat"
                                end
                            else
                                local boat, seat = ownedBoat()
                                hum = humanoid()
                                if not boat or not seat or not hum or hum.Sit ~= true then
                                    -- Don't dismount into the water to attack a sea target. Board a
                                    -- boat first, even if an event happened to spawn close by.
                                    local sailStatus = sailStep(true)
                                    state.Controller = sailStatus or "boarding boat before attacking"
                                else
                                    stopMove()
                                    state.Controller = "target within attack range; staying aboard"
                                    if os.clock() - lastAttack > 0.2 then
                                        lastAttack = os.clock()
                                        pcall(function() CombatController.Attack(target.Name) end)
                                        pcall(function()
                                            VirtualUser:CaptureController()
                                            VirtualUser:Button1Down(Vector2.new(0, 0), workspace.CurrentCamera.CFrame)
                                            task.wait(0.04)
                                            VirtualUser:Button1Up(Vector2.new(0, 0), workspace.CurrentCamera.CFrame)
                                        end)
                                    end
                                end
                            end
                        end
                    else
                        local islandSearch = cfg.AutoMirage or cfg.AutoPrehistoric or cfg.AutoKitsuneIsland
                        local sailStatus = sailStep(islandSearch or eventSearchEnabled())
                        if sailStatus then
                            state.Controller = sailStatus
                        else
                            stopMove()
                        end
                    end
                end
                _G.SunriseSeaEventStatus = state
            end)
        end
    end)
end -- closes the Sunrise panel scope, matching the original script structure

