    -- Cake Prince [Lv. 2300] [Raid Boss] (Sea 3, CakeLoaf island)
    -- [FIXED - per the new spec] PREVIOUSLY used to farm Fragments (gated by
    -- Fragments > 5000) - the new spec requires REMOVING that purpose entirely, "only use
    -- raid to get Fragments". Cake Prince is now ONLY used to farm MASTERY for the
    -- melee being trained (V1 needs 500, V2 needs 400) - killing Cake Prince with the
    -- weapon being trained raises mastery faster than normal mobs.
    -- ============================================================
    local CAKE_AREA_CF   = CFrame.new(-2077, 252, -12373)        -- the CakeLoaf island in general
    local CAKE_BOSS_CF   = CFrame.new(-2151.82, 149.32, -12404.91) -- where Cake Prince appears
    local CAKE_UNLOCK_MOBS = {"Cookie Crafter", "Cake Guard", "Baking Staff", "Head Baker"}

    -- [NEW] Determine which melee needs mastery training - shared between
    -- CakePrinceTask and MeleesController to stay in sync (train exactly the one
    -- that is lacking, in the V1 -> V2 order the spec requires)
    local MASTERY_TRAIN_ORDER = {
        {name = "Black Leg",       target = 500, tier = "V1"},
        {name = "Electro",         target = 500, tier = "V1"},
        {name = "Fishman Karate",  target = 500, tier = "V1"},
        {name = "Dragon Claw",     target = 500, tier = "V1"},
        {name = "Superhuman",      target = 500, tier = "V1"},
        {name = "Death Step",      target = 400, tier = "V2"},
        {name = "Sharkman Karate", target = 400, tier = "V2"},
        {name = "Electric Claw",   target = 400, tier = "V2"},
        {name = "Dragon Talon",    target = 400, tier = "V2"},
    }

    function GetCurrentTrainingMelee()
        for _, m in ipairs(MASTERY_TRAIN_ORDER) do
            if CheckItem(m.name) then
                local mastery = ScriptStorage.Melees[m.name] or 0
                if mastery < m.target then
                    return m.name, mastery, m.target
                end
            end
        end
        return nil
    end

    FunctionsHandler.CakePrinceTask:RegisterMethod("Refresh", function()
        if SeaIndex ~= 3 then return nil end
        if (ScriptStorage.PlayerData.Level or 0) < 1500 then return nil end
        -- [FIXED] Gate by "is any melee in need of mastery training",
        -- NO LONGER gated by Fragments
        local trainingName = GetCurrentTrainingMelee()
        if not trainingName then return nil end
        return trainingName
    end)

    FunctionsHandler.CakePrinceTask:RegisterMethod("Start", function(trainingName)
        if not trainingName then return end
        local mastery, target = ScriptStorage.Melees[trainingName] or 0, nil
        for _, m in ipairs(MASTERY_TRAIN_ORDER) do
            if m.name == trainingName then target = m.target break end
        end

        -- [NEW] Check mastery every round - at the threshold, stop farming and let
        -- the next Refresh() switch to the next melee that needs training
        if mastery >= (target or 500) then
            SetTask("SubTask", "✅ " .. trainingName .. " reached " .. mastery .. " mastery — switching to the next melee")
            return
        end

        -- [NEW] Equip the exact melee that needs training before fighting, so
        -- the damage counts toward the RIGHT weapon's mastery
        pcall(function()
            FunctionsHandler.LocalPlayerController.Methods.EquipTool:Call(trainingName)
        end)

        local cakeLoaf  = workspace.Map:FindFirstChild("CakeLoaf")
        local bigMirror = cakeLoaf and cakeLoaf:FindFirstChild("BigMirror")
        local enemies   = workspace.Enemies

        -- Not at Cake Island yet -> teleport there first
        if not cakeLoaf then
            SetTask("MainTask", "Cake Mastery | " .. trainingName .. " (" .. mastery .. "/" .. (target or 500) .. ") — going to Cake Island")
            TweenController.Create(CAKE_AREA_CF)
            return
        end

        local mirrorOpen = bigMirror and bigMirror:FindFirstChild("Other") and bigMirror.Other.Transparency == 0
        local bossUp     = enemies:FindFirstChild("Cake Prince")

        if mirrorOpen or bossUp then
            -- Mirror already open OR boss already up -> fight (mastery rises fast)
            local boss = enemies:FindFirstChild("Cake Prince")
            if boss and boss:FindFirstChild("Humanoid") and boss.Humanoid.Health > 0 then
                SetTask("MainTask", "Cake Mastery | " .. trainingName .. " (" .. mastery .. "/" .. (target or 500) .. ") | Cake Prince HP " .. math.floor(boss.Humanoid.Health / boss.Humanoid.MaxHealth * 100) .. "%")
                TweenController.Create(boss.HumanoidRootPart.CFrame + Vector3.new(0, 30, 0))
                CombatController.Attack("Cake Prince")

                -- [ADDED] After the kill -> reset to normal farming, same pattern as
                -- BossesTask/SpecialBossesTask did earlier
                pcall(function()
                    if boss.Parent == nil or boss.Humanoid.Health <= 0 then
                        -- [FIXED] This is exactly the case boss man reported - Cake Prince
                        -- ("Beautiful Pirates") changes to phase 2, the old code thought it died
                        if ConfirmBossDead("Cake Prince") then
                            SetTask('SubTask', '✅ Defeated Cake Prince — back to level farm')
                            local hum = LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
                            if hum then
                                hum.Health = 0
                                LocalPlayer.CharacterAdded:Wait()
                            end
                        else
                            SetTask('SubTask', 'Cake Prince is changing phase — keep attacking')
                        end
                    end
                end)
            else
                TweenController.Create(CAKE_BOSS_CF)
            end
            return
        end

        -- Mirror not open, boss not up -> farm normal mobs for mastery +
        -- check the unlock progress (when enough, it triggers the Cake Prince spawn itself)
        SetTask("MainTask", "Cake Mastery | " .. trainingName .. " (" .. mastery .. "/" .. (target or 500) .. ") — farming regular mobs")
        local killedStr = Remotes.CommF_:InvokeServer("CakePrinceSpawner")
        local killed = killedStr and tonumber(tostring(killedStr):match("%d+")) or 0
        local remaining = math.max(0, 500 - killed)

        if remaining <= 0 then
            SetTask("MainTask", "Cake Mastery | Requirements met — summoning Cake Prince")
            Remotes.CommF_:InvokeServer("CakePrinceSpawner", true)
            task.wait(1)
            return
        end

        -- Not enough yet -> farm the unlock mobs
        SetTask("MainTask", "Cake Prince | Farming unlock mobs — remaining: " .. remaining .. "/500")
        local mob = nil
        for _, mobName in ipairs(CAKE_UNLOCK_MOBS) do
            local m = enemies:FindFirstChild(mobName)
            if m and m:FindFirstChild("Humanoid") and m.Humanoid.Health > 0 then mob = m break end
        end
        if mob then
            TweenController.Create(mob.HumanoidRootPart.CFrame + Vector3.new(0, 5, 0))
            CombatController.Attack(CAKE_UNLOCK_MOBS)
        else
            TweenController.Create(CAKE_AREA_CF)
        end
    end)

    -- PART 8: GOD'S CHALICE → DOUGH KING progression.
    -- Gather Cocoa while looking for God's Chalice; prioritize a live Elite Pirate,
    -- then try the Gravestone at night. Crafting Sweet Chalice is a quest step;
    -- the 500 Cake Land kills are still needed before opening the portal.
    local function doughKingCount(itemName)
        local row = ScriptStorage.Backpack and ScriptStorage.Backpack[itemName]
        if type(row) == "table" then return tonumber(row.Count or row.Quantity or row.Value) or 0 end
        return tonumber(row) or 0
    end
    local function doughKingTool(itemName)
        local found = CheckItem(itemName)
        return found ~= false and found ~= nil
    end
    local doughKingChestAttemptAt = setmetatable({}, {__mode = "k"})
    local function doughKingNearestChest()
        if not SunriseWorldIndex or not SunriseWorldIndex.Ready then return nil end
        local char = game:GetService("Players").LocalPlayer.Character
        local root = char and char:FindFirstChild("HumanoidRootPart")
        if not root then return nil end
        local nearest, nearestDistance
        local now = os.clock()
        for chest in pairs(SunriseWorldIndex.Chests or {}) do
            if chest and chest.Parent and chest:IsDescendantOf(workspace) then
                local lastAttempt = doughKingChestAttemptAt[chest] or 0
                if now - lastAttempt >= 90 then
                    local distance = (root.Position - chest.Position).Magnitude
                    if not nearestDistance or distance < nearestDistance then
                        nearest, nearestDistance = chest, distance
                    end
                end
            end
        end
        return nearest, nearestDistance
    end
    FunctionsHandler.DoughKingTask:RegisterMethod("Refresh", function()
        if not (Config.Goals and Config.Goals.AutoDoughKing) then return nil end
        -- Dough King's displayed level is not the player's level requirement.
        -- This goal is only eligible in Sea 3; the controller handles its own quest steps.
        if SeaIndex ~= 3 then return nil end
        return true
    end)
    FunctionsHandler.DoughKingTask:RegisterMethod("Start", function()
        if not (Config.Goals and Config.Goals.AutoDoughKing) then return end
        if SeaIndex ~= 3 then
            SetTask("MainTask", "Dough King | traveling to Third Sea")
            pcall(function() Remotes.CommF_:InvokeServer("TravelZou") end)
            return
        end
        local enemies = workspace:FindFirstChild("Enemies")
        local boss = enemies and enemies:FindFirstChild("Dough King")
        if boss and boss:FindFirstChildOfClass("Humanoid") and boss.Humanoid.Health > 0 then
            SetTask("MainTask", "Dough King | fighting the spawned boss")
            if boss:FindFirstChild("HumanoidRootPart") then
                TweenController.Create(boss.HumanoidRootPart.CFrame + Vector3.new(0, 30, 0))
            end
            CombatController.Attack("Dough King")
            return
        end

        local cakeLoaf = workspace:FindFirstChild("Map") and workspace.Map:FindFirstChild("CakeLoaf")
        if not cakeLoaf then
            SetTask("MainTask", "Dough King | moving to Cake Land")
            TweenController.Create(CAKE_AREA_CF)
            return
        end

        -- A Red Key opens the red door after Cake Prince progression. If it is
        -- present, walk to the door and equip it; never pretend this is completed
        -- merely because the key remote returned a truthy response.
        local redDoor = cakeLoaf:FindFirstChild("RedDoor")
        if redDoor and doughKingTool("Red Key") then
            local doorPart = redDoor:IsA("BasePart") and redDoor or redDoor:FindFirstChildWhichIsA("BasePart", true)
            if doorPart then
                SetTask("MainTask", "Dough King | using Red Key at the Cake Land door")
                TweenController.Create(doorPart.CFrame + Vector3.new(0, 3, 0))
                if CaculateDistance(doorPart.CFrame) < 10 then
                    pcall(function() FunctionsHandler.LocalPlayerController.Methods.EquipTool:Call("Red Key") end)
                    local prompt = redDoor:FindFirstChildWhichIsA("ProximityPrompt", true)
                    if prompt and typeof(fireproximityprompt) == "function" then
                        pcall(function() fireproximityprompt(prompt) end)
                    end
                    local character = game:GetService("Players").LocalPlayer.Character
                    local root = character and character:FindFirstChild("HumanoidRootPart")
                    if root and typeof(firetouchinterest) == "function" then
                        pcall(function() firetouchinterest(root, doorPart, 0); firetouchinterest(root, doorPart, 1) end)
                    end
                end
                return
            end
        end

        local cocoa = doughKingCount("Conjured Cocoa")
        local hasSweet = doughKingTool("Sweet Chalice")
        local hasGod = doughKingTool("God's Chalice")
        if hasGod and cocoa >= 10 and not hasSweet then
            SetTask("MainTask", "Dough King | crafting Sweet Chalice (10 Conjured Cocoa)")
            pcall(function() Remotes.CommF_:InvokeServer("SweetChaliceNpc") end)
            task.wait(0.6)
            pcall(RefreshInventory)
            return
        end

        if cocoa < 10 then
            -- Keep Cocoa farming moving, but take an Elite Pirate immediately if one
            -- is already alive and God's Chalice is still missing.
            if not hasGod then
                local eliteWhileFarming
                for _, eliteName in ipairs({"Deandre", "Urban", "Diablo"}) do
                    local candidate = enemies and enemies:FindFirstChild(eliteName)
                    if candidate and candidate:FindFirstChildOfClass("Humanoid") and candidate.Humanoid.Health > 0 then
                        eliteWhileFarming = candidate
                        break
                    end
                end
                if eliteWhileFarming then
                    SetTask("MainTask", "Dough King | Cocoa " .. tostring(cocoa) .. "/10 · hunting Elite Pirate " .. eliteWhileFarming.Name)
                    CombatController.Attack({eliteWhileFarming.Name})
                    return
                end
            end
            SetTask("MainTask", "Dough King | farming Conjured Cocoa (" .. tostring(cocoa) .. "/10)")
            local target
            for _, mobName in ipairs({"Cocoa Warrior", "Chocolate Bar Battler"}) do
                local mob = enemies and enemies:FindFirstChild(mobName)
                if mob and mob:FindFirstChildOfClass("Humanoid") and mob.Humanoid.Health > 0 then target = mob break end
            end
            if target and target:FindFirstChild("HumanoidRootPart") then
                TweenController.Create(target.HumanoidRootPart.CFrame + Vector3.new(0, 5, 0))
                CombatController.Attack({"Cocoa Warrior", "Chocolate Bar Battler"})
            else
                TweenController.Create(CFrame.new(402.7189, 81.0605, -12259.543))
            end
            return
        end

        if not hasSweet then
            if hasGod and cocoa < 10 then
                SetTask("MainTask", "Dough King | God's Chalice found; gathering Cocoa before crafting")
            else
                -- Elite Pirates can drop God's Chalice. Kill one only when currently
                -- replicated, otherwise wait; no unverified remote is used to spawn it.
                local elite
                for _, eliteName in ipairs({"Deandre", "Urban", "Diablo"}) do
                    local candidate = enemies and enemies:FindFirstChild(eliteName)
                    if candidate and candidate:FindFirstChildOfClass("Humanoid") and candidate.Humanoid.Health > 0 then elite = candidate break end
                end
                if elite then
                    SetTask("MainTask", "Dough King | hunting Elite Pirate " .. elite.Name .. " for God's Chalice")
                    CombatController.Attack({elite.Name})
                else
                    local lighting = game:GetService("Lighting")
                    local clockTime = tonumber(lighting.ClockTime) or 12
                    local isNight = clockTime >= 18 or clockTime <= 5
                    local gravePos = CFrame.new(-8654, 140, 6167)
                    if isNight then
                        SetTask("MainTask", "Dough King | no Elite Pirate nearby; checking Gravestone prayer")
                        if CaculateDistance(gravePos) > 12 then
                            TweenController.Create(gravePos)
                        else
                            -- Inventory is checked again afterward; the remote response alone
                            -- is not treated as proof that God's Chalice was obtained.
                            pcall(function() Remotes.CommF_:InvokeServer("gravestoneEvent", 2) end)
                            task.wait(0.6)
                            pcall(RefreshInventory)
                        end
                    else
                        -- Chests are another documented chalice source. Sweep visible chest
                        -- parts after checking for an Elite Pirate; each chest is rate-limited.
                        local chest, chestDistance = doughKingNearestChest()
                        if chest then
                            SetTask("MainTask", "Dough King | checking chests for God's Chalice")
                            if chestDistance and chestDistance > 8 then
                                TweenController.Create(chest.CFrame + Vector3.new(0, 3, 0))
                            else
                                local char = game:GetService("Players").LocalPlayer.Character
                                local root = char and char:FindFirstChild("HumanoidRootPart")
                                doughKingChestAttemptAt[chest] = os.clock()
                                if root and typeof(firetouchinterest) == "function" then
                                    pcall(function() firetouchinterest(root, chest, 0); task.wait(); firetouchinterest(root, chest, 1) end)
                                end
                                task.wait(0.25)
                                pcall(RefreshInventory)
                            end
                        else
                            SetTask("MainTask", "Dough King | waiting for an Elite Pirate, chest spawn, or nighttime Gravestone")
                            local map = workspace:FindFirstChild("Map")
                            local hauntedCastle = map and (map:FindFirstChild("Haunted Castle") or map:FindFirstChild("HauntedCastle"))
                            if isNight and hauntedCastle and hauntedCastle:IsA("Model") and CaculateDistance(hauntedCastle:GetModelCFrame()) > 1800 then
                                TweenController.Create(hauntedCastle:GetModelCFrame())
                            end
                        end
                    end
                end
            end
            return
        end

        -- CakePrinceSpawner reports the 500-kill progress and is the same spawn
        -- remote used by BananaHub. Only request the summon after progress is ready.
        local progressResponse
        pcall(function() progressResponse = Remotes.CommF_:InvokeServer("CakePrinceSpawner") end)
        local progressText = tostring(progressResponse or "")
        local killCount = tonumber(progressText:match("(%d+)")) or 0
        if killCount < 500 then
            SetTask("MainTask", "Dough King | preparing 500 Cake Land kills (" .. tostring(killCount) .. "/500)")
            local target
            for _, mobName in ipairs(CAKE_UNLOCK_MOBS) do
                local mob = enemies and enemies:FindFirstChild(mobName)
                if mob and mob:FindFirstChildOfClass("Humanoid") and mob.Humanoid.Health > 0 then target = mob break end
            end
            if target and target:FindFirstChild("HumanoidRootPart") then
                TweenController.Create(target.HumanoidRootPart.CFrame + Vector3.new(0, 5, 0))
                CombatController.Attack(CAKE_UNLOCK_MOBS)
            else
                TweenController.Create(CAKE_AREA_CF)
            end
            return
        end

        SetTask("MainTask", "Dough King | 500 kills ready; requesting summon")
        pcall(function() Remotes.CommF_:InvokeServer("CakePrinceSpawner", true) end)
        task.wait(0.75)
        pcall(RefreshInventory)
    end)

