            end
        end

        local cocoa = doughKingCount("Conjured Cocoa")
        local hasSweet = doughKingTool("Sweet Chalice")
        local hasGod = doughKingTool("God's Chalice")
        if hasGod and cocoa >= 10 and not hasSweet then
            SetTask("MainTask", "Dough King | crafting Sweet Chalice (10 Conjured Cocoa)")
            pcall(function() Remotes.CommF_:InvokeServer("SweetChaliceNpc") end)
            task.wait(0.6)
            pcall(RefreshInventory)
            return
        end

        if cocoa < 10 then
            SetTask("MainTask", "Dough King | farming Conjured Cocoa (" .. tostring(cocoa) .. "/10)")
            local target
            for _, mobName in ipairs({"Cocoa Warrior", "Chocolate Bar Battler"}) do
                local mob = enemies and enemies:FindFirstChild(mobName)
                if mob and mob:FindFirstChildOfClass("Humanoid") and mob.Humanoid.Health > 0 then target = mob break end
