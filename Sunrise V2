    if not (g and g.SunriseEmbeddedAutoSC == true) then return false end
    g.SunriseAutoSCReloadEnabled = state == true
    if state ~= true then Runtime.AutoExecQueuedJob = nil; return true end
    if Runtime.AutoExecQueuedJob == tostring(game.JobId) then return true end

