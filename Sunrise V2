            end
            if target and target:FindFirstChild("HumanoidRootPart") then
                TweenController.Create(target.HumanoidRootPart.CFrame + Vector3.new(0, 5, 0))
                CombatController.Attack(CAKE_UNLOCK_MOBS)
            else
                TweenController.Create(CAKE_AREA_CF)
            end
            return
        end

        SetTask("MainTask", "Dough King | 500 kills ready; requesting summon")
        pcall(function() Remotes.CommF_:InvokeServer("CakePrinceSpawner", true) end)
        task.wait(0.75)
        pcall(RefreshInventory)
    end)

