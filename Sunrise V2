        or rawget(g, "SunriseEmbeddedAutoExecUrl") or rawget(g, "SunriseURL")
    if type(url) ~= "string" or url == "" then return false end

    local q = rawget(g, "queue_on_teleport")
        or (syn and syn.queue_on_teleport)
        or queueonteleport
        or (fluxus and fluxus.queue_on_teleport)
    if type(q) ~= "function" then return false end

    local loader = 'task.spawn(function()\n'
        .. '    repeat task.wait(0.5) until game:IsLoaded()\n'
        .. '    local g = (type(getgenv) == "function" and getgenv()) or _G\n'
        .. '    if not g or g.SunriseAutoSCReloadEnabled ~= true then return end\n'
        .. '    task.wait(2)\n'
        .. '    if g.SunriseMainJobId == tostring(game.JobId) then return end\n'
        .. '    g.SunriseURL = ' .. string.format('%q', url) .. '\n'
        .. '    local ok, err = pcall(function()\n'
        .. '        local src = game:HttpGet(' .. string.format('%q', url) .. ')\n'
        .. '        local fn, compileErr = loadstring(src)\n'
        .. '        if not fn then error(compileErr or "loadstring failed") end\n'
        .. '        fn()\n'
        .. '    end)\n'
        .. '    if not ok then warn("[Sunrise AutoSC reload] " .. tostring(err)) end\n'
        .. 'end)'
    local ok = pcall(q, loader)
    if ok then Runtime.AutoExecQueuedJob = tostring(game.JobId) end
    return ok
end

