    -- ---------- fruit store helper (used by finder and by the farm modes) ----------
    local function commf() return game:GetService("ReplicatedStorage"):FindFirstChild("Remotes"):FindFirstChild("CommF_") end
    function S.fruitKey(tool)
        local k = tool:GetAttribute("OriginalName")
