    -- [FIXED] Confirm the boss is REALLY dead - avoids a false positive during phase
    -- transitions (bug boss man reported: fighting "Beautiful Pirates" [Cake Prince] through
    -- phase 2, Parent/Humanoid temporarily disappear during the phase-change animation,
    -- the old code thought it died -> wrongly reset, abandoning the boss mid-fight).
    -- Now: lost sight / Health<=0 -> WAIT and confirm continuously for 3 seconds, if that name
    -- shows up alive again (new phase) during the wait, cancel the reset and keep attacking.
    -- ============================================================
    local function ConfirmBossDead(bossName)
        -- [FIXED - less delay as boss man requested] 3x1s (3.0s total) ->
        -- 6x0.3s (1.8s total). NOT shortened by reducing the number of checks -
        -- that would weaken exactly the false-positive bug that was fixed. Instead
        -- the poll count was doubled (3->6) while the total time is 40%
        -- SHORTER - both faster and more sensitive to catching "came back alive mid-way".
        for _ = 1, 6 do
            task.wait(0.3)
            local stillThere = ScriptStorage.Enemies[bossName]
            if stillThere and stillThere:FindFirstChild("Humanoid") and stillThere.Humanoid.Health > 0 then
                return false -- came back alive (phase change) - NOT a real death
            end
        end
        return true -- 1.8s straight without seeing it alive again - definitely dead
    end

