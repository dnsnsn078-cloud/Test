        segment(pg, "Hop method", {"Sea travel", "Server list"}, function() return Config.Finder.HopMode end, function(v) Config.Finder.HopMode = v end)
        stockCard(pg)
        local listBox = new("Frame", {Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundTransparency = 1, LayoutOrder = nextOrder()}, pg)
        vlist(listBox, 4)
        local lastSig = ""
        local function rebuild()
            local accs = {}
            for name, acc in pairs(S.FruitLog.accounts or {}) do accs[#accs + 1] = {name = name, acc = acc} end
            table.sort(accs, function(a, b) return string.lower(a.name) < string.lower(b.name) end)
            local parts = {}
            for _, a in ipairs(accs) do
                parts[#parts + 1] = a.name
                for fn, f in pairs(a.acc.fruits or {}) do parts[#parts + 1] = fn .. f.Stored .. "/" .. f.Unstored end
            end
            local sig = table.concat(parts, "|")
            if sig == lastSig then return end
            lastSig = sig
            for _, c in ipairs(listBox:GetChildren()) do if c:IsA("Frame") then c:Destroy() end end
            local order = 0
            for _, a in ipairs(accs) do
                order = order + 1
                local ts, tu = 0, 0
                local names = {}
                for fn, f in pairs(a.acc.fruits or {}) do names[#names + 1] = fn; ts = ts + f.Stored; tu = tu + f.Unstored end
                table.sort(names)
                local box = new("Frame", {Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundColor3 = T.card, BorderSizePixel = 0, LayoutOrder = order}, listBox)
                corner(box, 8); pad(box, 10, 6, 10, 6); vlist(box, 1)
                local head = text(box, {Size = UDim2.new(1, 0, 0, 16), Font = Enum.Font.GothamBold, TextSize = 12,
                    Text = a.name .. "  -  stored " .. ts .. " / not stored " .. tu, LayoutOrder = 0})
                bindAccent(head, "TextColor3")
                for i, fn in ipairs(names) do
                    local f = a.acc.fruits[fn]
                    text(box, {Size = UDim2.new(1, 0, 0, 14), TextSize = 11, LayoutOrder = i,
                        Text = fn .. ":  " .. f.Stored .. " Stored,  " .. f.Unstored .. " Unstored"})
                end
                if #names == 0 then text(box, {Size = UDim2.new(1, 0, 0, 14), TextSize = 11, TextColor3 = T.sub, Text = "nothing found yet", LayoutOrder = 1}) end
            end
            if #accs == 0 then
                local box = new("Frame", {Size = UDim2.new(1, 0, 0, 28), BackgroundColor3 = T.card, BorderSizePixel = 0}, listBox)
                corner(box, 8)
                text(box, {Position = UDim2.fromOffset(10, 0), Size = UDim2.new(1, -20, 1, 0), Text = "No fruits logged yet", TextColor3 = T.sub})
            end
        end
        updaters[#updaters + 1] = function()
            st.Text = tostring(S.Finder.Status) .. "   (server #" .. tostring(S.Finder.Server) .. ")"
            local lf = S.LastFound
            last.Text = (lf and ("Last: " .. lf.name .. (lf.stored and " - stored" or (" - NOT stored (" .. tostring(lf.why) .. ")"))) or "Last: -")
                .. "   |   skipped: " .. tostring(S.Finder.Skipped or 0)
            ctl.Text = (Config.Mode == "FruitFinder") and "Stop Fruit Finder  (back to normal)" or "Start Fruit Finder"
            rebuild()
        end
    end)

