    _G.PanicModeActive = false

    task.spawn(function()
        local escapeY = nil
        while task.wait(Config.PanicMode.CheckInterval) do
            pcall(function()
                if not Config.PanicMode.Enabled then return end
                local char = LocalPlayer.Character
                local hum  = char and char:FindFirstChildOfClass("Humanoid")
                local hrp  = char and char:FindFirstChild("HumanoidRootPart")

                -- [FIXED] The character died while hiding up high (_G.PanicModeActive
                -- = true) without the state being reset -> on respawn, the NEW character (full
                -- health, standing on the ground) was treated as "hiding, keep the old height"
                -- -> pulled into the sky for no reason right after respawn. Now reset as soon as
                -- death is detected, not just a silent return.
                if not hum or not hrp or hum.Health <= 0 then
                    if _G.PanicModeActive then
                        _G.PanicModeActive = false
                        escapeY = nil
                    end
                    return
                end

                local pct = (hum.Health / hum.MaxHealth) * 100

                if not _G.PanicModeActive and pct < Config.PanicMode.LowHealthPercent then
                    -- [FIXED] Cancel any running tween (if any) before forcing the CFrame -
                    -- otherwise a half-finished TweenController (e.g. LevelFarm tweening to a
                    -- quest) keeps updating the CFrame in the OLD direction on the next
                    -- frame, dragging the character back down almost instantly,
                    -- which disables panic mode.
                    pcall(function() if TweenInstance then TweenInstance:Cancel() end end)
                    _G.PanicModeActive = true
                    escapeY = hrp.Position.Y + Config.PanicMode.EscapeHeight
                    SetTask("MainTask", "⚠️ PANIC MODE | Health " .. math.floor(pct) .. "% — flying up to hide")
                    hrp.CFrame = CFrame.new(hrp.Position.X, escapeY, hrp.Position.Z)

                elseif _G.PanicModeActive then
                    -- Hiding up high - keep the height, wait for health to recover
                    if hrp.Position.Y < (escapeY or 0) - 50 then
                        pcall(function() if TweenInstance then TweenInstance:Cancel() end end)
                        hrp.CFrame = CFrame.new(hrp.Position.X, escapeY, hrp.Position.Z)
                    end
                    if pct >= Config.PanicMode.SafeHealthPercent then
                        -- [NEW] Health fully recovered -> fly back down, turn panic mode off
                        SetTask("MainTask", "✅ Health back to " .. math.floor(pct) .. "% — flying down to keep farming")
                        _G.PanicModeActive = false
                        escapeY = nil
                    else
                        SetTask("SubTask", "PANIC MODE | Hiding up high — health " .. math.floor(pct) .. "%/" .. Config.PanicMode.SafeHealthPercent .. "%")
                    end
                end
            end)
        end
    end)

