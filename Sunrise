local function tryCapture(parent)
    if not parent then return end
    for _, item in ipairs(parent:GetChildren()) do
        if item:IsA("RemoteEvent") then
            local attr = item:GetAttribute("Id")
            if attr then
                RemoteId, capturedChild = attr, item
