    -- ---------- fruit finder (teleport onto the fruit, store it, hop) ----------
    S.Finder = {Running = false, Status = "Idle", Server = 0, Skipped = 0}
    local F = S.Finder
    local function visitedList()
        local v = S.readJSON(S.Dir .. "/visited.json") or {}
        local now, out = os.time(), {}
        for id, t in pairs(v) do if now - t < 1800 then out[id] = t end end
        return out
    end
    local function serverListHop()
        local TeleportService = game:GetService("TeleportService")
        local visited = visitedList()
        visited[game.JobId] = os.time()
        for attempt = 1, 4 do
            local cands, cursor = {}, nil
            for page = 1, 3 do
                local url = "https://games.roblox.com/v1/games/" .. game.PlaceId .. "/servers/Public?sortOrder=Asc&limit=100&excludeFullGames=true"
                if cursor then url = url .. "&cursor=" .. cursor end
                local ok, data = pcall(function() return HttpService:JSONDecode(game:HttpGet(url)) end)
                if not ok or type(data) ~= "table" then task.wait(1.5) break end
                for _, sv in ipairs(data.data or {}) do
                    if sv.id ~= game.JobId and not visited[sv.id] and (sv.playing or 0) < (sv.maxPlayers or 12) - 1 then cands[#cands + 1] = sv.id end
                end
                cursor = data.nextPageCursor
                if #cands >= 10 or not cursor then break end
            end
            if #cands > 0 then
                local id = cands[math.random(1, #cands)]
                visited[id] = os.time()
                S.writeJSON(S.Dir .. "/visited.json", visited)
                pcall(function() TeleportService:TeleportToPlaceInstance(game.PlaceId, id, lp) end)
                task.wait(8)
            else
                task.wait(2)
            end
        end
        pcall(function() TeleportService:Teleport(game.PlaceId, lp) end)
    end
    function S.Hop()
        F.Status = "Hopping server..."
        S.queueOnTeleport()
        if Config.Finder.HopMode ~= "Server list" then
            -- same trick as the working finder: travel to another sea = a fresh server
            local names = {[1] = "TravelMain", [2] = "TravelDressrosa", [3] = "TravelZou"}
            local opts = {}
            for sea, n in pairs(names) do if sea ~= S.curSea() then opts[#opts + 1] = n end end
            for i = #opts, 2, -1 do local j = math.random(1, i); opts[i], opts[j] = opts[j], opts[i] end
            for _, n in ipairs(opts) do
                pcall(function() commf():InvokeServer(n) end)
                task.wait(6) -- if the teleport started we are gone; otherwise try the next one
            end
        end
        serverListHop()
    end
    function S.findFruits()
        local list = {}
        for _, o in ipairs(workspace:GetChildren()) do
            if string.find(o.Name, "Fruit") and o:FindFirstChild("Handle") then list[#list + 1] = o end
        end
        local char = lp.Character
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        if hrp then table.sort(list, function(a, b) return (a.Handle.Position - hrp.Position).Magnitude < (b.Handle.Position - hrp.Position).Magnitude end) end
        return list
    end
    -- is this fruit good enough for the "minimum fruit" filter? unknown fruits are always taken
    function S.fruitWanted(fr)
        local info = S.FruitInfo(fr.Name)
        local minName = Config.Finder.MinFruit
        if info.name == "???" or not minName or minName == "" or minName == "Any" then return true, info end
        local minInfo
        for _, f in ipairs(S.FruitList) do if f.name == minName then minInfo = f end end
        if not minInfo then return true, info end
        return info.price >= minInfo.price, info
    end
    local function removed(fr) return not fr:IsDescendantOf(game) end
    function F.Start()
        if F.Running then return end
        F.Running = true
        task.spawn(function()
            F.Status = "Loading..."
            local char = lp.Character or lp.CharacterAdded:Wait()
            pcall(function() char:WaitForChild("HumanoidRootPart", 15) end)
            pcall(function()
                local pg = lp:WaitForChild("PlayerGui", 10)
                local main = pg and pg:FindFirstChild("Main")
                if main and main:FindFirstChild("ChooseTeam") then
                    commf():InvokeServer("SetTeam", Config.Team or "Pirates")
                    pcall(function() main.ChooseTeam:Destroy() end)
                end
            end)
            while F.Running do
                F.Server = F.Server + 1
                F.Status = "Scanning for fruits..."
                local fruits = S.findFruits()
                if #fruits == 0 then task.wait(1.2); fruits = S.findFruits() end -- fruits can replicate a moment late
                local handled = 0
                for _, fr in ipairs(fruits) do
                    if not F.Running then break end
                    local ok, info = S.fruitWanted(fr)
                    if not ok then
                        F.Skipped = F.Skipped + 1
                        local acc = S.FruitLog.accounts[lp.Name]
                        if not acc then acc = {fruits = {}}; S.FruitLog.accounts[lp.Name] = acc end
                        acc.skipped = (acc.skipped or 0) + 1
                        F.Status = "Skipped " .. info.name .. " (below minimum)"
                    elseif fr:FindFirstChild("Handle") and not removed(fr) then
                        handled = handled + 1
                        F.Status = "Grabbing " .. info.name .. "..."
                        local keys, seen = {}, {}
                        local base = (fr.Name:gsub(" Fruit$", ""))
                        for _, k in ipairs({fr:GetAttribute("OriginalName"), fr.Name, base .. "-" .. base}) do
                            if k and not seen[k] then seen[k] = true; keys[#keys + 1] = k end
                        end
                        local stored, why = false, nil
                        if S.inventoryHas(keys[1]) or S.inventoryHas(base .. "-" .. base) then
                            why = "already in storage"
                        else
                            local t0, iter = os.clock(), 0
                            repeat
                                iter = iter + 1
                                pcall(function()
                                    local hrp = lp.Character.HumanoidRootPart
                                    hrp.CFrame = CFrame.new(fr.Handle.Position + Vector3.new(0, 3, 0))
                                end)
                                task.wait(0.2)
                                local k = keys[((iter - 1) % #keys) + 1] -- one call per round, trying each name format in turn
                                pcall(function() commf():InvokeServer("StoreFruit", k, fr) end)
                                stored = removed(fr)
                            until stored or not F.Running or os.clock() - t0 >= (Config.Finder.HopDelay or 5)
                            if not stored then why = "storage full?" end
                        end
                        S.logFruit(fr.Name, stored, why)
                        F.Status = (stored and "Stored " or "Could not store ") .. info.name
                    end
                end
                if not F.Running then break end
                if handled == 0 then
                    F.Status = (F.Skipped > 0 and "Nothing worth taking here" or "No fruit here") .. ", hopping..."
                else
                    task.wait(1)
                end
                S.Hop()
            end
            F.Status = "Stopped"
        end)
    end
    function F.Stop(silent)
        F.Running = false
        if not silent then
            Config.Mode = (Config.Finder.PrevMode ~= "FruitFinder" and Config.Finder.PrevMode) or "Custom"
            S.save()
            if S.OnModeChanged then pcall(S.OnModeChanged, Config.Mode, "FruitFinder") end
            if _G then _G.Stop = false end
        end
    end

    -- ---------- which tasks run in which mode (used by the dispatcher) ----------
    function SunriseTaskOrder()
        local mode = Config.Mode
        if mode == "FruitFinder" then return {} end
        if mode == "BoneCastle" then return {"CastleRaid", "BoneFarm"} end
        if mode == "Kaitun" then
            local o = {}
            for _, n in ipairs(TasksOrder) do if n ~= "BoneFarm" and n ~= "CastleRaid" then o[#o + 1] = n end end
            return o
        end
        local o = {"SunriseRaid", "SunriseBoss", "SunriseMob", "SunriseMaterial"}
        local function any(t) for _, v in pairs(t or {}) do if v == true then return true end end return false end
        local I = Config.Items
        if any(Config.Sword) then o[#o + 1] = "SwordBossTask" end
        if any(Config.BossWeapons) then o[#o + 1] = "SpecialBossesTask"; o[#o + 1] = "BossesTask" end
        if I.AutoFullyMelees then for _, n in ipairs({"RaidController", "AutoRaidIce", "CakePrinceTask", "MeleesController"}) do o[#o + 1] = n end end
        if Config.Farm.Level then o[#o + 1] = "LevelFarm" end
        if I.CursedDualKatana then for _, n in ipairs({"Tushita", "Yama", "CursedDualKatana"}) do o[#o + 1] = n end end
        if I.Saber then o[#o + 1] = "Saber" end
        if I.SoulGuitar then o[#o + 1] = "SoulGuitar" end
        if I.RaceV2 then o[#o + 1] = "EvoRace" end
        if I.AutoRaceV3 then o[#o + 1] = "RaceAwakening" end
        return o
    end

    -- ---------- stats (replaces the old automatic AddPoint) ----------
    function SunriseAddPoints()
        local St = Config.Stats
        if not (St and St.Enabled) then return end
        local pts = lp.Data.Points.Value
        if not pts or pts <= 0 then return end
        local picks = {}
        for _, n in ipairs({"Melee", "Defense", "Sword", "Gun", "Demon Fruit"}) do if St[n] then picks[#picks + 1] = n end end
        if #picks == 0 then return end
        local each = math.max(1, math.floor(pts / #picks))
        for i, n in ipairs(picks) do
            local give = (i == #picks) and (pts - each * (#picks - 1)) or each
            if give > 0 then pcall(function() commf():InvokeServer("AddPoint", n, give) end) end
        end
    end
end


